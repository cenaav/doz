{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "type",
      "short",
      "title",
      "license"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "type": {
        "enum": [
          "fda-label",
          "ema-smpc",
          "uk-smpc",
          "guideline",
          "licensed-reference",
          "ifda-leaflet",
          "textbook",
          "medlineplus"
        ]
      },
      "short": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "publisher": {
        "type": "string"
      },
      "edition": {
        "type": "string"
      },
      "year": {
        "type": "integer"
      },
      "citation": {
        "type": "string"
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "accessed": {
        "type": "string",
        "format": "date"
      },
      "license": {
        "enum": [
          "public",
          "licensed",
          "pending"
        ]
      }
    }
  }
}
