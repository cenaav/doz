{
  "name": "doz",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "data:validate": "tsx scripts/validate-data.ts",
    "data:index": "tsx scripts/build-catalog.ts",
    "dev": "npm run data:index && nuxt dev",
    "generate": "npm run data:validate && npm run data:index && nuxt generate",
    "preview": "npx serve .output/public",
    "test": "vitest run",
    "postinstall": "nuxt prepare",
    "deploy:cf": "npm run generate && wrangler deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cenaav/doz.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/cenaav/doz/issues"
  },
  "homepage": "https://github.com/cenaav/doz#readme",
  "private": "true",
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "minisearch": "^7.2.0",
    "nuxt": "^4.6.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^1.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
