  "contraindications": [
    {
      "id": "hyper",
      "severity": "block",
      "text": {
        "fa": "حساسیت به دفلازاکورت یا اجزای فرآورده.",
        "en": "Hypersensitivity to deflazacort or its inactive ingredients."
      },
      "refs": [
        {
          "source": "fda-emflaza",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "سرکوب محور HPA، کوشینگ، هیپرگلیسمی؛ عفونت؛ افزایش فشار و کاهش پتاسیم؛ سوراخ شدن گوارش. سوسپانسیون بنزیل الکل دارد (زیر ۲ سال نه).",
        "en": "HPA-axis suppression, Cushing’s, hyperglycaemia; infections; raised BP and low potassium; GI perforation. Suspension contains benzyl alcohol (not under 2 y)."
      },
      "refs": [
        {
          "source": "fda-emflaza",
