      "id": "dmd",
      "disease": "duchenne",
      "label": {
        "fa": "دیستروفی دوشن (۲ سال به بالا) — حدود ۰٫۹ mg/kg یک بار در روز",
        "en": "Duchenne muscular dystrophy (≥2 y) — about 0.9 mg/kg once daily"
      },
      "population": {
        "minAge": {
          "value": 2,
