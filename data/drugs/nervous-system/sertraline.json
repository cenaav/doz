  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Based on data from published observational studies, exposure to SSRIs, particularly in the month before delivery, has been associated with a less than 2-fold increase in the risk of postpartum hemorrhage [see Warnings and Precautions ( 5.3 ) and Clinical Considerations] .",
      "refs": [
        {
          "source": "fda-sertraline",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Available data from published literature demonstrate low levels of sertraline and its metabolites in human milk [See Data].",
      "refs": [
        {
          "source": "fda-sertraline",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "avoid",
      "text": {
        "fa": "هشدار جعبه‌ای برچسب درباره کودکان.",
        "en": "Boxed warning in the label about children."
      },
      "quote": "Antidepressants increased the risk of suicidal thoughts and behavior in pediatric and young adult patients in short-term studies.",
      "refs": [
        {
          "source": "fda-sertraline",
          "section": "Boxed Warning"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "… significant hyponatremia in elderly patients, who may be at greater risk for this adverse reaction [See Warnings and Precautions ( 5.8 )] .",
      "refs": [
        {
          "source": "fda-sertraline",
          "section": "8.5"
        }
      ]
    }
  }
