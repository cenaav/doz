  "contraindications": [
    {
      "id": "maoi",
      "severity": "block",
      "text": {
        "fa": "مصرف MAOI (شامل لینزولید یا متیلن بلو وریدی) یا تا ۱۴ روز پس از قطع آن.",
        "en": "Taking an MAOI (incl. linezolid or IV methylene blue) or within 14 days of stopping."
      },
      "refs": [
        {
          "source": "fda-sertraline",
          "section": "4"
        }
      ]
    },
    {
      "id": "pimozide",
      "severity": "block",
      "text": {
        "fa": "مصرف همزمان پیموزاید؛ حساسیت به سرترالین.",
        "en": "Concomitant pimozide; hypersensitivity to sertraline."
      },
      "refs": [
        {
          "source": "fda-sertraline",
          "section": "4"
        }
      ]
    },
    {
      "id": "peds-other",
