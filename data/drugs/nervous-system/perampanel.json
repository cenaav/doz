        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Safety and effectiveness of FYCOMPA for the treatment of partial-onset seizures have been established in pediatric patients 4 years of age and older.",
      "refs": [
        {
          "source": "fda-fycompa",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Clinical studies of FYCOMPA did not include sufficient numbers of patients aged 65 and over to determine the safety and efficacy of FYCOMPA in the elderly population.",
      "refs": [
        {
          "source": "fda-fycompa",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Use of FYCOMPA may reduce the efficacy of hormonal contraceptives containing levonorgestrel.",
