      "id": "iv",
      "disease": "general-anesthesia",
      "label": {
        "fa": "القای بیهوشی وریدی — ۱ تا ۴٫۵ mg/kg آهسته در ۶۰ ثانیه",
        "en": "IV induction — 1–4.5 mg/kg slowly over 60 s"
      },
      "population": {
        "minAge": {
          "value": 16,
          "unit": "year"
        }
      },
