      "durationDays": {
        "min": 1,
        "max": 1
      },
      "allowedFormulations": [
        "inj-50",
        "inj-100"
      ],
      "notes": [
        {
          "text": {
            "fa": "۹ تا ۱۳ mg/kg معمولاً ظرف ۳ تا ۴ دقیقه بیهوشی جراحی می‌دهد که ۱۲ تا ۲۵ دقیقه طول می‌کشد.",
            "en": "9–13 mg/kg usually gives surgical anaesthesia within 3–4 min, lasting 12–25 min."
          },
          "refs": [
            {
              "source": "fda-ketamine",
              "section": "2.2"
            }
          ]
        }
      ]
    }
  ],
  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "هر جا افزایش قابل‌توجه فشار خون خطر جدی دارد؛ حساسیت به کتامین.",
        "en": "Patients in whom a significant rise in blood pressure would be a serious hazard; hypersensitivity to ketamine."
      },
      "refs": [
        {
          "source": "fda-ketamine",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "افزایش فشار و ضربان؛ واکنش‌های هنگام بیداری (توهم، رؤیا، هذیان)؛ دپرسیون تنفسی با تزریق سریع؛ ایمنی زیر ۱۶ سال ثابت نشده.",
        "en": "Raised BP and heart rate; emergence reactions (hallucinations, dreams, delirium); respiratory depression with rapid injection; safety under 16 y not established."
      },
      "refs": [
        {
          "source": "fda-ketamine",
          "section": "5"
        },
