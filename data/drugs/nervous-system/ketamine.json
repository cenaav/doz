        {
          "source": "fda-ketamine",
          "section": "2.2"
        }
      ],
      "durationDays": {
        "min": 1,
        "max": 1
      },
      "notes": [
        {
          "text": {
            "fa": "فقط توسط فرد آموزش‌دیده در بیهوشی با امکانات کنترل راه هوایی، اکسیژن و احیا.",
            "en": "Only by persons trained in anaesthesia, with airway management, oxygen and resuscitation available."
          },
          "refs": [
            {
              "source": "fda-ketamine",
              "section": "2.1"
            }
          ]
        },
        {
          "text": {
            "fa": "یا ۱ تا ۲ mg/kg با سرعت ۰٫۵ mg/kg/دقیقه. نگهداری: نصف تا کل دوز القا در صورت نیاز تکرار شود.",
            "en": "Or 1–2 mg/kg at 0.5 mg/kg/min. Maintenance: repeat one-half to the full induction dose as needed."
          },
          "refs": [
            {
              "source": "fda-ketamine",
              "section": "2.2"
            }
          ]
        }
      ]
    },
    {
      "id": "im",
      "disease": "general-anesthesia",
      "label": {
        "fa": "القای بیهوشی عضلانی — ۶٫۵ تا ۱۳ mg/kg",
        "en": "IM induction — 6.5–13 mg/kg"
      },
      "population": {
        "minAge": {
          "value": 16,
          "unit": "year"
        }
      },
      "type": "weightBased",
      "unit": "mg",
      "dose": {
