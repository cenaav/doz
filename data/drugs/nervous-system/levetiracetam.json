  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Prolonged experience with levetiracetam in pregnant women has not identified a drug-associated risk of major birth defects or miscarriage, based on published literature, which includes data from pregnancy registries and reflects experience over two decades [see Human Data ] .",
      "refs": [
        {
          "source": "fda-levetiracetam",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Levetiracetam is excreted in human milk.",
      "refs": [
        {
          "source": "fda-levetiracetam",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "Safety and effectiveness for the treatment of partial-onset seizures in pediatric patients below the age of 1 month; adjunctive therapy for the treatment of myoclonic seizures in pediatric patients below the age of 12 years; and adjunctive therapy for the treatment of primary generalized tonic-clonic seizures in …",
      "refs": [
        {
          "source": "fda-levetiracetam",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Because elderly patients are more likely to have decreased renal function, care should be taken in dose selection, and it may be useful to monitor renal function [see Clinical Pharmacology (12.3) ] .",
      "refs": [
        {
          "source": "fda-levetiracetam",
          "section": "8.5"
        }
      ]
    }
  }
