  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Observational studies on the use of Lyrica during pregnancy suggest a possible small increase in the rate of overall major birth defects, but there was no consistent or specific pattern of major birth defects identified ( see Data ).",
      "refs": [
        {
          "source": "fda-lyrica",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential risk of tumorigenicity, breastfeeding is not recommended during treatment with LYRICA.",
      "refs": [
        {
          "source": "fda-lyrica",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "… ents below the age of 1 month have not been established. 4 to Less Than 17 Years of Age with Partial-Onset Seizures The safety and effectiveness of LYRICA as adjunctive treatment for partial‑onset seizures in pediatric patients 4 to less than 17 years of age have been established in a 12-week, double-blind, …",
      "refs": [
        {
          "source": "fda-lyrica",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "ok",
      "text": {
        "fa": "برچسب: در سالمندان تفاوت یا تنظیم دوز خاصی ذکر نشده.",
        "en": "Label: no specific difference or dose adjustment stated for older adults."
      },
      "quote": "No overall differences in safety and efficacy were observed between these patients and younger patients.",
      "refs": [
        {
          "source": "fda-lyrica",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Infertility Males Effects on Spermatogenesis In a randomized, double-blind, placebo-controlled non-inferiority study to assess the effect of pregabalin on sperm characteristics, healthy male subjects received pregabalin at a daily dose up to 600 mg (n=111) or placebo (n=109) for 13 weeks (one complete sperm cycle) …",
      "refs": [
        {
          "source": "fda-lyrica",
          "section": "8.3"
        }
      ]
    }
  },
