  "contraindications": [
    {
      "id": "hyper",
      "severity": "block",
      "text": {
        "fa": "حساسیت به پالیپریدون، ریسپریدون یا اجزای فرآورده.",
        "en": "Hypersensitivity to paliperidone, risperidone or excipients."
      },
      "refs": [
        {
          "source": "fda-invega",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: افزایش مرگ در سالمندان با سایکوز ناشی از دمانس.",
        "en": "Boxed warning: increased mortality in elderly patients with dementia-related psychosis."
      },
      "refs": [
        {
          "source": "fda-invega",
          "section": "Boxed Warning"
        }
      ]
    },
    {
      "text": {
        "fa": "سندرم نورولپتیک بدخیم؛ طولانی شدن QT؛ دیسکینزی دیررس؛ تغییرات متابولیک؛ هیپرپرولاکتینمی.",
        "en": "Neuroleptic malignant syndrome; QT prolongation; tardive dyskinesia; metabolic changes; hyperprolactinaemia."
      },
      "refs": [
        {
          "source": "fda-invega",
          "section": "5"
        }
      ]
    }
  ],
