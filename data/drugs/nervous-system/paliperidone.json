  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Neonates exposed to antipsychotic drugs during the third trimester of pregnancy are at risk for extrapyramidal and/or withdrawal symptoms following delivery (see Clinical Considerations ) .",
      "refs": [
        {
          "source": "fda-invega",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Limited data from published literature report the presence of paliperidone in human breast milk.",
      "refs": [
        {
          "source": "fda-invega",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Safety and effectiveness of INVEGA in the treatment of schizophrenia were evaluated in 150 adolescent subjects 12–17 years of age with schizophrenia who received INVEGA in the dose range of 1.5 mg to 12 mg/day in a 6-week, double-blind, placebo-controlled trial.",
      "refs": [
        {
          "source": "fda-invega",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: در سالمندان هشدار جدی یا پرهیز.",
        "en": "Label: serious warning or avoid in older adults."
      },
      "quote": "Elderly patients with dementia-related psychosis treated with antipsychotic drugs are at an increased risk of death.",
      "refs": [
        {
          "source": "fda-invega",
          "section": "Boxed Warning"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Infertility Females Based on the pharmacologic action of paliperidone (D 2 receptor antagonism), treatment with INVEGA may result in an increase in serum prolactin levels, which may lead to a reversible reduction in fertility in females of reproductive potential [see Warnings and Precautions (5.7) ].",
      "refs": [
        {
          "source": "fda-invega",
          "section": "8.3"
        }
      ]
    }
  },
