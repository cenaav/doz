    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Pharmacokinetic trials conducted in patients demonstrated that oral clearance of ropinirole is reduced by 15% in patients older than 65 years compared with younger patients [see Clinical Pharmacology (12.3)] .",
