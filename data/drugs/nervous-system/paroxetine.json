  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Based on data from published observational studies, exposure to SSRIs, particularly in the month before delivery, has been associated with a less than 2-fold increase in the risk of postpartum hemorrhage [see Warnings and Precautions ( 5.5 ) and Clinical Considerations].",
      "refs": [
        {
          "source": "fda-paroxetine",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Data from the published literature report the presence of paroxetine in human milk (see Data).",
      "refs": [
        {
          "source": "fda-paroxetine",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "avoid",
      "text": {
        "fa": "هشدار جعبه‌ای برچسب درباره کودکان.",
        "en": "Boxed warning in the label about children."
      },
      "quote": "WARNING: SUICIDAL THOUGHTS AND BEHAVIORS Antidepressants increased the risk of suicidal thoughts and behaviors in pediatric and young adult patients in short-term studies.",
      "refs": [
        {
          "source": "fda-paroxetine",
          "section": "Boxed Warning"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "SSRIs including paroxetine, have been associated with cases of clinically significant hyponatremia in elderly patients, who may be at greater risk for this adverse reaction [see Warnings and Precautions ( 5.7 )].",
      "refs": [
        {
          "source": "fda-paroxetine",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Infertility Male Based on findings from clinical studies, paroxetine may affect sperm quality which may impair fertility; it is not known if this effect is reversible [see Nonclinical Toxicology ( 13.1 )].",
      "refs": [
        {
          "source": "fda-paroxetine",
          "section": "8.3"
        }
      ]
    }
  }
