  "contraindications": [
    {
      "id": "maoi",
      "severity": "block",
      "text": {
        "fa": "مهارکننده MAO همزمان، ظرف ۱۴ روز پس از قطع آن، یا ظرف 5 روز پس از قطع این دارو؛ لینزولید یا متیلن بلو وریدی (سندرم سروتونین).",
        "en": "MAOIs concomitantly, within 14 days of stopping them, or within 5 days of stopping this drug; linezolid or IV methylene blue (serotonin syndrome)."
      },
      "refs": [
        {
          "source": "fda-savella",
          "section": "4.1"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: خطر خودکشی با ضدافسردگی‌ها در کودکان و جوانان؛ برای افسردگی در آمریکا تأیید نشده.",
        "en": "Boxed warning: suicidality with antidepressants in children and young adults; not approved for depression in the US."
      },
      "refs": [
        {
          "source": "fda-savella",
          "section": "Boxed Warning"
        }
      ]
    },
    {
      "text": {
        "fa": "سندرم سروتونین؛ افزایش فشار و ضربان؛ تشنج؛ سمیت کبد؛ هیپوناترمی؛ خونریزی؛ فعال شدن مانیا.",
        "en": "Serotonin syndrome; raised blood pressure and heart rate; seizures; hepatotoxicity; hyponatraemia; bleeding; activation of mania."
      },
      "refs": [
        {
          "source": "fda-savella",
          "section": "5"
        }
      ]
    }
  ],
  "renal": [
