      "notes": [
        {
          "text": {
            "fa": "تیتراسیون: روز ۱: ۱۲٫۵ mg؛ روز ۲–۳: ۱۲٫۵ mg دو بار؛ روز ۴–۷: ۲۵ mg دو بار؛ سپس ۵۰ mg دو بار. با غذا بهتر تحمل می‌شود. قطع تدریجی.",
            "en": "Titration: day 1: 12.5 mg; days 2–3: 12.5 mg twice; days 4–7: 25 mg twice; then 50 mg twice daily. Better tolerated with food. Taper when stopping."
          },
          "refs": [
            {
              "source": "fda-savella",
              "section": "2.1"
            },
            {
              "source": "fda-savella",
              "section": "2.4"
            }
          ]
        }
      ]
    }
