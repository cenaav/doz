        }
      ],
      "durationDays": {
        "min": 28,
        "max": 28
      },
      "allowedFormulations": [
        "patch-21"
      ],
      "notes": [
        {
          "text": {
            "fa": "هفته ۵ و ۶: ۱۴ mg؛ هفته ۷ و ۸: ۷ mg. ۱۰ نخ یا کمتر: ۱۴ mg به مدت ۶ هفته، سپس ۷ mg دو هفته. هر ۲۴ ساعت برچسب نو روی پوست تمیز و بدون مو.",
            "en": "Weeks 5–6: 14 mg; weeks 7–8: 7 mg. ≤10 cigarettes/day: 14 mg for 6 weeks, then 7 mg for 2 weeks. New patch every 24 h on clean, hairless skin."
          },
          "refs": [
            {
              "source": "fda-nicotinepatch",
              "section": "Directions"
            }
          ]
        }
      ]
    },
    {
      "id": "gum",
      "disease": "smoking-cessation",
      "label": {
        "fa": "آدامس نیکوتین — هفته ۱ تا ۶: یک عدد هر ۱ تا ۲ ساعت",
        "en": "Nicotine gum — weeks 1–6: one piece every 1–2 hours"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "notCalculated",
      "unit": "mg",
      "dose": {
        "reason": {
          "fa": "اولین سیگار ظرف ۳۰ دقیقه پس از بیداری: آدامس ۴ mg؛ دیرتر: ۲ mg. هفته ۱ تا ۶ هر ۱ تا ۲ ساعت، ۷ تا ۹ هر ۲ تا ۴ ساعت، ۱۰ تا ۱۲ هر ۴ تا ۸ ساعت. روش «بجو و بگذار».",
          "en": "First cigarette within 30 min of waking: 4 mg gum; later: 2 mg. Weeks 1–6 one piece every 1–2 h, 7–9 every 2–4 h, 10–12 every 4–8 h. \"Chew and park\" method."
        }
      },
      "refs": [
        {
          "source": "fda-nicotinegum",
          "section": "Directions"
        }
      ]
    }
