      "id": "patch",
      "disease": "smoking-cessation",
      "label": {
        "fa": "برچسب نیکوتین — بیش از ۱۰ نخ در روز: ۲۱ mg روزانه ۴ هفته",
        "en": "Nicotine patch — >10 cigarettes/day: 21 mg daily for 4 weeks"
      },
