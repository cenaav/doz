  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Teratogenic Effects Pregnancy Category B: No fertility impairment or fetal damage was observed in reproduction studies performed in rats and rabbits at buspirone doses of approximately 30 times the maximum recommended human dose.",
      "refs": [
        {
          "source": "fda-buspirone",
          "section": "Precautions/Warnings – Pregnancy"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "The extent of the excretion in human milk of buspirone or its metabolites is not known.",
      "refs": [
        {
          "source": "fda-buspirone",
          "section": "Nursing Mothers"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of buspirone were evaluated in two placebo-controlled 6-week trials involving a total of 559 pediatric patients (ranging from 6 to 17 years of age) with GAD.",
      "refs": [
        {
          "source": "fda-buspirone",
          "section": "Pediatric Use"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In one study of 6632 patients who received buspirone for the treatment of anxiety, 605 patients were ≥65 years old and 41 were ≥75 years old; the safety and efficacy profiles for these 605 elderly patients (mean age = 70.8 years) were similar to those in the younger population (mean age = 43.3 years).",
      "refs": [
        {
          "source": "fda-buspirone",
          "section": "Precautions/Warnings – Geriatric Use"
        }
      ]
    }
