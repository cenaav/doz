        "fa": "پارکینسون پیشرفته — شروع ۴ mg/۲۴ ساعت؛ هفتگی ۲ mg افزایش تا ۸ mg/۲۴ ساعت",
        "en": "Advanced-stage Parkinson disease — start 4 mg/24 h; increase by 2 mg weekly to 8 mg/24 h"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "fixed",
      "unit": "mg",
      "dose": {
