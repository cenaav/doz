  "contraindications": [
    {
      "id": "hyper",
      "severity": "block",
      "text": {
        "fa": "حساسیت به روتیگوتین یا اجزای پچ.",
        "en": "Hypersensitivity to rotigotine or the patch components."
      },
      "refs": [
        {
          "source": "fda-neupro",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "به خواب رفتن ناگهانی حین فعالیت روزانه؛ توهم؛ افت فشار و سنکوپ؛ رفتار تکانشی و وسواسی (قمار، خرید)؛ دیسکینزی؛ تب و گیجی با قطع ناگهانی.",
        "en": "Falling asleep during daily activities; hallucinations; hypotension and syncope; impulse-control/compulsive behaviours (gambling, shopping); dyskinesia; hyperpyrexia and confusion on abrupt withdrawal."
      },
      "refs": [
        {
          "source": "fda-neupro",
          "section": "5"
        }
      ]
    },
    {
      "text": {
        "fa": "حساسیت به سولفیت؛ افزایش فشار و ضربان؛ تشدید (augmentation) در RLS؛ پیش از MRI یا کاردیوورژن پچ برداشته شود (سوختگی)؛ گرما روی پچ نه.",
        "en": "Sulfite sensitivity; increased blood pressure and heart rate; augmentation in RLS; remove before MRI or cardioversion (burns); no heat over the patch."
      },
      "refs": [
        {
          "source": "fda-neupro",
          "section": "5"
        }
      ]
    }
  ],
