  "regimens": [
    {
      "id": "early",
      "disease": "parkinsons",
      "label": {
        "fa": "پارکینسون مراحل اولیه — شروع پچ ۲ mg/۲۴ ساعت؛ هفتگی ۲ mg افزایش تا ۶ mg/۲۴ ساعت",
        "en": "Early-stage Parkinson disease — start 2 mg/24 h patch; increase by 2 mg weekly to 6 mg/24 h"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "fixed",
      "unit": "mg",
      "dose": {
        "perDose": 2,
        "perDoseMax": 6,
        "dosesPerDay": 1
      },
      "refs": [
        {
          "source": "fda-neupro",
          "section": "2.1"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "روزانه یک پچ روی پوست سالم (شکم، ران، باسن، پهلو، شانه، بازو)؛ محل هر روز عوض شود. قطع تدریجی: حداکثر ۲ mg هر روز در میان.",
            "en": "One patch daily on intact skin (abdomen, thigh, hip, flank, shoulder, upper arm); rotate the site daily. Taper: max 2 mg every other day."
          },
          "refs": [
            {
              "source": "fda-neupro",
              "section": "2.3"
            },
            {
              "source": "fda-neupro",
              "section": "2.4"
            }
          ]
        }
      ]
    },
    {
      "id": "adv",
      "disease": "parkinsons",
