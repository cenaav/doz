  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary The available data on the use of MARCAINE SPINAL in pregnant women do not establish the presence or absence of developmental toxicity related to the use of MARCAINE SPINAL.",
      "refs": [
        {
          "source": "fda-marcaine-spinal",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Lactation studies have not been conducted with bupivacaine.",
      "refs": [
        {
          "source": "fda-marcaine-spinal",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "MARCAINE SPINAL is approved for use in adults only.",
      "refs": [
        {
          "source": "fda-marcaine-spinal",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Patients 65 years and over, particularly those with hypertension, may be at increased risk for developing hypotension while undergoing spinal anesthesia with MARCAINE SPINAL.",
      "refs": [
