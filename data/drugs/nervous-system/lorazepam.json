  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به بنزودیازپین‌ها؛ گلوکوم زاویه بسته حاد.",
        "en": "Hypersensitivity to benzodiazepines; acute narrow-angle glaucoma."
      },
      "refs": [
        {
          "source": "fda-lorazepam",
