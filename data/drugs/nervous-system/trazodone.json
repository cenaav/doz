  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Published prospective cohort studies, case series, and case reports over several decades with trazodone hydrochloride tablets use in pregnant women have not identified any drug-associated risks of major birth defects, miscarriage, or adverse maternal or fetal outcomes (see Data) .",
      "refs": [
        {
          "source": "fda-trazodone",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Data from published literature report the transfer of trazodone into human milk.",
      "refs": [
        {
          "source": "fda-trazodone",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "avoid",
      "text": {
        "fa": "هشدار جعبه‌ای برچسب درباره کودکان.",
        "en": "Boxed warning in the label about children."
      },
      "quote": "Antidepressants increased the risk of suicidal thoughts and behaviors in pediatric and young adult patients in short-term studies.",
      "refs": [
        {
          "source": "fda-trazodone",
          "section": "Boxed Warning"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "However, as experience in the elderly with trazodone hydrochloride is limited, it should be used with caution in geriatric patients.",
      "refs": [
        {
          "source": "fda-trazodone",
          "section": "8.5"
        }
      ]
