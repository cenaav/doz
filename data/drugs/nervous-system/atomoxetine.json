  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available published studies with atomoxetine use in pregnant women are insufficient to establish a drug-associated risk of major birth defects, miscarriage or adverse maternal or fetal outcomes.",
      "refs": [
        {
          "source": "fda-atomoxetine",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of atomoxetine or its metabolite in human milk, the effects on the breastfed child, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-atomoxetine",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "avoid",
      "text": {
        "fa": "هشدار جعبه‌ای برچسب درباره کودکان.",
        "en": "Boxed warning in the label about children."
      },
      "quote": "• All atomoxetine-treated pediatric patients 6 years of age or older should be monitored and observed closely for suicidal thoughts and behavior, clinical worsening, or unusual changes in behavior, especially during the initial months of therapy or at times of dosage changes.",
      "refs": [
        {
          "source": "fda-atomoxetine",
          "section": "Boxed Warning"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "The safety, efficacy and pharmacokinetics of atomoxetine in geriatric patients have not been evaluated.",
      "refs": [
        {
          "source": "fda-atomoxetine",
          "section": "8.5"
        }
      ]
    }
