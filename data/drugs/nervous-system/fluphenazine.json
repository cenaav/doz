  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "آسیب ساب‌کورتیکال مغز؛ دوز بالای خواب‌آورها؛ کما یا افسردگی شدید CNS؛ دیسکرازی خونی؛ آسیب کبدی؛ حساسیت به فلوفنازین (حساسیت متقاطع فنوتیازین).",
        "en": "Subcortical brain damage; large doses of hypnotics; coma or severe CNS depression; blood dyscrasia; liver damage; hypersensitivity to fluphenazine (phenothiazine cross-sensitivity)."
      },
      "refs": [
        {
          "source": "fda-fluphenazine",
          "section": "Contraindications"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: افزایش مرگ در سالمندان مبتلا به سایکوز ناشی از دمانس — برای این کاربرد تأیید نشده.",
        "en": "Boxed warning: increased mortality in elderly patients with dementia-related psychosis — not approved for this use."
      },
      "refs": [
        {
          "source": "fda-fluphenazine",
          "section": "Warnings"
