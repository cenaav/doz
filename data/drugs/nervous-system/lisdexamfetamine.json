  "regimens": [
    {
      "id": "adhd",
      "disease": "adhd",
      "label": {
        "fa": "ADHD — ۶ سال به بالا: شروع ۳۰ mg صبح‌ها (تا ۷۰ mg)",
        "en": "ADHD — ≥6 y: start 30 mg every morning (up to 70 mg)"
      },
      "population": {
        "minAge": {
          "value": 6,
          "unit": "year"
        }
      },
      "type": "titration",
      "unit": "mg",
      "dose": {
        "dividedDoses": 1,
        "titration": {
          "start": 30,
          "increment": 10,
          "incrementEveryDays": 7,
          "max": 70
        }
      },
      "refs": [
        {
          "source": "fda-vyvanse",
          "section": "2.3"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "افزایش ۱۰ یا ۲۰ mg تقریباً هفتگی. صبح؛ دوز بعدازظهر نه (بی‌خوابی). نارسایی شدید کلیه: حداکثر ۵۰ mg؛ ESRD: ۳۰ mg.",
            "en": "Increase by 10 or 20 mg about weekly. Morning; avoid afternoon doses (insomnia). Severe renal impairment: max 50 mg; ESRD: 30 mg."
          },
          "refs": [
            {
              "source": "fda-vyvanse",
              "section": "2.3"
            },
            {
              "source": "fda-vyvanse",
              "section": "2.2"
            },
            {
              "source": "fda-vyvanse",
              "section": "2.5"
            }
          ]
        }
      ]
    }
  ],
  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به آمفتامین‌ها؛ MAOI همزمان یا ظرف ۱۴ روز (از جمله لینزولید یا متیلن بلو وریدی).",
        "en": "Hypersensitivity to amphetamines; MAOIs now or within 14 days (including linezolid or IV methylene blue)."
