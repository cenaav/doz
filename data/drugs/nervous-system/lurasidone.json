  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به لوراسیدون؛ مهارکننده‌های قوی CYP3A4 (کتوکونازول، کلاریترومایسین، ریتوناویر...)؛ القاگرهای قوی CYP3A4 (ریفامپین، فنی‌توئین، کاربامازپین، گل راعی...).",
        "en": "Hypersensitivity to lurasidone; strong CYP3A4 inhibitors (ketoconazole, clarithromycin, ritonavir…); strong CYP3A4 inducers (rifampin, phenytoin, carbamazepine, St John’s wort…)."
      },
      "refs": [
        {
          "source": "fda-latuda",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: افزایش مرگ در سالمندان با سایکوز ناشی از دمانس.",
        "en": "Boxed warning: increased mortality in elderly patients with dementia-related psychosis."
      },
      "refs": [
        {
          "source": "fda-latuda",
          "section": "Boxed Warning"
        }
      ]
    },
    {
      "text": {
        "fa": "هشدار جعبه‌ای: افزایش افکار و رفتار خودکشی در کودکان، نوجوانان و جوانان.",
        "en": "Boxed warning: increased suicidal thoughts and behaviour in children, adolescents and young adults."
      },
      "refs": [
        {
          "source": "fda-latuda",
          "section": "Boxed Warning"
        }
      ]
    },
    {
      "text": {
        "fa": "سندرم نورولپتیک بدخیم؛ دیسکینزی دیررس؛ تغییرات متابولیک.",
        "en": "Neuroleptic malignant syndrome; tardive dyskinesia; metabolic changes."
      },
      "refs": [
        {
          "source": "fda-latuda",
          "section": "5"
        }
      ]
    }
  ],
  "renal": [
    {
      "egfrBelow": 50,
