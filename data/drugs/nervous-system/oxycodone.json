  "regimens": [
    {
      "id": "pain",
      "disease": "severe-pain",
      "label": {
        "fa": "درد شدید (بیمار بدون مصرف قبلی اپیوئید) — ۵ تا ۱۵ mg هر ۴ تا ۶ ساعت در صورت نیاز",
        "en": "Severe pain (opioid-naive) — 5–15 mg every 4–6 h as needed"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "fixed",
      "unit": "mg",
      "dose": {
        "perDose": 5,
        "perDoseMax": 15,
        "dosesPerDay": 4
      },
      "refs": [
        {
          "source": "fda-oxycodone",
          "section": "2.3"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "کمترین دوز مؤثر در کوتاه‌ترین مدت. «هر ۴ تا ۶ ساعت در صورت نیاز»؛ عدد دفعات در ماشین‌حساب برای ۶ ساعت است. تبدیل از اپیوئید دیگر طبق برچسب.",
            "en": "Lowest effective dose for the shortest time. “Every 4–6 h as needed”; the calculator shows 6-hourly. Conversion from other opioids per label."
          },
          "refs": [
            {
              "source": "fda-oxycodone",
              "section": "2.1"
            },
            {
              "source": "fda-oxycodone",
              "section": "2.3"
            }
          ]
        }
      ]
    }
  ],
  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "دپرسیون تنفسی قابل‌توجه؛ آسم حاد یا شدید بدون پایش؛ انسداد گوارشی یا ایلئوس فلجی؛ حساسیت.",
        "en": "Significant respiratory depression; acute or severe asthma without monitoring; GI obstruction or paralytic ileus; hypersensitivity."
      },
      "refs": [
        {
          "source": "fda-oxycodone",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: اعتیاد و سوءمصرف، دپرسیون تنفسی کشنده، مصرف تصادفی در کودک، سندرم ترک نوزادی، تداخل با بنزودیازپین‌ها و مهارکننده‌های CYP3A4. نالوکسان در دسترس باشد.",
        "en": "Boxed warning: addiction and misuse, life-threatening respiratory depression, accidental ingestion in children, neonatal opioid withdrawal, interactions with benzodiazepines and CYP3A4 inhibitors. Keep naloxone available."
      },
      "refs": [
        {
          "source": "fda-oxycodone",
          "section": "Boxed Warning"
        },
        {
          "source": "fda-oxycodone",
          "section": "2.2"
        }
      ]
    }
  ],
