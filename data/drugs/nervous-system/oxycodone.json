  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Neonatal Opioid Withdrawal Syndrome (NOWS) Advise pregnant women using opioids for an extended period of time of the risk of Neonatal Opioid Withdrawal Syndrome , which may be life-threatening if not recognized and treated.",
      "refs": [
        {
          "source": "fda-oxycodone",
          "section": "Boxed Warning"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Available data from lactation studies indicate that oxycodone is present in breastmilk and that doses of less than 60 mg/day of the immediate-release formulation are unlikely to result in clinically relevant exposures in breastfed infants.",
      "refs": [
        {
          "source": "fda-oxycodone",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان بررسی نشده است. مصرف تصادفی حتی یک دوز در کودک می‌تواند کشنده باشد.",
        "en": "Label: not evaluated in children. Accidental ingestion of even one dose by a child can be fatal."
      },
      "quote": "The safety and efficacy of oxycodone hydrochloride tablets in pediatric patients have not been evaluated.",
      "refs": [
        {
          "source": "fda-oxycodone",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In general, use caution when selecting a dosage for an elderly patient, usually starting at the low end of the dosing range, reflecting the greater frequency of decreased hepatic, renal, or cardiac function and of concomitant disease or other drug therapy.",
      "refs": [
        {
          "source": "fda-oxycodone",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Infertility Use of opioids for an extended period of time may cause reduced fertility in females and males of reproductive potential.",
      "refs": [
        {
          "source": "fda-oxycodone",
          "section": "8.3"
        }
      ]
    }
  }
