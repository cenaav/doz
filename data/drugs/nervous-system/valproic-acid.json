  "contraindications": [
    {
      "id": "under-2",
      "severity": "block",
      "rule": {
        "maxAge": {
          "value": 2,
          "unit": "year"
        }
      },
      "text": {
        "fa": "زیر ۲ سال خطر کشنده آسیب کبدی بسیار بالاتر است.",
        "en": "Under 2 years: considerably higher risk of fatal hepatotoxicity."
      },
      "refs": [
        {
          "source": "fda-valproicsol",
          "section": "8.4"
        }
      ]
    },
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "بیماری یا اختلال قابل‌توجه کبد؛ اختلال میتوکندریایی POLG؛ حساسیت؛ اختلال چرخه اوره؛ برای پیشگیری میگرن: بارداری یا عدم پیشگیری مؤثر.",
        "en": "Hepatic disease or significant dysfunction; POLG mitochondrial disorders; hypersensitivity; urea-cycle disorders; for migraine prophylaxis: pregnancy or no effective contraception."
      },
      "refs": [
        {
          "source": "fda-valproicsol",
          "section": "4"
        }
      ]
    },
    {
      "id": "boxed",
      "severity": "warn",
      "text": {
        "fa": "هشدار جعبه‌ای: سمیت کبدی، تراتوژنیسیته، پانکراتیت.",
        "en": "Boxed warning: hepatotoxicity, teratogenicity, pancreatitis."
      },
      "refs": [
        {
