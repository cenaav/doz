  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Topiramate can cause fetal harm when administered to a pregnant woman.",
      "refs": [
        {
          "source": "fda-topiramate",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Topiramate is excreted in human milk [see Data].",
      "refs": [
        {
          "source": "fda-topiramate",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Adjunctive Treatment for Epilepsy Pediatric Patients 2 Years of Age and Older The safety and effectiveness of topiramate as adjunctive therapy for the treatment of partial-onset seizures, primary generalized tonic-clonic seizures, or seizures associated with Lennox-Gastaut syndrome have been established in pediatric …",
      "refs": [
        {
          "source": "fda-topiramate",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Dosage adjustment may be necessary for elderly with age-related renal impairment (creatinine clearance rate < 70 mL/min/1.73 m 2 ) resulting in reduced clearance [see Dosage and Administration ( 2.5 ), Clinical Pharmacology ( 12.3 )] .",
      "refs": [
        {
          "source": "fda-topiramate",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Women of childbearing potential who are not planning a pregnancy should use effective contraception because of the risk of major congenital malformations, including oral clefts and the risk of infants being SGA [see Drug Interactions ( 7.4 ) and Use in Specific Populations ( 8.1 )] .",
      "refs": [
        {
          "source": "fda-topiramate",
          "section": "8.3"
        }
      ]
    }
