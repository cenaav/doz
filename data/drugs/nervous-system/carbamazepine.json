  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "سابقه سرکوب مغز استخوان؛ حساسیت به کاربامازپین یا ضدافسردگی‌های سه‌حلقه‌ای؛ MAOI.",
        "en": "History of bone marrow depression; hypersensitivity to carbamazepine or tricyclics; MAOIs."
      },
      "refs": [
        {
          "source": "fda-carbamazepine",
          "section": "Contraindications"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: واکنش‌های پوستی کشنده (SJS/TEN) مرتبط با آلل HLA-B*1502 (خطر حدود ۱۰ برابر در برخی جمعیت‌های آسیایی)؛ آپلاستیک آنمی و آگرانولوسیتوز.",
        "en": "Boxed warning: fatal skin reactions (SJS/TEN) linked to HLA-B*1502 (about 10× risk in some Asian populations); aplastic anemia and agranulocytosis."
      },
      "refs": [
        {
          "source": "fda-carbamazepine",
          "section": "WARNINGS (boxed): SERIOUS DERMATOLOGIC REACTIONS AND HLA-B*1502 ALLELE"
        }
      ]
    }
  ],
