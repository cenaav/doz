  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Neonatal Opioid Withdrawal Syndrome (NOWS) Advise pregnant women using opioids for an extended period of time of the risk of Neonatal Opioid Withdrawal Syndrome, which may be life-threatening if not recognized and treated.",
      "refs": [
        {
          "source": "fda-tramadol",
          "section": "Boxed Warning"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions, including excess sedation and respiratory depression in a breastfed infant, advise patients that breastfeeding is not recommended during treatment with tramadol hydrochloride tablets [see Warnings and Precautions (5.4) ] .",
      "refs": [
        {
          "source": "fda-tramadol",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "contraindicated",
      "text": {
        "fa": "برچسب: در کودکان زیر سن مشخص منع مصرف دارد.",
        "en": "Label: contraindicated in children below a stated age."
      },
      "quote": "Tramadol Hydrochloride Tablets, USP are contraindicated for: • all children younger than 12 years of age [see Warnings and Precautions (5.4) ]. • post-operative management in children younger than 18 years of age following tonsillectomy and/or adenoidectomy [see Warnings and Precautions (5.4) ].",
      "refs": [
        {
          "source": "fda-tramadol",
          "section": "4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Because elderly patients are more likely to have decreased renal function, care should be taken in dose selection, and it may be useful to to regularly evaluate renal function.",
      "refs": [
        {
          "source": "fda-tramadol",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Infertility Use of opioids for an extended period of time may cause reduced fertility in females and males of reproductive potential.",
      "refs": [
        {
          "source": "fda-tramadol",
          "section": "8.3"
        }
      ]
    }
  }
