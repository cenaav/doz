  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Neonates exposed to antipsychotic drugs, including ZYPREXA, during the third trimester are at risk for extrapyramidal and/or withdrawal symptoms following delivery (see Clinical Considerations) .",
      "refs": [
        {
          "source": "fda-zyprexa",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Olanzapine is present in human milk.",
      "refs": [
        {
          "source": "fda-zyprexa",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان ثابت نشده است.",
        "en": "Label: safety and effectiveness in children have not been established."
      },
      "quote": "Safety and effectiveness of olanzapine in children <13 years of age have not been established [see Patient Counseling Information ( 17 )] .",
      "refs": [
        {
          "source": "fda-zyprexa",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: در سالمندان هشدار جدی یا پرهیز.",
        "en": "Label: serious warning or avoid in older adults."
      },
      "quote": "Elderly patients with dementia-related psychosis treated with antipsychotic drugs are at an increased risk of death.",
      "refs": [
        {
          "source": "fda-zyprexa",
          "section": "Boxed Warning"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Infertility Females Based on the pharmacologic action of olanzapine (D 2 receptor antagonism), treatment with ZYPREXA may result in an increase in serum prolactin levels, which may lead to a reversible reduction in fertility in females of reproductive potential [see Warnings and Precautions ( 5.15 )] .",
      "refs": [
        {
          "source": "fda-zyprexa",
          "section": "8.3"
        }
      ]
    }
