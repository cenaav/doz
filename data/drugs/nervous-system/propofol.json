  "contraindications": [
    {
      "id": "hyper",
      "severity": "block",
      "text": {
        "fa": "حساسیت به پروپوفول یا اجزای آن؛ سابقه آنافیلاکسی به تخم‌مرغ یا سویا.",
        "en": "Hypersensitivity to propofol or its components; history of anaphylaxis to eggs or soy."
      },
      "refs": [
        {
          "source": "fda-diprivan",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "افت فشار و دپرسیون تنفسی؛ سندرم انفوزیون پروپوفول در دوز بالا و طولانی؛ امولسیون چربی — رعایت سترونی (رشد میکروب).",
        "en": "Hypotension and respiratory depression; propofol infusion syndrome with high-dose prolonged use; lipid emulsion — strict asepsis (supports microbial growth)."
      },
      "refs": [
        {
          "source": "fda-diprivan",
          "section": "5"
        }
      ]
    }
  ],
