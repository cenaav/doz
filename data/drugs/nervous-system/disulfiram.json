  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "مصرف اخیر مترونیدازول، پارالدئید، الکل یا فرآورده‌های الکل‌دار؛ بیماری شدید میوکارد یا انسداد کرونر؛ سایکوز؛ حساسیت به تیورام‌ها.",
        "en": "Recent metronidazole, paraldehyde, alcohol or alcohol-containing preparations; severe myocardial disease or coronary occlusion; psychosis; thiuram hypersensitivity."
      },
      "refs": [
        {
          "source": "fda-disulfiram",
          "section": "Contraindications"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: هرگز در حالت مستی یا بدون آگاهی بیمار داده نشود. هپاتیت و نارسایی کبد (گاهی کشنده)؛ نوریت اپتیک و نوروپاتی.",
        "en": "Boxed warning: never give to an intoxicated patient or without their knowledge. Hepatitis and hepatic failure (sometimes fatal); optic neuritis and neuropathy."
      },
      "refs": [
        {
          "source": "fda-disulfiram",
