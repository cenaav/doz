  "contraindications": [
    {
      "id": "hyper",
      "severity": "block",
      "text": {
        "fa": "حساسیت به اسلی‌کاربازپین یا اکس‌کاربازپین.",
        "en": "Hypersensitivity to eslicarbazepine acetate or oxcarbazepine."
      },
      "refs": [
        {
          "source": "fda-aptiom",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "افکار و رفتار خودکشی؛ قطع ناگهانی نه (خطر تشنج و استاتوس).",
        "en": "Suicidal thoughts and behaviour; do not stop abruptly (seizures, status epilepticus)."
      },
      "refs": [
        {
          "source": "fda-aptiom",
          "section": "5.1"
        }
      ]
    },
    {
      "text": {
        "fa": "واکنش پوستی شدید و DRESS؛ آنافیلاکسی؛ هیپوناترمی؛ سرگیجه و اختلال تعادل؛ آسیب کبدی. نارسایی شدید کبد توصیه نمی‌شود.",
        "en": "Serious skin reactions and DRESS; anaphylaxis; hyponatraemia; dizziness and gait disturbance; liver injury. Not recommended in severe hepatic impairment."
      },
      "refs": [
        {
          "source": "fda-aptiom",
          "section": "5"
        },
        {
          "source": "fda-aptiom",
          "section": "2.5"
        }
      ]
    }
  ],
