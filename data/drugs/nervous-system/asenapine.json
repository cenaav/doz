  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "نارسایی شدید کبد (Child-Pugh C)؛ سابقه حساسیت به آسناپین (آنافیلاکسی، آنژیوادم).",
        "en": "Severe hepatic impairment (Child-Pugh C); history of hypersensitivity to asenapine (anaphylaxis, angioedema)."
      },
      "refs": [
        {
          "source": "fda-saphris",
          "section": "4"
        }
      ]
