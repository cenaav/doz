  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Based on data from published observational studies, exposure to SSRIs, particularly in the month before delivery, has been associated with a less than 2-fold increase in the risk of postpartum hemorrhage [see Warnings and Precautions ( 5.4 ) and Clinical Considerations] .",
      "refs": [
        {
          "source": "fda-celexa",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Data from the published literature report the presence of citalopram in human milk at relative infant doses ranging between 0.7 to 9.4% of the maternal weight-adjusted dosage and a milk/plasma ratio ranging between 0.78 to 4.3.",
      "refs": [
        {
          "source": "fda-celexa",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "avoid",
      "text": {
        "fa": "هشدار جعبه‌ای برچسب درباره کودکان.",
        "en": "Boxed warning in the label about children."
      },
      "quote": "Antidepressants increased the risk of suicidal thoughts and behaviors in pediatric and young adult patients in short -term studies .",
      "refs": [
        {
          "source": "fda-celexa",
          "section": "Boxed Warning"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Therefore, the maximum recommended dosage in patients 60 years of age and older is lower than younger patients [see Dosage and Administration ( 2.3 ) , Warnings and Precautions ( 5.2 ) ] .",
      "refs": [
