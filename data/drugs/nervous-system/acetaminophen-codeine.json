  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Neonatal Opioid Withdrawal Syndrome (NOWS) Advise pregnant women using opioids for an extended period of time of the risk of Neonatal Opioid Withdrawal Syndrome, which may be life-threatening if not recognized and treated.",
      "refs": [
        {
          "source": "fda-tylenol3",
          "section": "Boxed Warning"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions, including excess sedation, respiratory depression, and death in a breastfed infant, advise patients that breastfeeding is not recommended during treatment with acetaminophen and codeine phosphate tablets (see WARNINGS ).",
      "refs": [
        {
          "source": "fda-tylenol3",
          "section": "Nursing Mothers"
        }
      ]
    },
    "pediatric": {
      "level": "contraindicated",
      "text": {
        "fa": "برچسب: در کودکان زیر سن مشخص منع مصرف دارد.",
        "en": "Label: contraindicated in children below a stated age."
      },
      "quote": "Acetaminophen and codeine phosphate tablets are contraindicated for: • All children younger than 12 years of age (see WARNINGS ) • Post-operative management in children younger than 18 years of age following tonsillectomy and/or adenoidectomy (see WARNINGS ).",
      "refs": [
        {
          "source": "fda-tylenol3",
          "section": "CONTRAINDICATIONS"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In general, use caution when selecting a dosage for an elderly patient, usually starting at the low end of the dosing range, reflecting the greater frequency of decreased hepatic, renal, or cardiac function and of concomitant disease or other drug therapy.",
      "refs": [
        {
          "source": "fda-tylenol3",
          "section": "Geriatric Use"
        }
      ]
    }
