  "contraindications": [
    {
      "id": "under-12",
      "severity": "block",
      "rule": {
        "maxAge": {
          "value": 12,
          "unit": "year"
        }
      },
      "text": {
        "fa": "زیر ۱۲ سال منع مصرف (دپرسیون تنفسی کشنده)؛ پس از تونسیلکتومی زیر ۱۸ سال.",
        "en": "Contraindicated under 12 (fatal respiratory depression); after tonsillectomy under 18."
      },
      "refs": [
        {
          "source": "fda-tylenol3",
          "section": "Contraindications"
        }
      ]
    },
    {
      "id": "boxed",
      "severity": "warn",
      "text": {
        "fa": "هشدار جعبه‌ای: اعتیاد، دپرسیون تنفسی، متابولیسم فوق‌سریع کدئین، سمیت کبدی استامینوفن، تداخل با بنزودیازپین‌ها.",
        "en": "Boxed warning: addiction, respiratory depression, ultra-rapid codeine metabolism, acetaminophen hepatotoxicity, benzodiazepine interaction."
      },
      "refs": [
        {
          "source": "fda-tylenol3",
          "section": "Boxed Warning"
        }
      ]
    }
