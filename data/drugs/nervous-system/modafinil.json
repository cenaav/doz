        {
          "source": "fda-modafinil",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Because many drugs are excreted in human milk, caution should be exercised when modafinil tablets are administered to a nursing woman.",
