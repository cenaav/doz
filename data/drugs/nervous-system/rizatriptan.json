  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available human data on the use of rizatriptan benzoate in pregnant women are not sufficient to draw conclusions about drug-associated risk for major birth defects and miscarriage.",
      "refs": [
        {
          "source": "fda-rizatriptan-odt",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of rizatriptan or any active metabolites in human milk, or on the effects of rizatriptan on the breastfed infant, or on milk production.",
      "refs": [
        {
          "source": "fda-rizatriptan-odt",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Safety and effectiveness in pediatric patients under 6 years of age have not been established.",
      "refs": [
        {
          "source": "fda-rizatriptan-odt",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Although the pharmacokinetics of rizatriptan were similar in elderly (aged ≥65 years) and in younger adults (n=17), in general, dose selection for an elderly patient should be cautious, starting at the low end of the dosing range.",
      "refs": [
        {
          "source": "fda-rizatriptan-odt",
