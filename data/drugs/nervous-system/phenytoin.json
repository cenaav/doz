    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Information on the registry can also be found at the website http://www.aedpregnancyregistry.org/ Risk Summary In humans, prenatal exposure to phenytoin may increase the risks for congenital malformations and other adverse developmental outcomes.",
      "refs": [
        {
          "source": "fda-phenytoin",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Phenytoin is secreted in human milk.",
      "refs": [
        {
          "source": "fda-phenytoin",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Initially, 5 mg/kg/day in two or three equally divided doses, with subsequent dosage individualized to a maximum of 300 mg daily.",
      "refs": [
        {
          "source": "fda-phenytoin",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
