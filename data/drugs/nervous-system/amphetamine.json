    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data from published epidemiologic studies and postmarketing reports on use of prescription amphetamine in pregnant women have not identified a drug-associated risk of major birth defects and miscarriage (see Data ) .",
      "refs": [
        {
          "source": "fda-adderall-xr",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in nursing infants, advise patients that breastfeeding is not recommended during treatment with ADDERALL XR.",
      "refs": [
        {
          "source": "fda-adderall-xr",
          "section": "8.2"
        }
      ]
    },
