  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به آمفتامین؛ MAOI همزمان یا ظرف ۱۴ روز (بحران فشار خون).",
        "en": "Hypersensitivity to amphetamine; MAOIs concomitantly or within 14 days (hypertensive crisis)."
      },
