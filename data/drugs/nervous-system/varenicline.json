  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data have not suggested an increased risk for major birth defects following exposure to varenicline in pregnancy, compared with women who smoke [see Data] .",
      "refs": [
        {
          "source": "fda-varenicline",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of varenicline in human milk, the effects on the breastfed infant, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-varenicline",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان ثابت نشده است.",
        "en": "Label: safety and effectiveness in children have not been established."
      },
      "quote": "Varenicline tablets is not recommended for use in pediatric patients 16 years of age or younger because its efficacy in this population was not demonstrated.",
      "refs": [
        {
          "source": "fda-varenicline",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Because elderly patients are more likely to have decreased renal function, care should be taken in dose selection, and it may be useful to monitor renal function [see Dosage and Administration (2.2) ].",
      "refs": [
        {
          "source": "fda-varenicline",
