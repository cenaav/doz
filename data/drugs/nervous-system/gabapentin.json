  "regimens": [
    {
      "id": "phn",
      "disease": "neuropathic-pain",
      "label": {
        "fa": "درد پس از زونا — بزرگسال: روز ۱: ۳۰۰، روز ۲: ۶۰۰، روز ۳: ۹۰۰ mg/day",
        "en": "Postherpetic neuralgia — adults: day 1 300, day 2 600, day 3 900 mg/day"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "titration",
      "unit": "mg",
      "dose": {
        "dividedDoses": 3,
        "titration": {
          "start": 900,
          "increment": 300,
          "incrementEveryDays": 1,
          "targetMin": 1800,
          "targetMax": 1800,
          "max": 1800
        }
      },
      "refs": [
        {
          "source": "fda-gabapentin",
          "section": "2.1"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "روز ۱: ۳۰۰ mg تک‌دوز؛ روز ۲: ۳۰۰ دو بار؛ روز ۳: ۳۰۰ سه بار؛ سپس تا ۱۸۰۰ mg/day (۶۰۰ سه بار). بالای ۱۸۰۰ سود اضافه نشان نداده. دوز نمایش‌داده‌شده از روز ۳ است.",
            "en": "Day 1: 300 mg once; day 2: 300 twice; day 3: 300 three times; then up to 1,800 mg/day (600 tid). No added benefit shown above 1,800. Displayed dose is from day 3."
          },
          "refs": [
            {
              "source": "fda-gabapentin",
              "section": "2.1"
            }
          ]
        }
      ]
    },
    {
      "id": "epi-12",
      "disease": "epilepsy",
      "label": {
        "fa": "صرع پارشیل — ۱۲ سال به بالا: ۳۰۰ mg سه بار در روز",
        "en": "Partial seizures — ≥12 y: 300 mg three times daily"
      },
      "population": {
        "minAge": {
          "value": 12,
          "unit": "year"
        }
      },
      "type": "fixed",
      "unit": "mg",
      "dose": {
        "perDose": 300,
        "perDoseMax": 600,
        "dosesPerDay": 3
      },
      "refs": [
        {
          "source": "fda-gabapentin",
          "section": "2.2"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "نگهدارنده ۳۰۰ تا ۶۰۰ mg سه بار؛ تا ۲۴۰۰ mg/day در مطالعات طولانی. فاصله دوزها بیش از ۱۲ ساعت نشود. نارسایی کلیه: کاهش دوز (جدول ۱).",
            "en": "Maintenance 300–600 mg tid; up to 2,400 mg/day in long-term studies. Interval between doses ≤12 h. Renal impairment: reduce (Table 1)."
          },
          "refs": [
            {
              "source": "fda-gabapentin",
              "section": "2.2"
            },
            {
              "source": "fda-gabapentin",
              "section": "2.3"
            }
          ]
        }
      ]
    },
    {
      "id": "epi-3-11",
      "disease": "epilepsy",
      "label": {
        "fa": "صرع پارشیل — ۳ تا ۱۱ سال: شروع ۱۰ تا ۱۵ mg/kg/day در ۳ نوبت",
        "en": "Partial seizures — 3–11 y: start 10–15 mg/kg/day in 3 doses"
      },
      "population": {
        "minAge": {
          "value": 3,
          "unit": "year"
        },
        "maxAge": {
          "value": 12,
          "unit": "year"
