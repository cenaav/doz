  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data from published epidemiological studies and postmarketing reports have not established an increased risk for major birth defects or miscarriage with doxepin hydrochloride capsules use (see Data).",
      "refs": [
        {
          "source": "fda-doxepin",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions, including excess sedation and respiratory depression in a breastfed infant, advise patients that breastfeeding is not recommended during doxepin hydrochloride capsules treatment.",
      "refs": [
        {
          "source": "fda-doxepin",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "avoid",
      "text": {
        "fa": "هشدار جعبه‌ای برچسب درباره کودکان.",
        "en": "Boxed warning in the label about children."
      },
      "quote": "Antidepressants increase the risk of suicidal thoughts and behavior in pediatric and young adult patients in short-term studies.",
      "refs": [
        {
          "source": "fda-doxepin",
          "section": "Boxed Warning"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Clinical studies of doxepin did not include sufficient numbers of patients 65 years of age and older to determine whether they respond differently from younger adult patients.",
