  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "In embryofetal development studies in rats and rabbits, oral administration of up to 100 mg/kg/day and 50 mg/kg/day, respectively, to pregnant animals throughout organogenesis produced no evidence of teratogenicity.",
      "refs": [
        {
          "source": "fda-zaleplon",
          "section": "Pregnancy"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "A study in lactating mothers indicated that the clearance and half-life of zaleplon is similar to that in young normal subjects.",
      "refs": [
        {
          "source": "fda-zaleplon",
          "section": "Nursing Mothers"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان ثابت نشده است.",
        "en": "Label: safety and effectiveness in children have not been established."
      },
      "quote": "The safety and effectiveness of zaleplon in pediatric patients have not been established.",
      "refs": [
        {
          "source": "fda-zaleplon",
          "section": "Pediatric Use"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In both sleep laboratory and outpatient studies, elderly patients with insomnia responded to a 5 mg dose with a reduced sleep latency, and thus 5 mg is the recommended dose in this population.",
      "refs": [
        {
          "source": "fda-zaleplon",
