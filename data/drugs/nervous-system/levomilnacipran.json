  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به لووميلناسیپران یا میلناسیپران؛ مهارکننده MAO همزمان، ظرف ۷ روز پس از قطع این دارو یا ۱۴ روز پس از قطع MAOI؛ لینزولید یا متیلن بلو وریدی.",
        "en": "Hypersensitivity to levomilnacipran or milnacipran; MAOIs concomitantly, within 7 days of stopping this drug or 14 days of stopping the MAOI; linezolid or IV methylene blue."
      },
      "refs": [
        {
          "source": "fda-fetzima",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: افزایش افکار و رفتار خودکشی در کودکان و جوانان — پایش بدتر شدن بالینی.",
        "en": "Boxed warning: increased suicidal thoughts and behaviours in children and young adults — monitor for clinical worsening."
      },
      "refs": [
        {
          "source": "fda-fetzima",
          "section": "Boxed Warning"
        }
      ]
    },
    {
      "text": {
        "fa": "سندرم سروتونین؛ افزایش فشار خون و ضربان؛ خونریزی؛ گلوکوم زاویه بسته؛ احتباس ادرار؛ هیپوناترمی.",
        "en": "Serotonin syndrome; raised blood pressure and heart rate; bleeding; angle-closure glaucoma; urinary retention; hyponatraemia."
      },
      "refs": [
        {
          "source": "fda-fetzima",
          "section": "5"
        }
      ]
    }
  ],
  "renal": [
    {
      "egfrBelow": 60,
      "severity": "warn",
      "text": {
        "fa": "ClCr ۳۰ تا ۵۹: حداکثر ۸۰ mg؛ ۱۵ تا ۲۹: حداکثر ۴۰ mg. ESRD توصیه نمی‌شود.",
        "en": "CrCl 30–59: max 80 mg; 15–29: max 40 mg. ESRD not recommended."
      },
