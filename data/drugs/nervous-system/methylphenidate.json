      "notes": [
        {
          "text": {
            "fa": "قبل از صبحانه و ناهار؛ افزایش هفتگی ۵ تا ۱۰ mg؛ بیش از ۶۰ mg/day توصیه نمی‌شود. اگر پس از یک ماه بهبود نبود قطع شود.",
            "en": "Before breakfast and lunch; increase 5–10 mg weekly; above 60 mg/day not recommended. Discontinue if no improvement after one month."
          },
          "refs": [
            {
              "source": "fda-ritalin",
              "section": "2.2"
            },
            {
              "source": "fda-ritalin",
              "section": "2.3"
            }
