        },
        {
          "text": {
            "fa": "پیش از شروع: بیماری قلبی، سابقه خانوادگی مرگ ناگهانی و تیک/تورت بررسی شود.",
            "en": "Before starting: screen for cardiac disease, family history of sudden death, tics/Tourette's."
          },
          "refs": [
            {
              "source": "fda-ritalin",
              "section": "2.1"
            }
          ]
        }
