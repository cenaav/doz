  "regimens": [
    {
      "id": "ad",
      "disease": "alzheimers",
      "label": {
        "fa": "دمانس خفیف تا متوسط آلزایمر — نگهدارنده ۸ mg دو بار (تا ۱۲ mg دو بار)؛ شروع ۴ mg دو بار",
        "en": "Mild to moderate Alzheimer dementia — maintenance 8 mg twice daily (up to 12 mg twice daily); start 4 mg twice daily"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "fixed",
      "unit": "mg",
      "dose": {
        "perDose": 8,
        "perDoseMax": 12,
        "dosesPerDay": 2
      },
      "refs": [
        {
          "source": "fda-galantamine",
          "section": "2.2"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "شروع ۴ mg دو بار، پس از دست‌کم ۴ هفته ۸ mg دو بار و پس از ۴ هفته دیگر تا ۱۲ mg دو بار. با غذا و مایعات کافی. نارسایی متوسط کبد حداکثر ۱۶ mg/روز؛ شدید توصیه نمی‌شود.",
            "en": "Start 4 mg twice daily; after ≥4 weeks 8 mg twice daily; after another 4 weeks up to 12 mg twice daily. With meals and adequate fluids. Moderate hepatic impairment max 16 mg/day; severe not recommended."
          },
          "refs": [
            {
              "source": "fda-galantamine",
              "section": "2.2"
            },
            {
              "source": "fda-galantamine",
              "section": "2.3"
            }
          ]
        }
      ]
    }
  ],
  "contraindications": [
    {
      "id": "hyper",
      "severity": "block",
      "text": {
        "fa": "حساسیت به گالانتامین.",
        "en": "Hypersensitivity to galantamine."
      },
      "refs": [
        {
          "source": "fda-galantamine",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "واکنش پوستی شدید (SJS)؛ برادیکاردی و بلوک قلبی؛ خونریزی گوارشی؛ انسداد ادراری؛ تشنج؛ تشدید آسم/COPD؛ تشدید شل‌کننده‌های عضلانی سوکسینیل‌کولینی در بیهوشی.",
        "en": "Serious skin reactions (SJS); bradycardia and heart block; GI bleeding; urinary outflow obstruction; seizures; asthma/COPD; exaggerates succinylcholine-type relaxation in anaesthesia."
      },
      "refs": [
        {
          "source": "fda-galantamine",
          "section": "5"
        }
      ]
    }
  ],
