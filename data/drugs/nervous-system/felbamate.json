        "perKgPerDayMax": 45,
        "dividedDoses": 3
      },
      "refs": [
        {
          "source": "fda-felbatol",
          "section": "Dosage and Administration"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "یا در ۴ دوز. داروهای ضدصرع همزمان ۲۰٪ کم شوند.",
            "en": "Or in 4 doses. Reduce concomitant AEDs by 20%."
          },
          "refs": [
            {
              "source": "fda-felbatol",
              "section": "Dosage and Administration"
            }
          ]
        }
      ]
    }
  ],
  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به فلبامات یا سایر کاربامات‌ها؛ سابقه دیسکرازی خونی یا اختلال کبدی.",
        "en": "Hypersensitivity to felbamate or other carbamates; history of blood dyscrasia or hepatic dysfunction."
      },
      "refs": [
        {
          "source": "fda-felbatol",
          "section": "Contraindications"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: آنمی آپلاستیک (بیش از ۱۰۰ برابر) و نارسایی کبد — فقط در صرع بسیار شدید، با مشاوره خون و رضایت آگاهانه.",
        "en": "Boxed warning: aplastic anaemia (>100-fold) and hepatic failure — only in very severe epilepsy, with haematology consultation and informed consent."
      },
      "refs": [
        {
          "source": "fda-felbatol",
          "section": "Boxed Warning"
        }
      ]
    },
    {
      "text": {
        "fa": "افکار و رفتار خودکشی؛ قطع ناگهانی نه (خطر تشنج و استاتوس).",
        "en": "Suicidal thoughts and behaviour; do not stop abruptly (seizures, status epilepticus)."
      },
      "refs": [
        {
          "source": "fda-felbatol",
          "section": "Warnings"
        }
      ]
    }
  ],
  "renal": [
    {
      "egfrBelow": 60,
      "severity": "warn",
      "text": {
        "fa": "اختلال کلیه: دوز شروع و نگهدارنده نصف شود.",
        "en": "Renal impairment: halve the starting and maintenance doses."
      },
      "refs": [
