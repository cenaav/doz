  "regimens": [
    {
      "id": "adult",
      "disease": "epilepsy",
      "label": {
        "fa": "صرع شدید مقاوم بزرگسال و ۱۴ سال به بالا — شروع ۱۲۰۰ mg/روز در ۳ دوز؛ تا ۳۶۰۰ mg/روز",
        "en": "Severe refractory epilepsy, adults and ≥14 y — start 1200 mg/day in 3 doses; up to 3600 mg/day"
      },
      "population": {
        "minAge": {
          "value": 14,
          "unit": "year"
        }
      },
      "type": "fixed",
      "unit": "mg",
      "dose": {
        "perDose": 400,
        "perDoseMax": 1200,
        "dosesPerDay": 3
      },
      "refs": [
        {
          "source": "fda-felbatol",
          "section": "Dosage and Administration"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "یا در ۴ دوز. افزودنی: داروهای ضدصرع دیگر ۲۰٪ (تا ۳۳٪) کم شوند؛ هفتگی ۱۲۰۰ mg/روز افزایش. فقط وقتی صرع آن‌قدر شدید است که خطر آنمی آپلاستیک پذیرفتنی باشد.",
            "en": "Or in 4 doses. Adjunct: reduce other AEDs by 20% (up to 33%); increase by 1200 mg/day weekly. Only when epilepsy is severe enough that aplastic anaemia risk is acceptable."
          },
          "refs": [
            {
              "source": "fda-felbatol",
              "section": "Dosage and Administration"
            },
            {
              "source": "fda-felbatol",
              "section": "Boxed Warning"
            }
          ]
        }
      ]
    },
    {
      "id": "lgs",
      "disease": "lennox-gastaut",
      "label": {
        "fa": "لنوکس-گاستو کودک ۲ تا ۱۴ سال (افزودنی) — شروع ۱۵ mg/kg/روز در ۳ دوز؛ هفتگی تا ۴۵ mg/kg/روز",
        "en": "Lennox-Gastaut, children 2–14 y (adjunct) — start 15 mg/kg/day in 3 doses; weekly up to 45 mg/kg/day"
      },
      "population": {
        "minAge": {
          "value": 2,
          "unit": "year"
        },
        "maxAge": {
          "value": 14,
          "unit": "year"
        }
      },
      "type": "weightBased",
      "unit": "mg",
      "dose": {
