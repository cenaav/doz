        {
          "source": "fda-felbatol",
          "section": "Pregnancy"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Felbamate has been detected in human milk.",
      "refs": [
        {
          "source": "fda-felbatol",
          "section": "Nursing Mothers"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: فقط در لنوکس-گاستو کودکان ثابت شده؛ سایر کودکان ثابت نشده.",
        "en": "Label: established only for Lennox-Gastaut in children; not established in other children."
      },
      "quote": "The safety and effectiveness of Felbatol in children other than those with Lennox-Gastaut syndrome has not been established.",
      "refs": [
        {
          "source": "fda-felbatol",
          "section": "Pediatric Use"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In general, dosage selection for an elderly patient should be cautious, usually starting at the low end of the dosing range, reflecting the greater frequency of decreased hepatic, renal, or cardiac function, and of concomitant disease or other drug therapy.",
