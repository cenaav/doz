        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Daridorexant is present in human breast milk in low amounts.",
      "refs": [
        {
          "source": "fda-quviviq",
          "section": "8.2"
        }
      ]
    },
