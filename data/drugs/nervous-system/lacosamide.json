      "id": "adult",
      "disease": "epilepsy",
      "label": {
        "fa": "تشنج کانونی (افزودنی) — بزرگسال و کودک ۵۰ kg به بالا: شروع ۵۰ mg دو بار در روز",
        "en": "Partial-onset seizures (adjunctive) — adults and children ≥50 kg: start 50 mg twice daily"
