  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data from postmarketing case reports over decades of clinical use with articaine and epinephrine during pregnancy have not identified any drug-associated risks of major birth defects, miscarriage, or other adverse maternal or fetal outcomes.",
      "refs": [
        {
          "source": "fda-articaine",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of articaine with epinephrine in human milk, the effects on breastfed infants, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-articaine",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of ORABLOC for local, infiltrative, or conductive anesthesia in both simple and complex dental procedures have been established in pediatric patients ages 4 to 16 years old.",
      "refs": [
        {
          "source": "fda-articaine",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In clinical trials, 54 patients between the ages of 65 and 75 years, and 11 patients 75 years and over received another product containing articaine and epinephrine 1:100,000.",
      "refs": [
        {
          "source": "fda-articaine",
          "section": "8.5"
        }
      ]
    }
  }
