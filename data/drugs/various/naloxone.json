        }
      ],
      "notes": [
        {
          "text": {
            "fa": "هر ۲ تا ۳ دقیقه تکرار. اگر پس از ۱۰ mg پاسخی نبود، تشخیص اپیوئید زیر سؤال است. در صورت نبود رگ: عضلانی یا زیرجلدی.",
            "en": "Repeat every 2–3 min. If no response after 10 mg, question the diagnosis. If no IV access: IM or SC."
          },
          "refs": [
            {
              "source": "fda-naloxone",
              "section": "Dosage and Administration"
            }
          ]
        }
      ]
    },
    {
      "id": "child",
      "disease": "opioid-overdose",
      "label": {
        "fa": "اوردوز اپیوئید — کودک: ۰٫۰۱ mg/kg وریدی",
        "en": "Opioid overdose — child: 0.01 mg/kg IV"
      },
      "population": {
        "maxAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "weightBased",
      "unit": "mg",
      "dose": {
        "perKgPerDay": 0.01,
        "dividedDoses": 1
      },
      "refs": [
        {
          "source": "fda-naloxone",
          "section": "Usage in Children"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "اگر پاسخ کافی نبود، دوز بعدی ۰٫۱ mg/kg. در نبود رگ: عضلانی یا زیرجلدی در دوزهای منقسم.",
            "en": "If response is inadequate, a subsequent dose of 0.1 mg/kg. Without IV access: IM or SC in divided doses."
          },
          "refs": [
            {
              "source": "fda-naloxone",
              "section": "Usage in Children"
            }
          ]
        }
      ]
