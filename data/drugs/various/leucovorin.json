  "regimens": [
    {
      "id": "mtx",
      "disease": "methotrexate-toxicity",
      "label": {
        "fa": "نجات پس از متوترکسات با دوز بالا — ۱۵ mg (حدود ۱۰ mg/m²) هر ۶ ساعت، ۱۰ دوز از ۲۴ ساعت پس از شروع متوترکسات",
        "en": "Rescue after high-dose methotrexate — 15 mg (about 10 mg/m²) every 6 h for 10 doses from 24 h after methotrexate start"
      },
      "population": {},
      "type": "fixed",
      "unit": "mg",
      "dose": {
        "perDose": 15,
        "dosesPerDay": 4
      },
      "refs": [
        {
          "source": "fda-leucovorin",
          "section": "Dosage and Administration"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "تنظیم بر اساس کراتینین و سطح متوترکسات (جدول برچسب). هرگز داخل نخاعی. وریدی حداکثر ۱۶۰ mg/دقیقه (کلسیم).",
            "en": "Adjust by creatinine and methotrexate levels (label table). Never intrathecal. IV no faster than 160 mg/min (calcium)."
          },
          "refs": [
            {
              "source": "fda-leucovorin",
              "section": "Dosage and Administration"
            },
            {
              "source": "fda-leucovorin",
              "section": "Warnings"
            }
          ]
        }
      ]
    },
    {
      "id": "crc",
      "disease": "colorectal-cancer",
      "label": {
        "fa": "سرطان کولورکتال پیشرفته — ۲۰۰ mg/m² وریدی آهسته، سپس فلوئورویوراسیل ۳۷۰ mg/m²، روزانه ۵ روز",
        "en": "Advanced colorectal cancer — 200 mg/m² slow IV, then fluorouracil 370 mg/m², daily for 5 days"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "bsa",
      "unit": "mg",
      "dose": {
        "perM2PerDay": 200,
        "dividedDoses": 1
      },
      "refs": [
        {
          "source": "fda-leucovorin",
          "section": "Dosage and Administration"
        }
      ],
      "durationDays": {
        "min": 5,
        "max": 5
      },
      "notes": [
        {
          "text": {
            "fa": "یا ۲۰ mg/m² سپس فلوئورویوراسیل ۴۲۵ mg/m². در یک انفوزیون با فلوئورویوراسیل مخلوط نشود.",
            "en": "Or 20 mg/m² then fluorouracil 425 mg/m². Do not mix with fluorouracil in one infusion."
          },
          "refs": [
            {
              "source": "fda-leucovorin",
              "section": "Dosage and Administration"
            }
          ]
        },
        {
          "text": {
            "fa": "فقط زیر نظر پزشک متخصص انکولوژی؛ پروتکل، فاصله دوره‌ها و تنظیم با تیم درمان.",
            "en": "Only under an oncologist; protocol, cycle interval and adjustment rest with the treating team."
          },
          "refs": [
            {
              "source": "fda-leucovorin",
              "section": "Dosage and Administration"
            }
          ]
        }
      ]
    }
  ],
  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "کم‌خونی پرنیشیوز و سایر کم‌خونی‌های مگالوبلاستیک ناشی از کمبود B12.",
        "en": "Pernicious anaemia and other megaloblastic anaemias from vitamin B12 deficiency."
      },
      "refs": [
        {
          "source": "fda-leucovorin",
          "section": "Contraindications"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "داخل نخاعی کشنده است؛ هرچه زودتر پس از مسمومیت ضدفولات؛ با فلوئورویوراسیل سمیت بیشتر (به‌ویژه سالمند).",
        "en": "Fatal if given intrathecally; give as soon as possible after antifolate overdose; enhances fluorouracil toxicity (especially elderly)."
      },
      "refs": [
        {
          "source": "fda-leucovorin",
          "section": "Warnings"
        }
      ]
    }
  ],
