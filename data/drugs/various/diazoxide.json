  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "هیپوگلیسمی عملکردی؛ حساسیت به دیازوکساید یا تیازیدها.",
        "en": "Functional hypoglycaemia; hypersensitivity to diazoxide or other thiazides."
      },
      "refs": [
        {
          "source": "fda-proglycem",
          "section": "Contraindications"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "احتباس مایع و نارسایی قلب؛ کتواسیدوز و کمای هیپراسمولار؛ با تیازید افزایش قند و اسید اوریک.",
        "en": "Fluid retention and heart failure; ketoacidosis and hyperosmolar coma; thiazides potentiate hyperglycaemia and hyperuricaemia."
      },
      "refs": [
        {
          "source": "fda-proglycem",
