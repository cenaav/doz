      "label": {
        "fa": "هیپوگلیسمی ناشی از هیپرانسولینیسم (بزرگسال و کودک) — شروع ۳ mg/kg/روز در ۳ دوز هر ۸ ساعت؛ حداکثر ۸",
        "en": "Hyperinsulinaemic hypoglycaemia (adults and children) — start 3 mg/kg/day in 3 doses every 8 h; max 8"
      },
      "population": {
        "minAge": {
          "value": 1,
          "unit": "year"
        }
      },
      "type": "weightBased",
      "unit": "mg",
      "dose": {
