        "fa": "شیرخوار و نوزاد — شروع ۸ mg/kg/روز در ۳ دوز هر ۸ ساعت؛ حداکثر ۱۵",
        "en": "Infants and newborns — start 8 mg/kg/day in 3 doses every 8 h; max 15"
      },
      "population": {
        "maxAge": {
          "value": 1,
          "unit": "year"
        }
      },
      "type": "weightBased",
      "unit": "mg",
      "dose": {
