        {
          "source": "fda-daliresp",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There is no information regarding the presence of DALIRESP in human milk, the effects on the breastfed infant, or the effects on milk production.",
