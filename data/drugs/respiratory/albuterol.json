  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are no randomized clinical studies of use of albuterol sulfate during pregnancy.",
      "refs": [
        {
          "source": "fda-ventolin-hfa",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no available data on the presence of albuterol or the components of VENTOLIN HFA in human milk, the effects on the breastfed child, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-ventolin-hfa",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "The safety and effectiveness of VENTOLIN HFA in pediatric patients younger than 4 years have not been established.",
      "refs": [
        {
          "source": "fda-ventolin-hfa",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In general, dose selection for an elderly patient should be cautious, usually starting at the low end of the dosing range, reflecting the greater frequency of decreased hepatic, renal, or cardiac function, and of concomitant disease or other drug therapy.",
      "refs": [
        {
          "source": "fda-ventolin-hfa",
          "section": "8.5"
        }
      ]
    }
  }
