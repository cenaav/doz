  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "درمان اولیه استاتوس آسماتیکوس یا حمله حاد COPD/آسم؛ حساسیت شدید به پروتئین شیر یا فلوتیکازون فوروات/ویلانترول.",
        "en": "Primary treatment of status asthmaticus or acute COPD/asthma episodes; severe milk-protein hypersensitivity or hypersensitivity to fluticasone furoate/vilanterol."
      },
      "refs": [
        {
          "source": "fda-breo",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "رویدادهای جدی آسم با LABA؛ کاندیدیاز دهان؛ پنومونی در COPD؛ سرکوب ایمنی و آدرنال؛ مهارکننده قوی CYP3A4؛ کاهش تراکم استخوان؛ تأثیر بر رشد؛ گلوکوم و آب مروارید.",
        "en": "Serious asthma events with LABA; oral candidiasis; pneumonia in COPD; immunosuppression and adrenal suppression; strong CYP3A4 inhibitors; reduced bone density; effect on growth; glaucoma and cataract."
      },
      "refs": [
        {
          "source": "fda-breo",
          "section": "5"
        }
      ]
    }
  ],
