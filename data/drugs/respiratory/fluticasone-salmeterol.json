  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are insufficient data on the use of ADVAIR DISKUS or individual monoproducts, fluticasone propionate and salmeterol xinafoate, in pregnant women.",
      "refs": [
        {
          "source": "fda-advair",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no available data on the presence of fluticasone propionate or salmeterol in human milk, the effects on the breastfed child, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-advair",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of ADVAIR DISKUS in children with asthma younger than 4 years have not been established.",
      "refs": [
        {
          "source": "fda-advair",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "As with other products containing beta 2 -agonists, special caution should be observed when using ADVAIR DISKUS in geriatric patients who have concomitant cardiovascular disease that could be adversely affected by beta 2 -agonists.",
      "refs": [
        {
          "source": "fda-advair",
          "section": "8.5"
        }
      ]
    }
  }
