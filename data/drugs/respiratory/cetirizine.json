      "notes": [
        {
          "text": {
            "fa": "۲ تا کمتر از ۶ سال: در صورت نیاز تا حداکثر ۵ mg یک‌بار در روز یا ۲٫۵ mg هر ۱۲ ساعت؛ بیش از ۵ mg در ۲۴ ساعت داده نشود.",
            "en": "2 to under 6 years: if needed up to 5 mg once daily or 2.5 mg every 12 h; no more than 5 mg in 24 h."
          },
          "refs": [
            {
              "source": "fda-cetirizine-otc",
              "section": "Directions"
            }
          ]
        },
        {
          "text": {
            "fa": "۶ سال به بالا: ۵ یا ۱۰ mg یک‌بار در روز بسته به شدت علائم؛ حداکثر ۱۰ mg در ۲۴ ساعت. این محاسبه مقدار ۵ mg را نشان می‌دهد.",
            "en": "6 years and over: 5 or 10 mg once daily depending on severity; max 10 mg in 24 h. This calculation shows 5 mg."
          },
          "refs": [
            {
              "source": "fda-cetirizine-otc",
              "section": "Directions"
            }
          ]
        },
        {
          "text": {
            "fa": "۶۵ سال به بالا: ۵ mg یک‌بار در روز، حداکثر ۵ mg در ۲۴ ساعت.",
            "en": "65 years and older: 5 mg once daily; max 5 mg in 24 h."
          },
          "refs": [
            {
              "source": "fda-cetirizine-otc",
              "section": "Directions"
            }
          ]
        },
        {
          "text": {
            "fa": "زیر ۲ سال: برچسب می‌گوید با پزشک مشورت شود؛ دوزی تعریف نشده است.",
            "en": "Under 2 years: label says ask a doctor; no dose defined."
          },
          "refs": [
            {
              "source": "fda-cetirizine-otc",
              "section": "Directions"
            }
          ]
        }
      ]
    }
