  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Therefore, mometasone furoate cream should be used during pregnancy only if the potential benefit justifies the potential risk to the fetus.",
      "refs": [
        {
          "source": "fda-mometasonecream",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Because many drugs are excreted in human milk, caution should be exercised when mometasone furoate cream is administered to a nursing woman.",
      "refs": [
        {
          "source": "fda-mometasonecream",
          "section": "8.3"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
