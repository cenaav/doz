  "regimens": [
    {
      "id": "pso",
      "disease": "psoriasis",
      "label": {
        "fa": "پسوریازیس شدید بزرگسال — ۲۵ تا ۵۰ mg یک بار با وعده اصلی",
        "en": "Severe psoriasis, adults — 25–50 mg once daily with the main meal"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "fixed",
      "unit": "mg",
      "dose": {
        "perDose": 25,
        "perDoseMax": 50,
        "dosesPerDay": 1
      },
      "refs": [
        {
          "source": "fda-acitretin",
          "section": "Dosage and Administration"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "نگهدارنده ۲۵ تا ۵۰ mg بر اساس پاسخ. با فوتوتراپی دوز نور کم شود. حداکثر یک ماه دارو در هر بار تحویل.",
            "en": "Maintenance 25–50 mg by response. Reduce phototherapy dose if combined. Dispense no more than a month at a time."
          },
          "refs": [
            {
              "source": "fda-acitretin",
              "section": "Dosage and Administration"
            }
          ]
        }
      ]
    }
  ],
  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "بارداری یا قصد بارداری حین درمان و تا ۳ سال پس از قطع؛ نارسایی شدید کبد یا کلیه؛ چربی خون بالای مزمن؛ متوترکسات همزمان (هپاتیت)؛ تتراسایکلین‌ها (فشار داخل جمجمه)؛ الکل در زنان (تبدیل به اترتینات).",
        "en": "Pregnancy or intended pregnancy during and for 3 years after; severe hepatic or renal impairment; chronic hyperlipidaemia; concomitant methotrexate (hepatitis); tetracyclines (raised intracranial pressure); alcohol in women (converts to etretinate)."
      },
      "refs": [
        {
          "source": "fda-acitretin",
          "section": "Contraindications"
        },
        {
          "source": "fda-acitretin",
          "section": "Boxed Warning"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: ناهنجاری شدید جنینی — زنان تا ۳ سال پس از قطع پیشگیری مطمئن (دو روش) و الکل ممنوع؛ سمیت کبدی.",
        "en": "Boxed warning: severe birth defects — women need reliable contraception (two methods) and no alcohol for 3 years after stopping; hepatotoxicity."
      },
      "refs": [
        {
          "source": "fda-acitretin",
          "section": "Boxed Warning"
        }
      ]
    }
  ],
