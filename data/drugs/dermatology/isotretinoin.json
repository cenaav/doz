  "populations": {
    "pregnancy": {
      "level": "contraindicated",
      "text": {
        "fa": "برچسب: در بارداری منع مصرف دارد.",
        "en": "Label: contraindicated in pregnancy."
      },
      "quote": "Zenatane is contraindicated in: Pregnancy [see Warnings and Precautions ( 5.1 ) and Use in Specific Populations ( 8.1 )].",
      "refs": [
        {
          "source": "fda-isotretinoin",
          "section": "4"
        }
