    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in nursing infants from isotretinoin, advise patients that breastfeeding is not recommended during treatment with Zenatane, and for at least 8 days after the last dose of Zenatane.",
      "refs": [
        {
          "source": "fda-isotretinoin",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of Zenatane for the treatment of severe recalcitrant nodular acne have been established in non-pregnant pediatric patients 12 years of age and older with multiple inflammatory nodules with a diameter of 5 mm or greater who are unresponsive to conventional treatment, including systemic …",
      "refs": [
        {
          "source": "fda-isotretinoin",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Clinical studies of Zenatane did not include sufficient numbers of patients 65 years of age and older to determine whether they respond differently from younger adult patients.",
      "refs": [
        {
          "source": "fda-isotretinoin",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "… of Zenatane treatment, AND (2) after the patient has used their chosen pregnancy prevention methods (i.e., two forms of contraception or committed to abstinence) for at least 30 days.",
      "refs": [
