  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are insufficient human data to establish whether there is a drug-associated risk with mupirocin ointment in pregnant women.",
      "refs": [
        {
          "source": "fda-mupirocin",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "ok",
      "text": {
        "fa": "برچسب: مواجهه شیرخوار انتظار نمی‌رود.",
        "en": "Label: infant exposure not expected."
      },
      "quote": "However, breastfeeding is not expected to result in exposure of the child to the drug due to the minimal systemic absorption of mupirocin in humans following topical administration of mupirocin ointment [ see Clinical Pharmacology (12.3) ].",
      "refs": [
        {
          "source": "fda-mupirocin",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "The safety and effectiveness of mupirocin ointment have been established in the age range of 2 months to 16 years.",
