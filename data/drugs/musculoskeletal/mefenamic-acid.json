  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Clinical Considerations Fetal/Neonatal Adverse Reactions Premature Closure of Fetal Ductus Arteriosus: Avoid use of NSAIDs in women at about 30 weeks gestation and later in pregnancy, because NSAIDs, including mefenamic acid capsules, can cause premature closure of the fetal ductus arteriosus (see Data) .",
      "refs": [
        {
          "source": "fda-mefenamic",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Mefenamic acid is present in human milk in low amounts and may be transferred to breastfed infants.",
      "refs": [
        {
          "source": "fda-mefenamic",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of mefenamic acid have been established for management of mild to moderate pain in pediatric patients 14 years of age and older.",
      "refs": [
        {
          "source": "fda-mefenamic",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Elderly patients and patients with a prior history of peptic ulcer disease and/or GI bleeding are at greater risk for serious GI events [see Warnings and Precautions ( 5.2 )].",
      "refs": [
        {
          "source": "fda-mefenamic",
          "section": "Boxed Warning"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Infertility Females Based on the mechanism of action, the use of prostaglandin-mediated NSAIDs, including mefenamic acid may delay or prevent rupture of ovarian follicles, which has been associated with reversible infertility in some women.",
      "refs": [
        {
          "source": "fda-mefenamic",
          "section": "8.9"
        }
      ]
    }
