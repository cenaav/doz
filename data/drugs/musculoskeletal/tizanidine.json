  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are no adequate data on the developmental risk associated with use of tizanidine tablets in pregnant women.",
      "refs": [
        {
          "source": "fda-tizanidine",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of tizanidine in human milk, the effects on the breastfed infant, or the effects on human milk production.",
      "refs": [
        {
          "source": "fda-tizanidine",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
