  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "زخم پپتیک یا خونریزی گوارشی فعال؛ آسم، کهیر یا رینیت با آسپرین یا NSAID؛ بارداری و شیردهی؛ نارسایی شدید کبد؛ ClCr زیر ۳۰؛ زیر ۱۶ سال؛ IBD؛ نارسایی قلب NYHA II–IV؛ فشار خون کنترل‌نشده بالای ۱۴۰/۹۰؛ بیماری ایسکمیک قلب، شریان محیطی یا مغزی؛ حساسیت.",
        "en": "Active peptic ulcer or GI bleeding; bronchospasm, rhinitis, polyps, angioedema or urticaria with aspirin/NSAIDs; pregnancy and lactation; severe hepatic dysfunction; CrCl <30; under 16 y; inflammatory bowel disease; NYHA II–IV heart failure; uncontrolled BP >140/90; established ischaemic heart, peripheral arterial or cerebrovascular disease; hypersensitivity."
      },
      "refs": [
        {
          "source": "emc-arcoxia",
          "section": "4.3"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "خطر قلبی‌عروقی با دوز و مدت بیشتر می‌شود؛ کمترین دوز در کوتاه‌ترین مدت. عوارض گوارشی جدی.",
        "en": "Cardiovascular risk rises with dose and duration; lowest dose for the shortest time. Serious GI complications."
      },
      "refs": [
        {
          "source": "emc-arcoxia",
          "section": "4.2"
        },
        {
          "source": "emc-arcoxia",
          "section": "4.4"
        }
      ]
    }
  ],
