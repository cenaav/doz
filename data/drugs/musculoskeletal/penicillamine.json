  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "بارداری (جز ویلسون یا برخی بیماران سیستینوری)؛ شیردهی؛ سابقه آنمی آپلاستیک یا آگرانولوسیتوز با پنی‌سیلامین؛ آرتریت روماتوئید با سابقه یا شواهد نارسایی کلیه.",
        "en": "Pregnancy (except Wilson disease or some cystinuria); breastfeeding; prior penicillamine-related aplastic anaemia or agranulocytosis; rheumatoid arthritis with history or evidence of renal insufficiency."
      },
      "refs": [
        {
          "source": "fda-cuprimine",
          "section": "Contraindications"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "مرگ از آنمی آپلاستیک، آگرانولوسیتوز، ترومبوسیتوپنی، گودپاسچر و میاستنی — آزمایش ادرار و CBC دو بار در هفته در ابتدا.",
        "en": "Fatalities from aplastic anaemia, agranulocytosis, thrombocytopenia, Goodpasture syndrome and myasthenia gravis — urinalysis and CBC twice weekly initially."
      },
      "refs": [
        {
          "source": "fda-cuprimine",
          "section": "Warnings"
        }
      ]
    }
  ],
