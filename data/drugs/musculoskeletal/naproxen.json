  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به دارو؛ سابقه آسم، کهیر یا واکنش آلرژیک پس از آسپیرین یا NSAID؛ هنگام جراحی بای‌پس عروق کرونر (CABG).",
        "en": "Hypersensitivity; history of asthma, urticaria or allergic-type reaction after aspirin or other NSAIDs; in the setting of CABG surgery."
      },
      "refs": [
        {
          "source": "fda-naproxen",
          "section": "4"
        }
      ]
    },
    {
      "id": "boxed",
      "severity": "warn",
      "text": {
        "fa": "هشدار جعبه‌ای: خطر حوادث قلبی‌عروقی ترومبوتیک و خونریزی، زخم و سوراخ‌شدگی گوارشی.",
        "en": "Boxed warning: risk of serious cardiovascular thrombotic events and GI bleeding, ulceration and perforation."
      },
      "refs": [
        {
          "source": "fda-naproxen",
          "section": "Boxed Warning"
        }
      ]
    }
