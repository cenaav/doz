  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Clinical Considerations Fetal/Neonatal Adverse Reactions Premature Closure of Fetal Ductus Arteriosus: Avoid use of NSAIDs in women at about 30 weeks gestation and later in pregnancy, because NSAIDs, including ketorolac tromethamine, can cause premature closure of the fetal ductus arteriosus (see WARNINGS;",
      "refs": [
        {
          "source": "fda-ketorolac",
          "section": "Precautions/Warnings – Pregnancy"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Limited data from one published study that included 10 breastfeeding women 2-6 days postpartum showed low levels of ketorolac in breast milk and were undetectable (less than 5 ng/mL) in 4 of the patients.",
      "refs": [
        {
          "source": "fda-ketorolac",
          "section": "Precautions/Warnings – Nursing Mothers"
        }
      ]
    },
    "pediatric": {
      "level": "avoid",
      "text": {
        "fa": "هشدار جعبه‌ای برچسب درباره کودکان.",
        "en": "Boxed warning in the label about children."
      },
      "quote": "Ketorolac tromethamine is not indicated for use in pediatric patients and it is NOT indicated for minor or chronic painful conditions.",
      "refs": [
        {
          "source": "fda-ketorolac",
          "section": "Boxed Warning"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Elderly patients are at greater risk for serious gastrointestinal events (see WARNINGS ).",
      "refs": [
        {
          "source": "fda-ketorolac",
