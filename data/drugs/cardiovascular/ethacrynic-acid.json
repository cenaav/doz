  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Since animal reproduction studies are not always predictive of human response, EDECRIN should be used during pregnancy only if clearly needed.",
      "refs": [
        {
          "source": "fda-edecrin",
          "section": "Pregnancy"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because many drugs are excreted in human milk and because of the potential for serious adverse reactions in nursing infants from EDECRIN, a decision should be made whether to discontinue nursing or to discontinue the drug, taking into account the importance of the drug to the mother.",
      "refs": [
        {
          "source": "fda-edecrin",
          "section": "Nursing Mothers"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: مصرف خوراکی در کودکان (غیر از شیرخوار) بر اساس تجربه؛ شیرخوار و وریدی در کودکان ثابت نشده.",
        "en": "Label: oral use in children (not infants) supported by empiric use; infants and IV use in children not established."
      },
      "quote": "The information on oral dosing in pediatric patients, other than infants, is supported by evidence from empiric use in this age group.",
      "refs": [
        {
          "source": "fda-edecrin",
          "section": "Pediatric Use"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Because elderly patients are more likely to have decreased renal function, care should be taken in dose selection, and it may be useful to monitor renal function.",
      "refs": [
        {
          "source": "fda-edecrin",
          "section": "Geriatric Use"
        }
      ]
    }
  },
