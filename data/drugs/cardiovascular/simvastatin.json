  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Simvastatin decreases synthesis of cholesterol and possibly other biologically active substances derived from cholesterol; therefore, simvastatin may cause fetal harm when administered to pregnant patients based on the mechanism of action [see CLINICAL PHARMACOLOGY ( 12.1 )] .",
      "refs": [
        {
          "source": "fda-simvastatin",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in a breastfed infant, based on the mechanism of action, advise patients that breastfeeding is not recommended during treatment with simvastatin [see USE IN SPECIFIC POPULATIONS (8.1), CLINICAL PHARMACOLOGY ( 12.1 )].",
      "refs": [
        {
          "source": "fda-simvastatin",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of simvastatin as an adjunct to diet to reduce LDL-C have been established in pediatric patients 10 years of age and older with HeFH.",
      "refs": [
        {
          "source": "fda-simvastatin",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In a clinical study of patients treated with simvastatin 80 mg daily, patients ≥65 years of age had an increased risk of myopathy, including rhabdomyolysis, compared to patients <65 years of age.",
      "refs": [
        {
          "source": "fda-simvastatin",
          "section": "8.5"
        }
      ]
    }
