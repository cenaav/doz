  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Discontinue niacin extended-release when pregnancy is recognized in patients receiving the drug for the treatment of hyperlipidemia.",
      "refs": [
        {
          "source": "fda-niacin-er",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in breastfeeding infants, including hepatotoxicity, advise patients not to breastfeed during treatment with niacin extended-release.",
      "refs": [
        {
          "source": "fda-niacin-er",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان ثابت نشده است.",
        "en": "Label: safety and effectiveness in children have not been established."
      },
      "quote": "Safety and effectiveness of niacin therapy in pediatric patients (≤ 16 years) have not been established.",
      "refs": [
        {
          "source": "fda-niacin-er",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Of 979 patients in clinical studies of niacin extended-release, 21% of the patients were age 65 and over.",
      "refs": [
        {
          "source": "fda-niacin-er",
          "section": "8.5"
        }
      ]
    }
