  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "بیماری فعال کبد یا افزایش بی‌علت ترانس‌آمینازها؛ زخم پپتیک فعال؛ خونریزی شریانی؛ حساسیت.",
        "en": "Active liver disease or unexplained transaminase elevation; active peptic ulcer; arterial bleeding; hypersensitivity."
      },
      "refs": [
        {
          "source": "fda-niacin-er",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "بدون کاهش رویداد قلبی؛ میوپاتی (به‌ویژه با استاتین)؛ آسیب کبد؛ افزایش قند و اسید اوریک؛ گرگرفتگی.",
        "en": "No reduction in cardiovascular events; myopathy (especially with statins); liver injury; raised glucose and uric acid; flushing."
      },
      "refs": [
        {
          "source": "fda-niacin-er",
          "section": "5"
        }
      ]
    }
  ],
