  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Based on mechanism of action and findings in animal studies, spironolactone may affect sex differentiation of the male during embryogenesis (see Data).",
      "refs": [
        {
          "source": "fda-spironolactone",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Spironolactone is not present in breastmilk; however, limited data from a lactating woman at 17 days postpartum reports the presence of the active metabolite, canrenone, in human breast milk in low amounts that are expected to be clinically inconsequential.",
      "refs": [
        {
          "source": "fda-spironolactone",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان ثابت نشده است.",
        "en": "Label: safety and effectiveness in children have not been established."
      },
      "quote": "Safety and effectiveness in pediatric patients have not been established.",
      "refs": [
        {
          "source": "fda-spironolactone",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
