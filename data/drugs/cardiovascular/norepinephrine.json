      "id": "maint",
      "disease": "shock",
      "label": {
        "fa": "نگهدارنده — بزرگسال: معمولاً ۲ تا ۴ mcg/دقیقه",
        "en": "Maintenance — adult: usually 2–4 mcg/min"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "infusion",
      "unit": "mcg",
      "dose": {
