  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are insufficient data on ezetimibe use in pregnant women to evaluate for a drug-associated risk of major birth defects, miscarriage or adverse maternal or fetal outcomes.",
      "refs": [
        {
          "source": "fda-ezetimibe",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There is no information about the presence of ezetimibe in human milk.",
      "refs": [
        {
          "source": "fda-ezetimibe",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of ezetimibe in combination with a statin as an adjunct to diet to reduce LDL-C have been established in pediatric patients 10 years of age and older with HeFH.",
      "refs": [
        {
          "source": "fda-ezetimibe",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "ok",
      "text": {
