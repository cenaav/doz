          "value": 18,
          "unit": "year"
        }
      },
      "type": "titration",
      "unit": "mg",
      "dose": {
        "dividedDoses": 1,
        "titration": {
          "start": 5,
          "incrementEveryDays": 14,
          "max": 10
        }
      },
