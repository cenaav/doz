  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data from published observational studies have not demonstrated an association of adverse developmental outcomes with maternal use of metoprolol during pregnancy ( see Data).",
