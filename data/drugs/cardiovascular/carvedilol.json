  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data regarding use of carvedilol in pregnant women are insufficient to determine whether there are drug-associated risks of adverse developmental outcomes.",
      "refs": [
        {
          "source": "fda-carvedilol",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of carvedilol in human milk, the effects on the breastfed infant, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-carvedilol",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "Effectiveness of carvedilol tablets in patients younger than 18 years has not been established.",
      "refs": [
        {
          "source": "fda-carvedilol",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "ok",
      "text": {
        "fa": "برچسب: در سالمندان تفاوت یا تنظیم دوز خاصی ذکر نشده.",
        "en": "Label: no specific difference or dose adjustment stated for older adults."
      },
      "quote": "With the exception of dizziness in hypertensive subjects (incidence 8.8% in the elderly versus 6% in younger subjects), no overall differences in the safety or effectiveness (see Figure 2 and 4) were observed between the older subjects and younger subjects in each of these populations.",
      "refs": [
        {
          "source": "fda-carvedilol",
          "section": "8.5"
        }
      ]
    }
  }
