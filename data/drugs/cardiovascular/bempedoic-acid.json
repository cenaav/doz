  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "NEXLETOL decreases cholesterol synthesis and possibly the synthesis of other biologically active substances derived from cholesterol; therefore, NEXLETOL may cause fetal harm when administered to pregnant women based on the mechanism of action [see Clinical Pharmacology (12.1) ] .",
