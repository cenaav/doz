    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "There are no available data on the presence of irbesartan in human milk, effects on milk production, or the breastfed infant.",
      "refs": [
        {
          "source": "fda-irbesartan",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Irbesartan, in a study at a dose of up to 4.5 mg/kg/day, once daily, did not appear to lower blood pressure effectively in pediatric patients ages 6 to 16 years.",
      "refs": [
        {
          "source": "fda-irbesartan",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Of 4925 subjects receiving irbesartan tablets in controlled clinical studies of hypertension, 911 (18.5%) were 65 years and over, while 150 (3.0%) were 75 years and over.",
      "refs": [
        {
          "source": "fda-irbesartan",
