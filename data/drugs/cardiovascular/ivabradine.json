  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Based on findings in animals, Corlanor may cause fetal harm when administered to a pregnant woman.",
      "refs": [
        {
          "source": "fda-corlanor",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential risk to breastfed infants from exposure to Corlanor, breastfeeding is not recommended.",
      "refs": [
        {
          "source": "fda-corlanor",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of Corlanor have been established in pediatric patients (age 6 months to less than 18 years old) and are supported by pharmacokinetic and pharmacodynamic trials and evidence from adequate and well-controlled trials of Corlanor in adult patients.",
      "refs": [
        {
          "source": "fda-corlanor",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "No pharmacokinetic differences have been observed in elderly (≥ 65 years) or very elderly (≥ 75 years) patients compared to the overall population.",
      "refs": [
        {
          "source": "fda-corlanor",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
