      "refs": [
        {
          "source": "fda-labetalol-inj",
          "section": "Dosage and Administration — Repeated Intravenous Injection"
        }
      ],
      "allowedFormulations": [
        "inj-5"
      ],
      "notes": [
        {
          "text": {
            "fa": "بیمار خوابیده؛ فشار پیش از تزریق و ۵ و ۱۰ دقیقه بعد. تزریق‌های بعدی ۴۰ یا ۸۰ mg هر ۱۰ دقیقه تا فشار مطلوب یا مجموع ۳۰۰ mg. جایگزین: انفوزیون آهسته ۱ mg/mL.",
            "en": "Supine; BP before and 5 and 10 min after. Further 40 or 80 mg every 10 min until target BP or a total of 300 mg. Alternative: slow infusion of 1 mg/mL."
          },
          "refs": [
            {
              "source": "fda-labetalol-inj",
              "section": "Dosage and Administration — Repeated Intravenous Injection"
            },
            {
              "source": "fda-labetalol-inj",
              "section": "Dosage and Administration — Slow Continuous Infusion"
            }
          ]
        }
      ]
    }
  ],
  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "آسم؛ نارسایی آشکار قلب؛ بلوک بیش از درجه ۱؛ شوک کاردیوژنیک؛ برادی‌کاردی شدید؛ افت فشار طولانی.",
        "en": "Bronchial asthma; overt heart failure; greater than first-degree block; cardiogenic shock; severe bradycardia; prolonged hypotension."
      },
      "refs": [
        {
          "source": "fda-labetalol",
          "section": "Contraindications"
        }
      ]
    },
    {
      "id": "inj-ci",
      "severity": "block",
      "text": {
        "fa": "تزریقی: آسم، نارسایی آشکار قلب، بلوک بالاتر از درجه ۱، شوک کاردیوژنیک، برادی‌کاردی شدید، افت فشار شدید طولانی.",
        "en": "Injection: asthma, overt heart failure, heart block above first degree, cardiogenic shock, severe bradycardia, severe prolonged hypotension."
      },
      "refs": [
        {
          "source": "fda-labetalol-inj",
          "section": "Contraindications"
        }
      ]
    }
