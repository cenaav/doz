      "id": "iv",
      "disease": "hypertensive-emergency",
      "label": {
        "fa": "فشار خون شدید — ۲۰ mg وریدی آهسته در ۲ دقیقه، سپس ۴۰ تا ۸۰ mg هر ۱۰ دقیقه",
        "en": "Severe hypertension — 20 mg slow IV over 2 min, then 40–80 mg every 10 min"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "fixed",
      "unit": "mg",
      "dose": {
        "perDose": 20,
        "dosesPerDay": 1
