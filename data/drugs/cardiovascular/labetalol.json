      ],
      "notes": [
        {
          "text": {
            "fa": "هر ۲ تا ۳ روز ۱۰۰ mg دو بار افزایش؛ نگهدارنده معمول ۲۰۰ تا ۴۰۰ mg دو بار در روز.",
            "en": "Increase by 100 mg twice daily every 2–3 days; usual maintenance 200–400 mg twice daily."
          },
          "refs": [
