  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Rosuvastatin calcium decreases synthesis of cholesterol and possibly other biologically active substances derived from cholesterol; therefore, rosuvastatin calcium may cause fetal harm when administered to pregnant patients based on the mechanism of action [ see Clinical Pharmacology (12.1) ].",
      "refs": [
        {
          "source": "fda-rosuvastatin",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in a breastfed infant, based on the mechanism of action, advise patients that breastfeeding is not recommended during treatment with rosuvastatin calcium [ see Use in Specific Populations (8.1) and Clinical Pharmacology (12.1) ].",
      "refs": [
        {
          "source": "fda-rosuvastatin",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of rosuvastatin calcium as an adjunct to diet to reduce LDL-C have been established in pediatric patients 8 years of age and older with HeFH.",
      "refs": [
        {
          "source": "fda-rosuvastatin",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Dose selection for an elderly patient should be cautious, recognizing the greater frequency of decreased hepatic, renal, or cardiac function, and of concomitant disease or other drug therapy and the higher risk of myopathy.",
      "refs": [
        {
          "source": "fda-rosuvastatin",
          "section": "8.5"
        }
      ]
    }
  },
