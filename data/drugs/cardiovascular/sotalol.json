  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Both the untreated underlying condition in pregnancy and the use of sotalol in pregnancy cause adverse outcomes to the mother and fetus/neonate (see Clinical Considerations) .",
      "refs": [
        {
          "source": "fda-sotalol",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential serious adverse reactions to the breastfed child and the high level of sotalol in breast milk, advise women not to breastfeed while on treatment with sotalol hydrochloride .",
      "refs": [
        {
          "source": "fda-sotalol",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان ثابت نشده است.",
        "en": "Label: safety and effectiveness in children have not been established."
      },
      "quote": "The safety and effectiveness of sotalol in children have not been established.",
      "refs": [
        {
          "source": "fda-sotalol",
          "section": "8.4"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
