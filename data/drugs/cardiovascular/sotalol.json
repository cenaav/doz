  "regimens": [
    {
      "id": "vt",
      "disease": "ventricular-arrhythmia",
      "label": {
        "fa": "آریتمی بطنی تهدیدکننده حیات — شروع ۸۰ mg دو بار در روز؛ معمولاً ۱۶۰ تا ۳۲۰ mg/روز",
        "en": "Life-threatening ventricular arrhythmia — start 80 mg twice daily; usually 160–320 mg/day"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "titration",
      "unit": "mg",
      "dose": {
        "dividedDoses": 2,
        "titration": {
          "start": 160,
          "increment": 80,
          "incrementEveryDays": 3,
          "targetMin": 160,
          "targetMax": 320,
          "max": 640
        }
      },
      "refs": [
        {
          "source": "fda-sotalol",
          "section": "2.2"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "شروع در مرکز با پایش ECG دست‌کم ۳ روز. افزایش ۸۰ mg/روز هر ۳ روز فقط اگر QTc زیر ۵۰۰ ms.",
            "en": "Start in a facility with ECG monitoring for at least 3 days. Increase by 80 mg/day every 3 days only if QTc <500 ms."
          },
          "refs": [
            {
              "source": "fda-sotalol",
              "section": "2.1"
            },
            {
              "source": "fda-sotalol",
              "section": "2.2"
            }
          ]
        },
        {
          "text": {
            "fa": "در آریتمی مقاوم تا ۴۸۰ تا ۶۴۰ mg/روز به کار رفته است.",
            "en": "Up to 480–640 mg/day has been used for refractory arrhythmias."
          },
          "refs": [
            {
              "source": "fda-sotalol",
              "section": "2.2"
            }
          ]
        }
      ]
    },
    {
      "id": "af",
      "disease": "atrial-fibrillation",
      "label": {
        "fa": "پیشگیری از عود AF/فلوتر — شروع ۸۰ mg دو بار در روز؛ اغلب ۱۲۰ mg دو بار",
        "en": "Maintenance of sinus rhythm in AF/AFL — start 80 mg twice daily; most respond to 120 mg twice daily"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "fixed",
      "unit": "mg",
      "dose": {
        "perDose": 80,
        "perDoseMax": 120,
        "dosesPerDay": 2
      },
      "refs": [
        {
          "source": "fda-sotalol",
          "section": "2.3"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "شروع در مرکز با پایش ECG دست‌کم ۳ روز. افزایش ۸۰ mg/روز هر ۳ روز فقط اگر QTc زیر ۵۰۰ ms.",
            "en": "Start in a facility with ECG monitoring for at least 3 days. Increase by 80 mg/day every 3 days only if QTc <500 ms."
          },
          "refs": [
            {
              "source": "fda-sotalol",
              "section": "2.1"
            },
            {
              "source": "fda-sotalol",
              "section": "2.2"
            }
          ]
        },
        {
          "text": {
            "fa": "QTc بالای ۴۵۰ ms در شروع: منع مصرف.",
            "en": "Contraindicated if baseline QTc >450 ms."
          },
          "refs": [
            {
              "source": "fda-sotalol",
              "section": "2.3"
            }
          ]
        }
      ]
    }
  ],
  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "برادی‌کاردی سینوسی، سندرم سینوس بیمار یا بلوک AV درجه ۲ و ۳ بدون پیس‌میکر؛ QT طولانی؛ شوک کاردیوژنیک یا نارسایی جبران‌نشده؛ پتاسیم زیر ۴؛ آسم برونشیال؛ حساسیت.",
        "en": "Sinus bradycardia, sick sinus syndrome or 2nd/3rd-degree AV block without a pacemaker; long QT; cardiogenic shock or decompensated heart failure; serum potassium <4 mEq/L; bronchial asthma; hypersensitivity."
      },
      "refs": [
        {
          "source": "fda-sotalol",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: آریتمی کشنده (تورساد). شروع و افزایش دوز در مرکز با پایش ECG و محاسبه کلیرانس کراتینین.",
        "en": "Boxed warning: life-threatening proarrhythmia (torsade). Initiate and up-titrate in a facility with ECG monitoring and creatinine clearance calculation."
      },
      "refs": [
        {
          "source": "fda-sotalol",
          "section": "Boxed Warning"
        }
      ]
    }
  ],
  "renal": [
    {
      "egfrBelow": 60,
      "severity": "warn",
      "text": {
        "fa": "فاصله دوز: ClCr ۳۰ تا ۵۹ هر ۲۴ ساعت؛ ۱۰ تا ۲۹ هر ۳۶ تا ۴۸ ساعت؛ زیر ۱۰ فردی. افزایش دوز پس از دست‌کم ۵ دوز.",
        "en": "Interval: CrCl 30–59 every 24 h; 10–29 every 36–48 h; <10 individualised. Escalate after at least 5 doses."
      },
      "refs": [
        {
          "source": "fda-sotalol",
          "section": "2.5"
        }
      ]
    }
  ],
