  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "When pregnancy is detected, discontinue ENTRESTO as soon as possible (5.1) Drugs that act directly on the renin-angiotensin system can cause injury and death to the developing fetus (5.1) WARNING: FETAL TOXICITY See full prescribing information for complete boxed warning.",
      "refs": [
        {
          "source": "fda-entresto",
          "section": "Boxed Warning"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in breastfed infants from exposure to sacubitril/valsartan, advise a nursing woman that breastfeeding is not recommended during treatment with ENTRESTO.",
      "refs": [
        {
          "source": "fda-entresto",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of ENTRESTO have been established for the treatment of heart failure in pediatric patients 1 year to less than 18 years.",
      "refs": [
        {
          "source": "fda-entresto",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "ok",
      "text": {
        "fa": "برچسب: در سالمندان تفاوت یا تنظیم دوز خاصی ذکر نشده.",
        "en": "Label: no specific difference or dose adjustment stated for older adults."
      },
      "quote": "No overall differences in safety or effectiveness of ENTRESTO have been observed between patients 65 years of age and older and younger adult patients in either study.",
      "refs": [
        {
          "source": "fda-entresto",
          "section": "8.5"
        }
      ]
    }
