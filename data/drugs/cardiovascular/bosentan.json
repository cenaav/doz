  "populations": {
    "pregnancy": {
      "level": "contraindicated",
      "text": {
        "fa": "برچسب: در بارداری منع مصرف دارد.",
        "en": "Label: contraindicated in pregnancy."
      },
      "quote": "Hypersensitivity ( 4.4 ). 4.1 Pregnancy Use of TRACLEER is contraindicated in females who are pregnant [see Boxed Warning , Dosage and Administration (2.1) , Warnings and Precautions (5.3) , Use in Specific Populations (8.1) ] . 4.2 Use with Cyclosporine A Co-administration of cyclosporine A and bosentan resulted in …",
      "refs": [
        {
          "source": "fda-tracleer",
          "section": "4"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions, such as fluid retention and hepatotoxicity, in breastfed infants from TRACLEER, advise women not to breastfeed during treatment with TRACLEER.",
      "refs": [
        {
          "source": "fda-tracleer",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The efficacy of TRACLEER in patients <18 years is supported by data from an uncontrolled trial in which 19 pediatric patients were treated with TRACLEER.",
      "refs": [
        {
          "source": "fda-tracleer",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Clinical studies of TRACLEER did not include sufficient numbers of subjects aged 65 and older to determine whether they respond differently from younger subjects.",
      "refs": [
        {
          "source": "fda-tracleer",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Drug interaction studies show that bosentan reduces serum levels of the estrogen and progestin in oral contraceptives.",
      "refs": [
        {
          "source": "fda-tracleer",
          "section": "8.3"
        }
      ]
    }
  }
