  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به فلوکونازول؛ همراه داروهای طولانی‌کننده QT که با CYP3A4 متابولیزه می‌شوند (اریترومایسین، پیموزاید، کینیدین).",
        "en": "Hypersensitivity to fluconazole; with QT-prolonging CYP3A4 substrates (erythromycin, pimozide, quinidine)."
      },
      "refs": [
        {
          "source": "fda-diflucan",
          "section": "Contraindications"
        }
      ]
