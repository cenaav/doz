  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary The limited available data on Dabigatran Etexilate Capsules use in pregnant women are insufficient to determine drug-associated risks for adverse developmental outcomes.",
      "refs": [
        {
          "source": "fda-dabigatran",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Breastfeeding is not recommended during treatment with Dabigatran Etexilate Capsules.",
      "refs": [
        {
          "source": "fda-dabigatran",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of Dabigatran Etexilate Capsules for the treatment and the reduction in risk of recurrence of venous thromboembolism have been established in pediatric patients 8 to less than 18 years of age.",
      "refs": [
        {
          "source": "fda-dabigatran",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "The risk of stroke and bleeding increases with age, but the risk-benefit profile is favorable in all age groups [see Warnings and Precautions (5), Adverse Reactions (6.1), and Clinical Studies (14.1)] .",
