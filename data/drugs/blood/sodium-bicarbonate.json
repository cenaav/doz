  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data from published literature over decades of use have not identified a drug associated risk of major birth defects, miscarriage or other adverse maternal or fetal outcomes.",
      "refs": [
        {
          "source": "fda-bicarbonate",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of sodium bicarbonate in either human or animal milk, the effects on the breast-fed infant or the effects on milk production following administration of sodium bicarbonate injection.",
      "refs": [
        {
          "source": "fda-bicarbonate",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Sodium bicarbonate injection is indicated in pediatric patients: • To raise plasma pH in pediatric patients with clinically significant metabolic acidosis • To alkalinize the urine in drug poisoning in cases in which urinary drug elimination is enhanced by urinary alkalinization Rapid injection of sodium bicarbonate …",
      "refs": [
        {
          "source": "fda-bicarbonate",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Clinical studies of sodium bicarbonate injection did not include sufficient numbers of subjects aged 65 and over to determine whether they respond differently from younger subjects.",
      "refs": [
        {
          "source": "fda-bicarbonate",
