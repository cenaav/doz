    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are no available data on HEMLIBRA use in pregnant women to inform a drug-associated risk of major birth defects and miscarriage.",
      "refs": [
        {
          "source": "fda-hemlibra",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There is no information regarding the presence of emicizumab-kxwh in human milk, the effects on the breastfed child, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-hemlibra",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and efficacy of HEMLIBRA have been established in pediatric patients.",
      "refs": [
        {
          "source": "fda-hemlibra",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Clinical studies of HEMLIBRA did not include a sufficient number of patients aged 65 and over to determine whether they respond differently from younger patients.",
      "refs": [
        {
          "source": "fda-hemlibra",
          "section": "8.5"
        }
