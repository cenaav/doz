  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به مانیتول؛ آنوری؛ کمبود حجم شدید؛ احتقان یا ادم شدید ریه؛ خونریزی فعال داخل جمجمه (جز حین کرانیوتومی).",
        "en": "Hypersensitivity to mannitol; anuria; severe hypovolaemia; severe pulmonary congestion or oedema; active intracranial bleeding (except during craniotomy)."
      },
      "refs": [
        {
          "source": "fda-osmitrol",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "نارسایی کلیه؛ سمیت CNS؛ اختلال آب و الکترولیت و هیپراسمولاریته؛ واکنش محل انفوزیون.",
        "en": "Renal failure; CNS toxicity; fluid/electrolyte imbalance and hyperosmolarity; infusion-site reactions."
      },
