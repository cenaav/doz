  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Based on findings from animal reproduction studies, Nplate may cause fetal harm when administered to a pregnant woman.",
      "refs": [
        {
          "source": "fda-nplate",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Due to the potential for serious adverse reactions in a breastfed child from Nplate, advise women not to breastfeed during treatment with Nplate.",
      "refs": [
        {
          "source": "fda-nplate",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Safety and effectiveness of Nplate have been established in pediatric patients age 1 year and older with ITP for at least 6 months evaluated in two randomized, placebo-controlled studies.",
      "refs": [
        {
          "source": "fda-nplate",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
