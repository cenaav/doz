  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "سابقه HIT؛ حساسیت به هپارین یا فرآورده خوکی؛ وقتی پایش انعقادی ممکن نیست (دوز کامل)؛ خونریزی کنترل‌نشده.",
        "en": "History of HIT; hypersensitivity to heparin or pork products; full-dose use where coagulation tests cannot be done; uncontrolled bleeding."
      },
      "refs": [
        {
          "source": "fda-heparin",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
