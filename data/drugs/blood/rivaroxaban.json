  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary The limited available data on XARELTO in pregnant women are insufficient to inform a drug-associated risk of adverse developmental outcomes.",
      "refs": [
        {
          "source": "fda-xarelto",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Rivaroxaban has been detected in human milk.",
      "refs": [
        {
          "source": "fda-xarelto",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان ثابت نشده است.",
        "en": "Label: safety and effectiveness in children have not been established."
      },
      "quote": "Therefore, XARELTO 2.5 mg tablets are not recommended for use in pediatric patients.",
      "refs": [
        {
          "source": "fda-xarelto",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Of the total number of adult patients in clinical trials for the approved indications of XARELTO (N=64,943 patients), 64 percent were 65 years and over, with 27 percent 75 years and over.",
      "refs": [
        {
          "source": "fda-xarelto",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Females of reproductive potential requiring anticoagulation should discuss pregnancy planning with their physician.",
      "refs": [
        {
          "source": "fda-xarelto",
          "section": "8.3"
        }
      ]
    }
