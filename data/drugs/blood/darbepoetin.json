  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "فشار خون کنترل‌نشده؛ آپلازی خالص گلبول قرمز پس از ESA؛ واکنش آلرژیک جدی.",
        "en": "Uncontrolled hypertension; pure red cell aplasia after ESA therapy; serious allergic reactions."
      },
      "refs": [
        {
          "source": "fda-aranesp",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: افزایش مرگ، MI، سکته، ترومبوز و رشد تومور؛ در سرطان فقط کم‌خونی ناشی از شیمی‌درمانی میلوساپرسیو، نه درمان علاج‌بخش. فشار خون؛ تشنج.",
        "en": "Boxed warning: increased death, MI, stroke, thrombosis and tumour progression; in cancer only for myelosuppressive-chemotherapy anaemia, not curative intent. Hypertension; seizures."
      },
      "refs": [
        {
          "source": "fda-aranesp",
