  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary The limited available data on Aranesp use in pregnant women are insufficient to determine a drug-associated risk of major birth defects or miscarriage.",
      "refs": [
        {
          "source": "fda-aranesp",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There is no information regarding the presence of Aranesp in human milk, the effects on the breastfed child, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-aranesp",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Pediatric Patients with CKD The safety and effectiveness of Aranesp in pediatric patients with CKD receiving and not receiving dialysis have been established in the age groups 1 month to 16 years old.",
      "refs": [
        {
          "source": "fda-aranesp",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Of the 1801 patients with CKD in clinical studies of Aranesp, 44% were age 65 and over, while 17% were age 75 and over.",
      "refs": [
        {
          "source": "fda-aranesp",
          "section": "8.5"
        }
      ]
    }
