    },
    {
      "id": "eclampsia",
      "disease": "eclampsia",
      "label": {
        "fa": "پره‌اکلامپسی شدید / اکلامپسی — طبق پروتکل برچسب",
        "en": "Severe pre-eclampsia / eclampsia — per label protocol"
      },
      "population": {},
      "type": "notCalculated",
      "unit": "mg",
      "dose": {
        "reason": {
          "fa": "دوز اولیه کل ۱۰ تا ۱۴ گرم: ۴ تا ۵ گرم وریدی + تا ۱۰ گرم عضلانی (۵ گرم در هر باسن)، سپس ۴ تا ۵ گرم عضلانی هر ۴ ساعت یا ۱ تا ۲ گرم در ساعت انفوزیون؛ حداکثر ۳۰ تا ۴۰ گرم در ۲۴ ساعت. رفلکس زانو و تنفس پایش شود.",
          "en": "Total initial dose 10–14 g: 4–5 g IV + up to 10 g IM (5 g each buttock), then 4–5 g IM every 4 h or 1–2 g/h infusion; do not exceed 30–40 g in 24 h. Monitor patellar reflex and respiration."
        }
      },
      "refs": [
        {
          "source": "fda-magsulf",
