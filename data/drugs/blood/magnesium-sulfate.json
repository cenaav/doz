      ],
      "durationDays": {
        "min": 1,
        "max": 1
      },
      "notes": [
        {
          "text": {
            "fa": "۲ mL از محلول ۵۰٪. شدید: تا ۲۵۰ mg/kg عضلانی در ۴ ساعت، یا ۵ گرم در یک لیتر سرم طی ۳ ساعت. در کودکان پیش از عضلانی به ۲۰٪ یا کمتر رقیق شود.",
            "en": "2 mL of the 50% solution. Severe: up to 250 mg/kg IM within 4 h, or 5 g in 1 L over 3 h. In children dilute to ≤20% before IM."
          },
          "refs": [
            {
              "source": "fda-magsulf",
              "section": "Dosage — In Magnesium Deficiency"
            },
            {
              "source": "fda-magsulf",
              "section": "Dosage and Administration"
            }
          ]
        }
