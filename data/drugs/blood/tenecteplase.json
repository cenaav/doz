  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are risks to the mother and fetus from acute ST elevation myocardial infarction and acute ischemic stroke, which are medical emergencies in pregnancy and can be fatal if left untreated (see Clinical Considerations ).",
      "refs": [
        {
          "source": "fda-tnkase",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of tenecteplase in either human or animal milk, the effects on the breastfed infant, or the effect on milk production.",
      "refs": [
        {
          "source": "fda-tnkase",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان ثابت نشده است.",
        "en": "Label: safety and effectiveness in children have not been established."
      },
      "quote": "The safety and effectiveness of TNKase in pediatric patients have not been established.",
      "refs": [
        {
          "source": "fda-tnkase",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Of the total number of TNKase-treated patients within 0-3 hours in Trial 1 for acute ischemic stroke (AIS), 426 (72%) were 65 years of age and older, and 290 (49%) were 75 years of age and older [see Clinical Studies (14.1) ].",
      "refs": [
        {
