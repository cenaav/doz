  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "خونریزی داخلی فعال؛ جراحی یا ترومای داخل جمجمه یا نخاع در ۲ ماه اخیر؛ اختلال خونریزی‌دهنده؛ فشار خون شدید کنترل‌نشده؛ ضایعه داخل جمجمه (تومور، AVM، آنوریسم). سکته: خونریزی فعال داخل جمجمه. STEMI: سابقه خونریزی مغزی.",
        "en": "Active internal bleeding; intracranial or intraspinal surgery or trauma within 2 months; bleeding diathesis; severe uncontrolled hypertension; intracranial lesion (neoplasm, AVM, aneurysm). Stroke: active intracranial haemorrhage. STEMI: history of intracranial haemorrhage."
      },
      "refs": [
        {
          "source": "fda-tnkase",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "خونریزی (از جمله داخل مغز)؛ آمبولی کلسترول؛ آریتمی ریپرفیوژن.",
        "en": "Bleeding (including intracranial); cholesterol embolisation; reperfusion arrhythmias."
      },
      "refs": [
        {
          "source": "fda-tnkase",
          "section": "5"
        }
      ]
    }
