  "contraindications": [
    {
      "id": "under-6-months",
      "severity": "block",
      "rule": {
        "maxAge": {
          "value": 6,
          "unit": "month"
        }
      },
      "text": {
        "fa": "بی‌خطری و اثربخشی زیر ۶ ماه ثابت نشده است.",
        "en": "Safety and effectiveness below 6 months of age have not been established."
      },
      "refs": [
        {
          "source": "fda-ibuprofen-rx",
          "section": "Pediatric Use"
        }
      ]
    },
    {
      "id": "nsaid-hypersensitivity",
      "severity": "block",
      "text": {
        "fa": "حساسیت به ایبوپروفن؛ سابقه آسم، کهیر یا واکنش آلرژیک پس از آسپرین یا NSAID.",
        "en": "Hypersensitivity to ibuprofen; asthma, urticaria or allergic-type reactions after aspirin or other NSAIDs."
      },
      "refs": [
        {
          "source": "fda-ibuprofen-rx",
          "section": "Contraindications"
        }
      ]
    },
    {
      "id": "cabg",
      "severity": "block",
      "text": {
        "fa": "در شرایط جراحی بای‌پس عروق کرونر (CABG).",
        "en": "In the setting of coronary artery bypass graft (CABG) surgery."
      },
      "refs": [
        {
          "source": "fda-ibuprofen-rx",
          "section": "Contraindications"
        }
      ]
