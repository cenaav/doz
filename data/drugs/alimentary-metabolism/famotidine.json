  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data with H 2 -receptor antagonists, including famotidine, in pregnant women are insufficient to establish a drug-associated risk of major birth defects, miscarriage or adverse maternal or fetal outcomes.",
      "refs": [
        {
          "source": "fda-famotidine-susp",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are limited data available on the presence of famotidine in human breast milk.",
      "refs": [
        {
          "source": "fda-famotidine-susp",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "The safety and effectiveness of famotidine for oral suspension for the treatment of peptic ulcer disease in pediatric patients less than 1 year of age have not been established.",
      "refs": [
        {
          "source": "fda-famotidine-susp",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In postmarketing experience, CNS adverse reactions have been reported in elderly patients with and without renal impairment receiving famotidine [see Warnings and Precautions (5.1) ] .",
      "refs": [
        {
          "source": "fda-famotidine-susp",
          "section": "8.5"
        }
      ]
