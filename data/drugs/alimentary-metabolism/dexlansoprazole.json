  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به اجزای فرآورده (آنافیلاکسی، نفریت بینابینی)؛ فرآورده‌های حاوی ریلپیویرین.",
