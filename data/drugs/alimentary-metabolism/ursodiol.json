  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Reproduction studies have been performed in rats and rabbits with ursodiol doses up to 200-fold the therapeutic dose and have revealed no evidence of impaired fertility or harm to the fetus at doses of 20- to 100-fold the human dose in rats and at 5-fold the human dose (highest dose tested) in rabbits.",
      "refs": [
        {
          "source": "fda-ursodiol",
          "section": "Pregnancy"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Because many drugs are excreted in human milk, caution should be exercised when ursodiol is administered to a nursing mother.",
      "refs": [
        {
          "source": "fda-ursodiol",
          "section": "Nursing Mothers"
        }
      ]
    },
