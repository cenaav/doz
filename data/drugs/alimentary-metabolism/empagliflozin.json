  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Based on animal data showing adverse renal effects, JARDIANCE is not recommended during the second and third trimesters of pregnancy.",
      "refs": [
        {
          "source": "fda-jardiance",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There is limited information regarding the presence of JARDIANCE in human milk, the effects of JARDIANCE on the breastfed infant or the effects on milk production.",
      "refs": [
        {
          "source": "fda-jardiance",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "The safety and effectiveness of JARDIANCE have not been established in pediatric patients less than 10 years of age as an adjunct to diet and exercise to improve glycemic control in type 2 diabetes mellitus.",
      "refs": [
        {
          "source": "fda-jardiance",
          "section": "8.4"
        }
      ]
    },
