  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary The limited available data with RELISTOR in pregnant women are not sufficient to inform a drug-associated risk for major birth defects and miscarriages.",
      "refs": [
        {
          "source": "fda-relistor",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions, including opioid withdrawal, in breastfed infants, advise women that breastfeeding is not recommended during treatment with RELISTOR.",
      "refs": [
        {
          "source": "fda-relistor",
          "section": "8.2"
        }
      ]
    },
