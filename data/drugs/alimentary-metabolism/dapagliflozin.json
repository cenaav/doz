  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Based on animal data showing adverse renal effects, FARXIGA is not recommended during the second and third trimesters of pregnancy.",
      "refs": [
        {
          "source": "fda-farxiga",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There is no information regarding the presence of dapagliflozin in human milk, the effects on the breastfed infant, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-farxiga",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "The safety and effectiveness of FARXIGA for glycemic control in type 2 diabetes mellitus have not been established in pediatric patients less than 10 years of age.",
      "refs": [
        {
          "source": "fda-farxiga",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In patients ≥65 years of age, a higher proportion of patients treated with FARXIGA for glycemic control had adverse reactions of hypotension [see Warnings and Precautions (5.2) and Adverse Reactions (6.1) ] .",
      "refs": [
        {
          "source": "fda-farxiga",
          "section": "8.5"
        }
      ]
    }
  }
