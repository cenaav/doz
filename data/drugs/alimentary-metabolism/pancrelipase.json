  "populations": {
    "pregnancy": {
      "level": "ok",
      "text": {
        "fa": "برچسب: جذب سیستمیک ناچیز؛ مواجهه جنین انتظار نمی‌رود.",
        "en": "Label: minimal systemic absorption; fetal exposure not expected."
      },
      "quote": "Pancrelipase is minimally absorbed systematically; therefore, maternal use is not expected to result in fetal exposure to the drug.",
      "refs": [
        {
          "source": "fda-creon",
          "section": "8.1"
        }
