  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Following oral administration, concentrations of lubiprostone in plasma are below the level of quantitation; however, one of the metabolites, M3, has measurable systemic concentrations [see Clinical Pharmacology (12.3) ] .",
      "refs": [
        {
          "source": "fda-amitiza",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data available on the presence of lubiprostone in human milk or the effect of lubiprostone on milk production.",
      "refs": [
        {
          "source": "fda-amitiza",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Safety and effectiveness have not been established in pediatric patients with IBS-C, pediatric functional constipation (PFC), and OIC.",
      "refs": [
        {
          "source": "fda-amitiza",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Chronic Idiopathic Constipation The efficacy of Amitiza 24 mcg twice daily in the elderly (at least 65 years of age) subpopulation with CIC was consistent with the efficacy in the overall study population.",
