  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "نداشتن کیسه صفرا؛ انسداد مجرای صفراوی یا اختلال اسفنکتر اودی؛ الکلیسم یا بیش از ۳ نوشیدنی الکلی در روز؛ سابقه پانکراتیت یا بیماری ساختاری پانکراس؛ نارسایی شدید کبد؛ سابقه یبوست شدید یا انسداد مکانیکی روده؛ حساسیت.",
        "en": "No gallbladder; biliary duct obstruction or sphincter of Oddi disease; alcoholism or >3 alcoholic drinks a day; history of pancreatitis or structural pancreatic disease; severe hepatic impairment; history of severe constipation or mechanical bowel obstruction; hypersensitivity."
      },
      "refs": [
        {
          "source": "fda-viberzi",
          "section": "4"
        }
      ]
    }
  ],
