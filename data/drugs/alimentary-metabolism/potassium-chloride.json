  "contraindications": [
    {
      "id": "ksparing",
      "severity": "block",
      "text": {
        "fa": "مصرف همزمان دیورتیک نگهدارنده پتاسیم.",
        "en": "Concomitant potassium-sparing diuretics."
      },
      "refs": [
        {
          "source": "fda-kcl-solution",
          "section": "4"
        }
      ]
    },
    {
      "id": "iv",
      "severity": "block",
      "text": {
        "fa": "تزریقی: هیپرکالمی، نارسایی کلیه و حالت‌های احتباس پتاسیم.",
        "en": "Injection: hyperkalaemia, renal failure and potassium retention."
      },
      "refs": [
        {
          "source": "fda-kcl-iv",
          "section": "Contraindications"
        }
      ]
    },
    {
      "id": "solid",
      "severity": "block",
      "text": {
        "fa": "قرص: هر علتی برای توقف یا تأخیر عبور قرص در دستگاه گوارش (مثلاً گاستروپارزی دیابتی، داروهای آنتی‌کولینرژیک).",
        "en": "Tablets: any cause of arrested or delayed tablet transit (e.g. diabetic gastroparesis, anticholinergics)."
      },
      "refs": [
        {
          "source": "fda-kcl-er",
          "section": "Contraindications"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هیپرکالمی کشنده (به‌ویژه در نارسایی کلیه)؛ تزریق رقیق‌نشده فوراً کشنده است.",
        "en": "Fatal hyperkalaemia (especially in renal impairment); undiluted injection is instantly fatal."
