  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "There are no human data related to use of Potassium Chloride during pregnancy, and animal studies have not been conducted.",
      "refs": [
        {
          "source": "fda-kcl-solution",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary The normal potassium ion content of human milk is about 13 mEq per liter.",
      "refs": [
        {
          "source": "fda-kcl-solution",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of Potassium Chloride have been demonstrated in children with diarrhea and malnutrition from birth to 16 years.",
      "refs": [
        {
          "source": "fda-kcl-solution",
          "section": "8.4"
        }
      ]
