  "regimens": [
    {
      "id": "age-vomiting",
      "disease": "gastroenteritis-vomiting",
      "label": {
        "fa": "استفراغ گاستروآنتریت — تک‌دوز ۰٫۱۵ mg/kg (حداکثر ۸ mg)",
        "en": "Gastroenteritis vomiting — single dose 0.15 mg/kg (max 8 mg)"
      },
      "population": {
        "minAge": {
          "value": 6,
          "unit": "month"
        },
        "minWeightKg": 8
      },
      "type": "weightBased",
      "unit": "mg",
      "dose": {
        "perKgPerDose": 0.15,
        "intervalHours": 24
      },
      "refs": [
        {
          "source": "cps-ondansetron-2018",
          "section": "Recommendations"
        }
      ],
      "limits": {
        "maxPerDose": 8,
        "refs": [
          {
            "source": "cps-ondansetron-2018",
            "section": "Recommendations"
          }
        ]
      },
      "durationDays": {
        "min": 1,
        "max": 1
      },
      "notes": [
        {
          "text": {
            "fa": "فقط یک دوز؛ دوزهای متعدد سودی ندارد. ORS از ۱۵ تا ۳۰ دقیقه بعد شروع شود. برای کودک با دهیدراتاسیون خفیف تا متوسط یا شکست ORS؛ در اسهال شدید غالب روتین نیست.",
            "en": "Single dose only; no benefit from multiple doses. Start oral rehydration 15–30 min later. For mild–moderate dehydration or failed ORS; not routine when moderate–severe diarrhea predominates."
          },
          "refs": [
            {
              "source": "cps-ondansetron-2018",
              "section": "Recommendations"
            }
          ]
        },
        {
          "text": {
            "fa": "جایگزین وزنی: ۸–۱۵ kg: ۲ mg؛ ۱۵–۳۰ kg: ۴ mg؛ بیش از ۳۰ kg: ۶–۸ mg. فرم مایع توصیه شده؛ قرص ۴ mg برای دوز کمتر از ۴ mg مناسب نیست.",
            "en": "Weight-band alternative: 8–15 kg 2 mg; 15–30 kg 4 mg; >30 kg 6–8 mg. Liquid form recommended; a 4 mg tablet cannot give doses below 4 mg."
          },
          "refs": [
            {
              "source": "cps-ondansetron-2018",
              "section": "Recommendations"
            }
          ]
        },
        {
          "text": {
            "fa": "این کاربرد در برچسب FDA نیست (برچسب: پیشگیری از تهوع شیمی‌درمانی و پس از عمل).",
            "en": "This use is not in the FDA label (label: chemotherapy and postoperative nausea prevention)."
          },
          "refs": [
            {
              "source": "fda-ondansetron-tab",
              "section": "1"
            }
          ]
        }
      ],
      "allowedFormulations": [
        "tab-4",
        "tab-8",
        "odt-4",
        "sol-4-5"
      ]
