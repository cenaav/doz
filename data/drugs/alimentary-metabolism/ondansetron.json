  "contraindications": [
    {
      "id": "hypersensitivity",
      "severity": "block",
      "text": {
        "fa": "حساسیت (مثل آنافیلاکسی) به اندانسترون.",
        "en": "Hypersensitivity (e.g. anaphylaxis) to ondansetron."
      },
      "refs": [
        {
          "source": "fda-ondansetron-tab",
          "section": "4"
        }
      ]
    },
    {
      "id": "apomorphine",
      "severity": "block",
      "text": {
        "fa": "مصرف همزمان آپومورفین (افت فشار شدید و کاهش هوشیاری).",
        "en": "Concomitant apomorphine (profound hypotension, loss of consciousness)."
      },
      "refs": [
        {
          "source": "fda-ondansetron-tab",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "طولانی شدن QT",
        "en": "QT prolongation"
      },
      "refs": [
        {
          "source": "fda-ondansetron-tab",
          "section": "5.2"
        }
      ]
    },
    {
      "text": {
        "fa": "سندرم سروتونین",
        "en": "Serotonin syndrome"
      },
      "refs": [
        {
          "source": "fda-ondansetron-tab",
          "section": "5.3"
        }
      ]
    },
    {
      "text": {
        "fa": "ایسکمی میوکارد",
        "en": "Myocardial ischemia"
      },
      "refs": [
        {
          "source": "fda-ondansetron-tab",
          "section": "5.4"
        }
      ]
    },
    {
      "text": {
        "fa": "ممکن است ایلئوس پیشرونده را بپوشاند",
        "en": "May mask progressive ileus and gastric distension"
      },
      "refs": [
        {
          "source": "fda-ondansetron-tab",
          "section": "5.5"
        }
      ]
    },
    {
      "text": {
        "fa": "برای ECG و الکترولیت روتین پیش از تک‌دوز خوراکی در کودک بدون عامل خطر شواهدی نیست.",
        "en": "Routine ECG/electrolyte screening before a single oral dose is not supported in children without known risk factors."
      },
      "refs": [
        {
          "source": "cps-ondansetron-2018",
          "section": "Recommendations"
        }
      ]
    }
  ],
