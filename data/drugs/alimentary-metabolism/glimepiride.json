  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data from a small number of published studies and postmarketing experience with glimepiride tablets use in pregnancy over decades have not identified any drug associated risks for major birth defects, miscarriage, or adverse maternal outcomes.",
      "refs": [
        {
          "source": "fda-glimepiride",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Breastfed infants of lactating women using glimepiride tablets should be monitored for symptoms of hypoglycemia (see Clinical Considerations) .",
      "refs": [
        {
          "source": "fda-glimepiride",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان ثابت نشده است.",
        "en": "Label: safety and effectiveness in children have not been established."
      },
      "quote": "Glimepiride is not recommended in pediatric patients because of its adverse effects on body weight and hypoglycemia.",
      "refs": [
        {
          "source": "fda-glimepiride",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In addition, hypoglycemia may be difficult to recognize in the elderly [ see Dosage and Administration ( 2.1 ) and Warnings and Precautions ( 5.1 ) ].",
