  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are no adequate and well-controlled studies with esomeprazole in pregnant women.",
      "refs": [
        {
          "source": "fda-nexium",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Esomeprazole is the S-isomer of omeprazole and limited data suggest that omeprazole may be present in human milk.",
      "refs": [
        {
          "source": "fda-nexium",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "The safety and effectiveness of NEXIUM for the treatment of EE due to acid-mediated GERD in pediatric patients less than 1 month of age have not been established.",
      "refs": [
        {
          "source": "fda-nexium",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Of the total number of patients who received NEXIUM in clinical trials, 1459 were 65 to 74 years of age and 354 patients were 75 years of age and older.",
      "refs": [
        {
          "source": "fda-nexium",
          "section": "8.5"
        }
      ]
    }
  }
