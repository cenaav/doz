    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There is no information regarding the presence of pilocarpine in human milk, the effects on the breastfed infants or the effects on milk production to inform risk of pilocarpine hydrochloride ophthalmic solution to an infant during lactation.",
      "refs": [
        {
          "source": "fda-pilocarpine-125",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
