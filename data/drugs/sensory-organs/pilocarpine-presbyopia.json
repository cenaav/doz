    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are no adequate and well-controlled studies of pilocarpine hydrochloride ophthalmic solution administration in pregnant women to inform a drug-associated risk.",
      "refs": [
        {
          "source": "fda-pilocarpine-125",
          "section": "8.1"
        }
      ]
