  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Reproduction studies have been performed in rats and mice using oral doses of up to 100 mg/kg and IV doses up to 30 mg/kg and have revealed no evidence of harm to the fetus as a result of ciprofloxacin.",
      "refs": [
        {
          "source": "fda-ciprohc",
          "section": "Pregnancy: Teratogenic Effects:"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in nursing infants, a decision should be made whether to discontinue nursing or to discontinue the drug, taking into account the importance of the drug to the mother.",
      "refs": [
        {
          "source": "fda-ciprohc",
          "section": "Nursing Mothers:"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "The safety and efficacy of ciprofloxacin hydrochloride and hydrocortisone otic suspension have been established in pediatric patients 2 years and older (131 patients) in adequate and well-controlled clinical trials.",
      "refs": [
