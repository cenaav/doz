  "populations": {
    "pregnancy": {
      "level": "ok",
      "text": {
        "fa": "برچسب: جذب سیستمیک ناچیز؛ مواجهه جنین انتظار نمی‌رود.",
        "en": "Label: minimal systemic absorption; fetal exposure not expected."
      },
      "quote": "… detected systemically following topical ocular administration [see Clinical Pharmacology (12.3) ] , and maternal use is not expected to result in fetal exposure to the drug.",
      "refs": [
        {
          "source": "fda-restasis",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Although blood concentrations are undetectable following topical administration of cyclosporine ophthalmic emulsion 0.05% [see Clinical Pharmacology (12.3) ] , caution should be exercised when RESTASIS MULTIDOSE is administered to a nursing woman.",
      "refs": [
        {
          "source": "fda-restasis",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Safety and efficacy have not been established in pediatric patients below the age of 16.",
      "refs": [
        {
          "source": "fda-restasis",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "No overall difference in safety or effectiveness has been observed between elderly and younger patients.",
      "refs": [
