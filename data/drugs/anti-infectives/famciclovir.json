  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data from pharmacovigilance reports with famciclovir use in pregnant women have not identified a drug-associated risk of major birth defects, miscarriage or adverse maternal or fetal outcomes.",
      "refs": [
        {
          "source": "fda-famciclovir",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of famciclovir (prodrug) or penciclovir (active drug) in human milk, the effects on the breastfed infant, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-famciclovir",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The efficacy of famciclovir has not been established in pediatric patients.",
      "refs": [
        {
          "source": "fda-famciclovir",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In general, appropriate caution should be exercised in the administration and monitoring of famciclovir in elderly patients reflecting the greater frequency of decreased renal function and concomitant use of other drugs.",
      "refs": [
        {
          "source": "fda-famciclovir",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Infertility Decreased fertility, due to testicular toxicity, was observed in male animals following repeated administration of famciclovir or penciclovir [see Nonclinical Toxicology ( 13.1 )].",
      "refs": [
        {
          "source": "fda-famciclovir",
          "section": "8.3"
        }
      ]
    }
  }
