  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Pregnancy Category B Cefpodoxime proxetil was neither teratogenic nor embryocidal when administered to rats during organogenesis at doses up to 100 mg/kg/day (2 times the human dose based on mg/m 2 ) or to rabbits at doses up to 30 mg/kg/day (1 to 2 times the human dose based on mg/m 2 ).",
      "refs": [
        {
          "source": "fda-cefpodoxime",
          "section": "Pregnancy - Teratogenic Effects:"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious reactions in nursing infants, a decision should be made whether to discontinue nursing or to discontinue the drug, taking into account the importance of the drug to the mother.",
      "refs": [
        {
          "source": "fda-cefpodoxime",
          "section": "Nursing Mothers:"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Safety and efficacy in infants less than 2 months of age have not been established.",
      "refs": [
        {
          "source": "fda-cefpodoxime",
          "section": "Pediatric Use:"
