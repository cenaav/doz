  "contraindications": [
    {
      "id": "beta-lactam-hypersensitivity",
      "severity": "block",
      "text": {
        "fa": "سابقه واکنش حساسیتی جدی (آنافیلاکسی یا استیونس-جانسون) به آموکسی‌سیلین یا سایر بتالاکتام‌ها.",
        "en": "History of serious hypersensitivity (anaphylaxis or Stevens-Johnson syndrome) to amoxicillin or other beta-lactams."
      },
      "refs": [
        {
          "source": "fda-amoxicillin",
          "section": "4"
        }
      ]
    }
