  "contraindications": [
    {
      "id": "hypersensitivity",
      "severity": "block",
      "text": {
        "fa": "حساسیت به کلاریترومایسین، اریترومایسین یا هر ماکرولید.",
        "en": "Hypersensitivity to clarithromycin, erythromycin or any macrolide."
      },
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "4.1"
        }
      ]
    },
    {
      "id": "cisapride-pimozide",
      "severity": "block",
      "text": {
        "fa": "مصرف همزمان با سیزاپراید یا پیموزاید (آریتمی کشنده).",
        "en": "Concomitant cisapride or pimozide (fatal arrhythmias)."
      },
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "4.2"
        }
      ]
    },
    {
      "id": "hepatic-history",
      "severity": "block",
      "text": {
        "fa": "سابقه یرقان کلستاتیک/اختلال کبدی با کلاریترومایسین.",
        "en": "History of cholestatic jaundice/hepatic dysfunction with clarithromycin."
      },
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "4.3"
        }
      ]
    },
    {
      "id": "colchicine",
      "severity": "block",
      "text": {
        "fa": "همراه کلشی‌سین در نارسایی کلیه یا کبد.",
        "en": "With colchicine in renal or hepatic impairment."
      },
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "4.4"
        }
      ]
    },
    {
      "id": "statins",
      "severity": "block",
      "text": {
        "fa": "همراه لومیتاپید، لواستاتین یا سیمواستاتین.",
        "en": "With lomitapide, lovastatin or simvastatin."
      },
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "4.5"
        }
      ]
    },
    {
      "id": "under-6-months",
      "severity": "block",
      "rule": {
        "maxAge": {
          "value": 6,
          "unit": "month"
        }
      },
      "text": {
        "fa": "بی‌خطری سوسپانسیون زیر ۶ ماه ثابت نشده است.",
        "en": "Safety and effectiveness established only from 6 months."
      },
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "8.4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "واکنش‌های حساسیتی حاد شدید",
