  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Based on findings from animal studies, clarithromycin is not recommended for use in pregnant women except in clinical circumstances where no alternative therapy is appropriate.",
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Based on limited human data, clarithromycin and its active metabolite 14-OH clarithromycin are present in human milk at less than 2% of the maternal weight-adjusted dose ( see Data ).",
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of clarithromycin for oral suspension have been established for the treatment of the following conditions or diseases in pediatric patients 6 months and older.",
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Elderly patients may be more susceptible to development of torsades de pointes arrhythmias than younger patients [ see Warnings and Precautions ( 5.3 ) ].",
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Males Administration of clarithromycin resulted in testicular atrophy in rats, dogs and monkeys [see Nonclinical Toxicology ( 13.1 )] .",
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "8.3"
        }
      ]
    }
  }
