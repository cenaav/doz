  "contraindications": [
    {
      "id": "hyper",
      "severity": "block",
      "text": {
        "fa": "حساسیت به داپتومایسین.",
        "en": "Hypersensitivity to daptomycin."
      },
      "refs": [
        {
          "source": "fda-cubicin-rf",
