  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Limited published data on use of CUBICIN RF in pregnant women are insufficient to inform a drug-associated risk for major birth defects and miscarriage.",
      "refs": [
        {
          "source": "fda-cubicin-rf",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Limited published data report that daptomycin is present in human milk at infant doses of 0.1% of the maternal dose (see Data ) 2,3,4 .",
      "refs": [
        {
          "source": "fda-cubicin-rf",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در عفونت پوست و باکتریمی استاف از ۱ تا ۱۷ سال ثابت شده؛ زیر ۱ سال نه.",
        "en": "Label: established for cSSSI and S. aureus bacteraemia at 1–17 y; not under 1 y."
      },
      "quote": "The safety and effectiveness of CUBICIN RF in the treatment of cSSSI and S. aureus bloodstream infections (bacteremia) have been established in the age groups 1 to 17 years of age.",
      "refs": [
        {
          "source": "fda-cubicin-rf",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Of the 534 adult patients treated with CUBICIN in Phase 3 controlled clinical trials of complicated skin and skin structure infections (cSSSI), 27% were 65 years of age or older and 12% were 75 years of age or older.",
      "refs": [
        {
          "source": "fda-cubicin-rf",
          "section": "8.5"
        }
      ]
    }
  }
