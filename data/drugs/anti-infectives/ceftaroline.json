  "contraindications": [
    {
      "id": "hyper",
      "severity": "block",
      "text": {
        "fa": "حساسیت جدی به سفتارولین یا سایر سفالوسپورین‌ها.",
        "en": "Serious hypersensitivity to ceftaroline or other cephalosporins."
      },
      "refs": [
        {
          "source": "fda-teflaro",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "واکنش حساسیتی (حساسیت متقاطع با بتالاکتام‌ها)؛ اسهال C. difficile؛ عوارض عصبی (انسفالوپاتی، تشنج) به‌ویژه در نارسایی کلیه؛ تست کومبس مثبت.",
        "en": "Hypersensitivity (beta-lactam cross-reactivity); C. difficile diarrhoea; neurological reactions (encephalopathy, seizures) especially in renal impairment; positive Coombs test."
      },
      "refs": [
        {
          "source": "fda-teflaro",
          "section": "5"
        }
      ]
    }
  ],
  "renal": [
    {
