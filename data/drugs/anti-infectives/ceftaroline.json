    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are no adequate studies with Teflaro in pregnant women that informed any drug associated risks.",
      "refs": [
        {
          "source": "fda-teflaro",
          "section": "8.1"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of Teflaro in the treatment of ABSSSI have been established in pediatric patients (at least 34 weeks gestational age and 12 days postnatal age).",
      "refs": [
        {
          "source": "fda-teflaro",
          "section": "8.4"
        }
      ]
