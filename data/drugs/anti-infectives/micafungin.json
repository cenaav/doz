  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Based on findings from animal studies, Micafungin for Injection may cause fetal harm when administered to a pregnant woman (see Data) .",
      "refs": [
        {
          "source": "fda-micafungin",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of micafungin in human milk, the effects on the breast-fed infant or the effects on milk production .",
      "refs": [
        {
          "source": "fda-micafungin",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Pediatric Patients 4 Months of Age and Older The safety and effectiveness of micafungin for injection for the treatment of esophageal candidiasis, candidemia, acute disseminated candidiasis, Candida peritonitis and abscesses, esophageal candidiasis, and for prophylaxis of Candida infections in patients undergoing HSCT …",
      "refs": [
        {
          "source": "fda-micafungin",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "This may be clinically important with regard to such diseases as congestive heart failure and other conditions requiring restricted sodium intake [ see Warnings and Precautions (5.6 )] .",
      "refs": [
