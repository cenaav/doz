  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Because animal reproduction studies are not always predictive of human response, penicillin should be used during pregnancy only if clearly needed.",
      "refs": [
        {
          "source": "fda-ampicillin",
          "section": "Pregnancy"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Ampicillin used by nursing mothers may lead to sensitization of infants; therefore, caution should be exercised when ampicillin is administered to a nursing woman.",
      "refs": [
        {
          "source": "fda-ampicillin",
          "section": "Nursing Mothers"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "Penicillins are excreted primarily unchanged by the kidney; therefore, the incompletely developed renal function in neonates and young infants will delay the excretion of penicillin.",
      "refs": [
        {
          "source": "fda-ampicillin",
          "section": "Pediatric Use"
        }
      ]
    }
  }
