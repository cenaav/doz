  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به ریفامایسین‌ها؛ هم‌زمان با ساکویناویر/ریتوناویر و برخی داروهای ضدویروس.",
        "en": "Hypersensitivity to rifamycins; with saquinavir/ritonavir and certain antivirals."
      },
      "refs": [
        {
          "source": "fda-rifampin",
          "section": "Contraindications"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "ادرار، خلط و اشک رنگی می‌شود و لنز تماسی نرم ممکن است برای همیشه رنگ بگیرد. قرص و سایر روش‌های هورمونی پیشگیری ممکن است کم‌اثر شوند.",
        "en": "Urine, sputum and tears may be discoloured and soft contact lenses permanently stained. Hormonal contraceptives may become less reliable."
      },
      "refs": [
        {
          "source": "fda-rifampin",
          "section": "Precautions — Information for Patients"
        }
      ]
    }
