  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Nevertheless, because the studies in humans cannot rule out the possibility of harm, rifampin should be used during pregnancy only if the potential benefit outweighs the potential risk to the fetus.",
      "refs": [
        {
          "source": "fda-rifampin",
          "section": "PREGNANCY"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Because of the potential for tumorigenicity shown for rifampin in animal studies, a decision should be made whether to discontinue nursing or discontinue the drug, taking into account the importance of the drug to the mother.",
      "refs": [
        {
          "source": "fda-rifampin",
          "section": "NURSING MOTHERS"
        }
      ]
