  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب: داده‌های موجود افزایش خطر نقص مادرزادی یا سقط را نشان نمی‌دهد؛ مطالعه کنترل‌شده کافی نیست.",
        "en": "Label: available data do not suggest an increased risk of major birth defects or miscarriage; no adequate controlled studies."
      },
      "quote": "Available data do not suggest an increased risk of major birth defects and miscarriage in women who received HAVRIX during pregnancy",
      "refs": [
        {
          "source": "fda-havrix",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There is no information regarding the presence of HAVRIX in human milk, the effects on the breastfed child, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-havrix",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of HAVRIX have not been established in pediatric patients younger than 12 months.",
      "refs": [
        {
          "source": "fda-havrix",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Clinical studies of HAVRIX did not include sufficient numbers of participants aged 65 years and older to determine whether they respond differently from younger participants.",
