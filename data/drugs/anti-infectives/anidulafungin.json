  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Based on findings from animal studies, ERAXIS can cause fetal harm when administered to a pregnant woman.",
      "refs": [
        {
          "source": "fda-eraxis",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of anidulafungin in human milk, the effects on the breastfed infant or the effects on milk production.",
      "refs": [
        {
          "source": "fda-eraxis",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of ERAXIS for the treatment of candidemia and the following Candida infections: intra-abdominal abscess and peritonitis, have been established in pediatric patients 1 month of age and older.",
      "refs": [
        {
          "source": "fda-eraxis",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Of the total number of subjects (N = 197) in the pivotal clinical studies of anidulafungin, 35% were 65 years and over, while 18% were 75 years and over.",
      "refs": [
        {
          "source": "fda-eraxis",
          "section": "8.5"
        }
      ]
    }
