  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به سیپروفلوکساسین یا سایر کینولون‌ها؛ مصرف همزمان تیزانیدین.",
        "en": "Hypersensitivity to ciprofloxacin or other quinolones; concomitant tizanidine."
      },
      "refs": [
        {
          "source": "fda-ciprofloxacin",
          "section": "4"
        }
      ]
    },
    {
      "id": "boxed",
      "severity": "warn",
      "text": {
        "fa": "هشدار جعبه‌ای: تاندونیت و پارگی تاندون، نوروپاتی محیطی، اثرات CNS و تشدید میاستنی گراویس؛ در میاستنی پرهیز شود.",
        "en": "Boxed warning: tendinitis and tendon rupture, peripheral neuropathy, CNS effects and exacerbation of myasthenia gravis; avoid in myasthenia gravis."
      },
      "refs": [
        {
