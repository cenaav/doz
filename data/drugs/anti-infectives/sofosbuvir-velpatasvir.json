  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب: منع مصرف فقط برای ترکیب با ریباویرین (در زن باردار و مردی که همسرش باردار است)؛ برای اپکلوسا به‌تنهایی داده کافی نیست.",
        "en": "Label: contraindicated only in combination with ribavirin (pregnant women and men whose partners are pregnant); limited data for Epclusa alone."
      },
      "quote": "Risk Summary If EPCLUSA is administered with ribavirin, the combination regimen is contraindicated in pregnant women and in men whose female partners are pregnant.",
      "refs": [
        {
          "source": "fda-epclusa",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "The predominant circulating metabolite of sofosbuvir (GS-331007) was the primary component observed in the milk of lactating rats administered sofosbuvir, without effect on nursing pups.",
      "refs": [
        {
          "source": "fda-epclusa",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The pharmacokinetics, safety, and effectiveness of EPCLUSA for treatment of HCV genotype 1, 2, 3, 4, or 6 infection in treatment-naïve and treatment-experienced pediatric patients 3 years of age and older without cirrhosis or with compensated cirrhosis have been established in an open-label, multicenter clinical trial …",
      "refs": [
        {
          "source": "fda-epclusa",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "ok",
      "text": {
        "fa": "برچسب: در سالمندان تفاوت یا تنظیم دوز خاصی ذکر نشده.",
        "en": "Label: no specific difference or dose adjustment stated for older adults."
      },
      "quote": "No dosage adjustment of EPCLUSA is warranted in geriatric patients [see Clinical Pharmacology (12.3) ] .",
      "refs": [
        {
          "source": "fda-epclusa",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "If EPCLUSA is administered with ribavirin, the information for ribavirin with regard to pregnancy testing, contraception, and infertility also applies to this combination regimen.",
