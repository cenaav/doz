  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Based on animal data, PRIFTIN may cause fetal harm when administered to a pregnant woman.",
      "refs": [
        {
          "source": "fda-priftin",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of rifapentine or its metabolite in human or animal milk, the effects on the breastfed infant, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-priftin",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of PRIFTIN in the treatment of active pulmonary tuberculosis have not been established in pediatric patients under the age of 12.",
      "refs": [
        {
          "source": "fda-priftin",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Clinical studies with PRIFTIN did not include sufficient numbers of subjects aged 65 years and over to determine whether they respond differently from younger subjects.",
      "refs": [
        {
          "source": "fda-priftin",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Use of PRIFTIN may reduce the efficacy of hormonal contraceptives.",
      "refs": [
        {
          "source": "fda-priftin",
          "section": "8.3"
        }
      ]
    }
  }
