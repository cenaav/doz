  "contraindications": [
    {
      "id": "macrolide-hypersensitivity",
      "severity": "block",
      "text": {
        "fa": "حساسیت شناخته‌شده به آزیترومایسین، اریترومایسین، هر ماکرولید یا کتولید.",
        "en": "Known hypersensitivity to azithromycin, erythromycin, any macrolide or ketolide."
      },
      "refs": [
        {
          "source": "fda-zithromax",
          "section": "4.1"
        }
      ]
    },
    {
      "id": "hepatic-history",
      "severity": "block",
      "text": {
        "fa": "سابقه یرقان کلستاتیک/اختلال کبدی با مصرف قبلی آزیترومایسین.",
        "en": "History of cholestatic jaundice/hepatic dysfunction with prior azithromycin."
      },
      "refs": [
        {
          "source": "fda-zithromax",
          "section": "4.2"
        }
      ]
    }
