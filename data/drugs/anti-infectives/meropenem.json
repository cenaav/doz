  ],
  "warnings": [
    {
      "text": {
        "fa": "واکنش آلرژیک جدی؛ اسهال مرتبط با کلستریدیوم دیفیسیل؛ تشنج (به‌ویژه در نارسایی کلیه).",
        "en": "Serious hypersensitivity; Clostridioides difficile-associated diarrhoea; seizures (especially with renal impairment)."
      },
      "refs": [
        {
          "source": "fda-meropenem",
          "section": "5"
        }
      ]
    }
  ],
  "renal": [
    {
      "egfrBelow": 50,
      "severity": "warn",
      "text": {
        "fa": "ClCr ۲۶ تا ۵۰: دوز معمول هر ۱۲ ساعت؛ ۱۰ تا ۲۵: نصف دوز هر ۱۲ ساعت؛ زیر ۱۰: نصف دوز هر ۲۴ ساعت.",
        "en": "CrCl 26–50: usual dose every 12 h; 10–25: half dose every 12 h; <10: half dose every 24 h."
      },
