    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are no adequate and well-controlled studies with oseltamivir phosphate for oral suspension in pregnant women to inform a drug‐associated risk of adverse developmental outcomes.",
      "refs": [
        {
          "source": "fda-oseltamivir-susp",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
