  "contraindications": [
    {
      "id": "hyper",
      "severity": "block",
      "text": {
        "fa": "واکنش آلرژیک فوری به سفپیم، سفالوسپورین‌ها، پنی‌سیلین‌ها یا سایر بتالاکتام‌ها.",
        "en": "Immediate hypersensitivity to cefepime, cephalosporins, penicillins or other beta-lactams."
      },
      "refs": [
        {
          "source": "fda-cefepime",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "انسفالوپاتی، میوکلونوس و تشنج غیرتشنجی به‌ویژه در نارسایی کلیه بدون تعدیل دوز؛ اسهال C. difficile.",
        "en": "Encephalopathy, myoclonus and non-convulsive status, mainly with renal impairment without dose adjustment; C. difficile diarrhoea."
      },
      "refs": [
        {
          "source": "fda-cefepime",
          "section": "5"
