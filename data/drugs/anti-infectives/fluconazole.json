  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به فلوکونازول؛ همراه داروهای طولانی‌کننده QT که با CYP3A4 متابولیزه می‌شوند (اریترومایسین، پیموزاید، کینیدین).",
        "en": "Hypersensitivity to fluconazole; with QT-prolonging CYP3A4 substrates (erythromycin, pimozide, quinidine)."
      },
      "refs": [
        {
          "source": "fda-diflucan",
          "section": "Contraindications"
        }
      ]
    },
    {
      "id": "under-6m",
      "severity": "warn",
      "rule": {
        "maxAge": {
          "value": 6,
          "unit": "month"
        }
      },
      "text": {
        "fa": "دوز برفک در کودکان از ۶ ماه به بالا است.",
        "en": "Pediatric thrush dosing is for 6 months and older."
      },
      "refs": [
        {
          "source": "fda-diflucan",
          "section": "Dosage and Administration in Pediatric Patients"
        }
      ]
    }
