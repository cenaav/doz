  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data from published epidemiologic studies and pharmacovigilance case reports over several decades cephalexin for oral suspension use in pregnant women have not established drug-associated risks of major birth defects, miscarriage, or adverse maternal or fetal outcomes.",
      "refs": [
        {
          "source": "fda-cephalexin-susp",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Data from a published clinical lactation study report that cephalexin is present in human milk.",
      "refs": [
        {
          "source": "fda-cephalexin-susp",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of cephalexin for oral suspension have been established in pediatric patients aged one year and older in clinical trials [see Indications and Usage ( 1.1 - 1.5 )] for the dosages described in the dosage and administration section [see Dosage and Administration ( 2.1 , 2.2 )].",
      "refs": [
        {
          "source": "fda-cephalexin-susp",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Because elderly patients are more likely to have decreased renal function, care should be taken in dose selection [see Warnings and Precautions ( 5.4 )].",
      "refs": [
        {
          "source": "fda-cephalexin-susp",
          "section": "8.5"
        }
      ]
    }
  },
