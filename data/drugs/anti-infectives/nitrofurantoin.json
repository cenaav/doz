  "populations": {
    "pregnancy": {
      "level": "contraindicated",
      "text": {
        "fa": "برچسب: در بارداری منع مصرف دارد.",
        "en": "Label: contraindicated in pregnancy."
      },
      "quote": "Because of the possibility of hemolytic anemia due to immature erythrocyte enzyme systems (glutathione instability), the drug is contraindicated in pregnant patients at term (38 to 42 weeks' gestation), during labor and delivery, or when the onset of labor is imminent.",
      "refs": [
        {
          "source": "fda-nitrofurantoin-macro",
          "section": "CONTRAINDICATIONS"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions from nitrofurantoin in nursing infants under one month of age, a decision should be made whether to discontinue nursing or to discontinue the drug, taking into account the importance of the drug to the mother (see CONTRAINDICATIONS ).",
      "refs": [
        {
          "source": "fda-nitrofurantoin-macro",
          "section": "Precautions/Warnings – Nursing Mothers"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Nitrofurantoin capsules (macrocrystals) are contraindicated in infants below the age of one month (see CONTRAINDICATIONS ).",
      "refs": [
        {
          "source": "fda-nitrofurantoin-macro",
          "section": "Precautions/Warnings – Pediatric Use"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Because elderly patients are more likely to have decreased renal function, care should be taken in dose selection, and it may be useful to monitor renal function.",
      "refs": [
        {
          "source": "fda-nitrofurantoin-macro",
          "section": "Precautions/Warnings – Geriatric Use"
        }
      ]
    }
  }
