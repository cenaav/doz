  "contraindications": [
    {
      "id": "neonate",
      "severity": "block",
      "rule": {
        "maxAge": {
          "value": 1,
          "unit": "month"
        }
      },
      "text": {
        "fa": "زیر ۱ ماه منع مصرف دارد (همولیز).",
        "en": "Contraindicated under 1 month (haemolytic anaemia)."
      },
      "refs": [
        {
          "source": "fda-macrobid",
          "section": "Contraindications"
        }
      ]
    },
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "آنوری، الیگوری یا CrCl کمتر از ۶۰؛ بارداری ترم (۳۸ تا ۴۲ هفته) و زایمان؛ سابقه زردی کلستاتیک با نیتروفورانتوئین؛ حساسیت.",
        "en": "Anuria, oliguria or CrCl <60 mL/min; pregnancy at term (38–42 weeks) and labour; prior nitrofurantoin cholestatic jaundice; hypersensitivity."
      },
      "refs": [
        {
          "source": "fda-macrobid",
          "section": "Contraindications"
