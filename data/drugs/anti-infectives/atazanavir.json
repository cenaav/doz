  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت قبلی (SJS، اریتم مولتی‌فرم)؛ داروهای وابسته به CYP3A یا UGT1A1 با دامنه باریک و القاگرهای قوی (طبق جدول برچسب).",
        "en": "Prior hypersensitivity (SJS, erythema multiforme); CYP3A/UGT1A1-dependent narrow-index drugs and strong inducers (per label table)."
      },
      "refs": [
        {
          "source": "fda-reyataz",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
