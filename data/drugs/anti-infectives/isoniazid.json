  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "واکنش شدید قبلی (از جمله هپاتیت دارویی)؛ آسیب کبدی قبلی با ایزونیازید؛ بیماری حاد کبد.",
        "en": "Previous severe reactions (incl. drug hepatitis); previous isoniazid liver injury; acute liver disease."
      },
      "refs": [
        {
          "source": "fda-isoniazid",
          "section": "Contraindications"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: هپاتیت شدید و گاهی کشنده؛ خطر با افزایش سن و مصرف روزانه الکل بیشتر می‌شود؛ علائم و آنزیم کبد پایش شود.",
        "en": "Boxed warning: severe, sometimes fatal hepatitis; risk rises with age and daily alcohol use; monitor symptoms and liver enzymes."
      },
