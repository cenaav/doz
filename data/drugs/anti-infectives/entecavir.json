  "contraindications": [],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: تشدید شدید هپاتیت B پس از قطع؛ در عفونت همزمان HIV بدون درمان ضدرتروویروسی خطر مقاومت HIV؛ اسیدوز لاکتیک و کبد چرب شدید.",
        "en": "Boxed warning: severe hepatitis B flare after stopping; HIV resistance risk in untreated HIV co-infection; lactic acidosis and severe hepatomegaly with steatosis."
      },
      "refs": [
        {
          "source": "fda-baraclude",
          "section": "Boxed Warning"
        }
      ]
    }
  ],
