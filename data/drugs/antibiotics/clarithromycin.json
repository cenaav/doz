      },
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
          "section": "5.4"
        }
      ]
    },
    {
      "text": {
        "fa": "اسهال مرتبط با کلستریدیوم دیفیسیل",
        "en": "Clostridium difficile-associated diarrhea"
      },
      "refs": [
        {
          "source": "fda-clarithromycin-susp",
