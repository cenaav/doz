  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Clinical Considerations Maternal Adverse Reactions : In general, avoid use of dopamine agonists, including cabergoline tablets, during pregnancy and the postpartum period.",
      "refs": [
        {
          "source": "fda-cabergoline",
          "section": "8.1"
        }
