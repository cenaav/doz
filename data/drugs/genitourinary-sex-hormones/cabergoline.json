  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "فشار خون کنترل‌نشده؛ حساسیت به مشتقات ارگوت؛ سابقه بیماری دریچه قلب؛ سابقه فیبروز ریه، پریکارد یا رتروپریتوئن.",
        "en": "Uncontrolled hypertension; hypersensitivity to ergot derivatives; history of cardiac valvulopathy; history of pulmonary, pericardial or retroperitoneal fibrosis."
      },
      "refs": [
        {
          "source": "fda-cabergoline",
          "section": "4"
        }
      ]
    },
    {
      "id": "uk-ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت به ارگوت‌ها؛ سابقه فیبروز ریه، پریکارد یا رتروپریتوئن؛ نارسایی کبد؛ توکسمی بارداری؛ مصرف همزمان آنتی‌سایکوتیک؛ سابقه سایکوز پس از زایمان.",
        "en": "Ergot hypersensitivity; history of pulmonary, pericardial or retroperitoneal fibrosis; hepatic insufficiency; toxaemia of pregnancy; concomitant antipsychotics; history of puerperal psychosis."
      },
      "refs": [
        {
          "source": "uk-dostinex",
          "section": "4.3"
        }
      ]
    }
