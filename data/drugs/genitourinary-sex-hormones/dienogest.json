      "notes": [
        {
          "text": {
            "fa": "هر روز در ساعت ثابت، بدون توجه به خونریزی؛ بسته بعدی بی‌وقفه. پیشگیری هورمونی قطع و در صورت نیاز روش سدی.",
            "en": "Same time each day regardless of bleeding; start the next pack without a break. Stop hormonal contraception; use a barrier method if needed."
          },
          "refs": [
            {
              "source": "uk-dienogest",
              "section": "4.2"
            }
          ]
        }
      ]
    }
  ],
  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "ترومبوآمبولی وریدی فعال؛ بیماری شریانی یا قلبی‌عروقی؛ دیابت با درگیری عروق؛ بیماری یا تومور کبد؛ بدخیمی وابسته به هورمون؛ خونریزی نامشخص واژن؛ حساسیت.",
        "en": "Active VTE; arterial or cardiovascular disease; diabetes with vascular involvement; liver disease or tumour; sex-hormone-dependent malignancy; undiagnosed vaginal bleeding; hypersensitivity."
      },
