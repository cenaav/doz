  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "خونریزی تناسلی تشخیص‌داده‌نشده؛ سرطان پستان یا وابسته به استروژن؛ DVT/PE یا ترومبوز شریانی؛ بیماری کبد؛ بارداری.",
        "en": "Undiagnosed genital bleeding; breast or oestrogen-dependent cancer; DVT/PE or arterial thrombosis; liver disease; pregnancy."
      },
      "refs": [
        {
          "source": "fda-premarin",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: سرطان آندومتر (بدون پروژستین در رحم سالم)، حوادث قلبی‌عروقی، سرطان پستان و دمانس احتمالی؛ کمترین دوز و کوتاه‌ترین مدت.",
        "en": "Boxed warning: endometrial cancer (unopposed oestrogen with a uterus), cardiovascular disorders, breast cancer and probable dementia; lowest dose, shortest time."
      },
      "refs": [
        {
          "source": "fda-premarin",
          "section": "Boxed Warning"
        }
      ]
    }
