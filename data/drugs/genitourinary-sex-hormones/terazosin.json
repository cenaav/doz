  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Teratogenic Effects Pregnancy Category C Terazosin capsules were not teratogenic in either rats or rabbits when administered at oral doses up to 280 and 60 times, respectively, the maximum recommended human dose.",
      "refs": [
        {
          "source": "fda-terazosin",
          "section": "Pregnancy"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Because many drugs are excreted in breast milk, caution should be exercised when terazosin capsules are administered to a nursing woman.",
      "refs": [
        {
          "source": "fda-terazosin",
          "section": "Nursing Mothers"
        }
      ]
