  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "حساسیت (حاوی روغن بادام‌زمینی)؛ خونریزی نامشخص تناسلی؛ سرطان پستان؛ DVT/PE یا ترومبوز شریانی فعال یا سابقه آن؛ بیماری کبد.",
        "en": "Hypersensitivity (contains peanut oil); undiagnosed genital bleeding; breast cancer; active or past DVT/PE or arterial thrombosis; liver disease."
      },
      "refs": [
        {
          "source": "fda-prometrium",
          "section": "Contraindications"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "اختلالات قلبی‌عروقی: در PE، DVT، سکته یا MI فوراً قطع؛ ۴ تا ۶ هفته پیش از جراحی پرخطر قطع شود.",
        "en": "Cardiovascular disorders: stop immediately if PE, DVT, stroke or MI; stop 4–6 weeks before high-risk surgery."
      },
      "refs": [
        {
          "source": "fda-prometrium",
          "section": "Warnings"
