  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There is no use for contraception in pregnancy; therefore, Depo-Provera CI should be discontinued during pregnancy.",
      "refs": [
        {
          "source": "fda-depoprovera",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Although medroxyprogesterone acetate is detectable in the milk of mothers receiving Depo-Provera CI, milk composition, quality, and amount do not appear to be adversely affected.",
      "refs": [
        {
          "source": "fda-depoprovera",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Depo-Provera CI is not indicated before menarche.",
      "refs": [
        {
          "source": "fda-depoprovera",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "This product has not been studied in post-menopausal women and is not indicated in this population.",
      "refs": [
        {
          "source": "fda-depoprovera",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
