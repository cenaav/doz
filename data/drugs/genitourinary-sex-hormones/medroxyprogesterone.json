  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "خونریزی تناسلی تشخیص‌داده‌نشده؛ سرطان پستان یا نئوپلازی وابسته به هورمون؛ DVT/PE یا ترومبوآمبولی شریانی (فعلی یا سابقه)؛ بیماری کبد؛ بارداری؛ آنافیلاکسی به دارو.",
        "en": "Undiagnosed genital bleeding; breast cancer or hormone-dependent neoplasia; current or past DVT/PE or arterial thromboembolism; liver disease; pregnancy; anaphylaxis to the drug."
      },
      "refs": [
        {
          "source": "fda-medroxyprogesterone",
          "section": "Contraindications"
        }
      ]
    },
    {
      "id": "boxed",
      "severity": "warn",
      "text": {
        "fa": "هشدار جعبه‌ای: با استروژن خطر DVT، PE، سکته، MI، سرطان پستان و دمانس در زنان یائسه.",
        "en": "Boxed warning: with oestrogen, increased risk of DVT, PE, stroke, MI, breast cancer and dementia in postmenopausal women."
      },
      "refs": [
        {
          "source": "fda-medroxyprogesterone",
          "section": "Boxed Warning"
        }
      ]
    }
