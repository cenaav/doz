  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Reproduction studies using oxybutynin chloride in the hamster, rabbit, rat, and mouse have shown no definite evidence of impaired fertility or harm to the animal fetus.",
      "refs": [
        {
          "source": "fda-oxybutynin",
          "section": "Pregnancy"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Because many drugs are excreted in human milk, caution should be exercised when oxybutynin chloride is administered to a nursing woman.",
      "refs": [
        {
          "source": "fda-oxybutynin",
          "section": "Nursing Mothers"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "The safety and efficacy of oxybutynin chloride administration have been demonstrated for pediatric patients 5 years of age and older (see DOSAGE AND ADMINISTRATION ).",
      "refs": [
        {
          "source": "fda-oxybutynin",
          "section": "Pediatric Use"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "… e elimination half-life from 2 to 3 hours to 5 hours. 2,3,4 In general, dose selection for an elderly patient should be cautious, usually starting at the low end of the dosing range, reflecting the greater frequency of decreased hepatic, renal, or cardiac function, and of concomitant disease or other drug therapy.",
      "refs": [
        {
          "source": "fda-oxybutynin",
          "section": "Geriatric Use"
        }
      ]
    }
  }
