  "contraindications": [
    {
      "id": "ci",
      "severity": "block",
      "text": {
        "fa": "بارداری؛ حساسیت شدید به لنالیدومید (آنژیوادم، SJS، TEN).",
        "en": "Pregnancy; severe hypersensitivity to lenalidomide (angioedema, SJS, TEN)."
      },
      "refs": [
        {
          "source": "fda-revlimid",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: سمیت جنینی (دو تست بارداری منفی و دو روش پیشگیری)، سمیت خونی (نوتروپنی، ترومبوسیتوپنی)، ترومبوآمبولی وریدی و شریانی.",
        "en": "Boxed warning: embryo-fetal toxicity (two negative pregnancy tests and two contraceptive methods), haematologic toxicity (neutropenia, thrombocytopenia), venous and arterial thromboembolism."
      },
      "refs": [
        {
          "source": "fda-revlimid",
          "section": "Boxed Warning"
        }
      ]
    }
  ],
