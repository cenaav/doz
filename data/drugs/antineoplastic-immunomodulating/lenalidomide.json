  "populations": {
    "pregnancy": {
      "level": "contraindicated",
      "text": {
        "fa": "برچسب: در بارداری منع مصرف دارد.",
        "en": "Label: contraindicated in pregnancy."
      },
      "quote": "Due to the results of this developmental monkey study, and lenalidomide's structural similarities to thalidomide, a known human teratogen, lenalidomide is contraindicated in females who are pregnant [see Boxed Warning ].",
      "refs": [
        {
          "source": "fda-revlimid",
          "section": "4"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because many drugs are excreted in human milk and because of the potential for adverse reactions in breastfed children from REVLIMID, advise women not to breastfeed during treatment with REVLIMID.",
      "refs": [
        {
          "source": "fda-revlimid",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Safety and effectiveness have not been established in pediatric patients.",
      "refs": [
        {
          "source": "fda-revlimid",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Since elderly patients are more likely to have decreased renal function, care should be taken in dose selection.",
      "refs": [
        {
          "source": "fda-revlimid",
          "section": "8.5"
        }
      ]
    },
