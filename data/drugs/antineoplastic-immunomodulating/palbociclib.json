  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Based on findings from animal studies and its mechanism of action, IBRANCE can cause fetal harm when administered to a pregnant woman [see Clinical Pharmacology (12.1) ] .",
      "refs": [
        {
          "source": "fda-ibrance",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in breastfed infants from IBRANCE, advise a lactating woman not to breastfeed during treatment with IBRANCE and for 3 weeks after the last dose.",
      "refs": [
        {
          "source": "fda-ibrance",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان ثابت نشده است.",
        "en": "Label: safety and effectiveness in children have not been established."
      },
      "quote": "The safety and effectiveness of IBRANCE in pediatric patients have not been established.",
      "refs": [
        {
          "source": "fda-ibrance",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Of 444 patients who received IBRANCE in PALOMA-2, 181 patients (41%) were ≥65 years of age and 48 patients (11%) were ≥75 years of age.",
      "refs": [
        {
          "source": "fda-ibrance",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
