  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Based on findings from animal studies and its mechanism of action [see Clinical Pharmacology (12.1) ] , TEMODAR can cause fetal harm when administered to a pregnant woman.",
      "refs": [
        {
          "source": "fda-temodar",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions, including myelosuppression from temozolomide in the breastfed children, advise women not to breastfeed during treatment with TEMODAR and for 1 week after the last dose.",
      "refs": [
        {
          "source": "fda-temodar",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Safety and effectiveness of TEMODAR have not been established in pediatric patients.",
      "refs": [
        {
          "source": "fda-temodar",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "… ade 4 thrombocytopenia (20%) in the first cycle of therapy than patients less than 70 years of age [see Warnings and Precautions (5.1) , Adverse Reactions (6.1) ] .",
      "refs": [
        {
          "source": "fda-temodar",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Females Advise females of reproductive potential to use effective contraception during treatment with TEMODAR and for 6 months after the last dose.",
      "refs": [
        {
          "source": "fda-temodar",
          "section": "8.3"
        }
      ]
    }
