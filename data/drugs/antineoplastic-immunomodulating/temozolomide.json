  "regimens": [
    {
      "id": "gbm-rt",
      "disease": "malignant-glioma",
      "label": {
        "fa": "گلیوبلاستوم تازه — همزمان با رادیوتراپی ۷۵ mg/m² روزانه ۴۲ تا ۴۹ روز",
        "en": "Newly diagnosed glioblastoma — with radiotherapy 75 mg/m² daily for 42–49 days"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "bsa",
      "unit": "mg",
      "dose": {
        "perM2PerDay": 75,
        "dividedDoses": 1
      },
      "refs": [
        {
          "source": "fda-temodar",
          "section": "2.2"
        }
      ],
      "durationDays": {
        "min": 42,
        "max": 49
      },
      "notes": [
        {
          "text": {
            "fa": "فقط زیر نظر پزشک متخصص شیمی‌درمانی و در مرکز مجهز. عدد ماشین‌حساب = mg/m² برچسب × سطح بدن (Mosteller)؛ پروتکل، فاصله دوره‌ها، تنظیم بر اساس CBC و عملکرد کلیه/کبد با تیم انکولوژی.",
            "en": "Only under an oncologist in an equipped centre. Calculator = label mg/m² × BSA (Mosteller); protocol, cycle interval and adjustment for CBC and renal/hepatic function rest with the oncology team."
          },
          "refs": [
            {
              "source": "fda-temodar",
              "section": "2.2"
            }
          ]
        },
        {
          "text": {
            "fa": "پیشگیری پنوموسیستیس در فاز همزمان. شروع فقط با ANC ۱۵۰۰ و پلاکت ۱۰۰ هزار به بالا.",
            "en": "Pneumocystis prophylaxis during the concomitant phase. Start only with ANC ≥1.5 × 10⁹/L and platelets ≥100 × 10⁹/L."
          },
          "refs": [
            {
              "source": "fda-temodar",
              "section": "2.2"
            },
            {
              "source": "fda-temodar",
              "section": "2.1"
            }
          ]
        }
      ]
    },
    {
      "id": "gbm-maint",
      "disease": "malignant-glioma",
      "label": {
        "fa": "گلیوبلاستوم — نگهدارنده ۱۵۰ mg/m² روز ۱ تا ۵ هر ۲۸ روز، ۶ دوره (از دوره ۲ تا ۲۰۰ mg/m²)",
        "en": "Glioblastoma — maintenance 150 mg/m² on days 1–5 every 28 days for 6 cycles (from cycle 2 up to 200 mg/m²)"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
