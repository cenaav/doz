  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data from the pharmacovigilance safety database and postmarketing case reports on use of RINVOQ in pregnant women are not sufficient to evaluate a drug-associated risk for major birth defects or miscarriage.",
      "refs": [
        {
          "source": "fda-rinvoq",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in the breastfed infant, advise patients that breastfeeding is not recommended during treatment with RINVOQ/RINVOQ LQ, and for 6 days (approximately 10 half-lives) after the last dose.",
      "refs": [
        {
          "source": "fda-rinvoq",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Polyarticular Juvenile Idiopathic Arthritis and Psoriatic Arthritis The safety and effectiveness of RINVOQ/RINVOQ LQ in pediatric patients 2 to less than 18 years of age with pJIA and psoriatic arthritis have been established.",
      "refs": [
        {
          "source": "fda-rinvoq",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Rheumatoid Arthritis and Psoriatic Arthritis Of the 4381 patients treated in the five clinical trials, a total of 906 rheumatoid arthritis patients were 65 years of age or older, including 146 patients 75 years and older.",
      "refs": [
        {
          "source": "fda-rinvoq",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Females Based on animal studies, upadacitinib may cause embryo-fetal harm when administered to pregnant women [see Use in Specific Populations ( 8.1 )] .",
      "refs": [
        {
          "source": "fda-rinvoq",
          "section": "8.3"
        }
      ]
    }
  }
