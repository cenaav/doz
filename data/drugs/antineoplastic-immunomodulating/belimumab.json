  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data on use of BENLYSTA in pregnant women, from observational studies, published case reports, and postmarketing surveillance, are insufficient to determine whether there is a drug-associated risk for major birth defects or miscarriage.",
      "refs": [
        {
          "source": "fda-benlysta",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary No information is available on the presence of belimumab in human milk, the effects of the drug on the breastfed infant, or the effects of the drug on milk production.",
      "refs": [
        {
          "source": "fda-benlysta",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of BENLYSTA have been established for the treatment of active SLE and active lupus nephritis in pediatric patients 5 years of age and older who are receiving standard therapy.",
      "refs": [
        {
          "source": "fda-benlysta",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Use with caution in geriatric patients.",
      "refs": [
        {
          "source": "fda-benlysta",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Following an assessment of benefit versus risk, if prevention of pregnancy is warranted, females of reproductive potential should use effective contraception during treatment and for at least 4 months after the final treatment.",
      "refs": [
        {
          "source": "fda-benlysta",
