  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Based on findings in animal studies and mechanism of action, LUPRON DEPOT may cause fetal harm when administered to a pregnant woman [see Clinical Pharmacology ( 12.1 )] .",
      "refs": [
        {
          "source": "fda-lupron-depot",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "The safety and efficacy of LUPRON DEPOT have not been established in females.",
      "refs": [
        {
          "source": "fda-lupron-depot",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "See LUPRON DEPOT-PED ® (leuprolide acetate for depot suspension) labeling for the safety and effectiveness in children with central precocious puberty.",
      "refs": [
        {
          "source": "fda-lupron-depot",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In the clinical trials for LUPRON DEPOT in prostate cancer 80% of the subjects studied were at least 65 years of age.",
      "refs": [
        {
          "source": "fda-lupron-depot",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Infertility Males Based on findings in animals and mechanism of action, LUPRON DEPOT may impair fertility in males of reproductive potential [see Nonclinical Toxicology ( 13.1 )] .",
      "refs": [
        {
          "source": "fda-lupron-depot",
