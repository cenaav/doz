  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Based on animal reproduction studies and its mechanism of action, SUTENT can cause fetal harm when administered to a pregnant woman [see Clinical Pharmacology (12.1) ] .",
      "refs": [
        {
          "source": "fda-sutent",
          "section": "8.1"
        }
      ]
    },
