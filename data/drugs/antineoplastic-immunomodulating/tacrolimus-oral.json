  "contraindications": [
    {
      "id": "hyper",
      "severity": "block",
      "text": {
        "fa": "حساسیت به تاکرولیموس؛ تزریقی: حساسیت به روغن کرچک هیدروژنه (HCO-60).",
        "en": "Hypersensitivity to tacrolimus; injection: hypersensitivity to HCO-60 (polyoxyl 60 hydrogenated castor oil)."
      },
      "refs": [
        {
          "source": "fda-prograf",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: بدخیمی و عفونت جدی. سمیت کلیه و عصب، دیابت پس از پیوند، طولانی شدن QT؛ تداخل‌های زیاد با مهار/القاگر CYP3A.",
        "en": "Boxed warning: malignancy and serious infections. Nephrotoxicity, neurotoxicity, post-transplant diabetes, QT prolongation; many CYP3A interactions."
      },
      "refs": [
