  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary SIKLOS can cause fetal harm based on findings from animal studies and the drug's mechanism of action [see Clinical Pharmacology (12.1) ] .",
      "refs": [
        {
          "source": "fda-siklos",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in a breastfed child from SIKLOS, including carcinogenicity, advise patients not to breastfeed during treatment with SIKLOS.",
      "refs": [
        {
          "source": "fda-siklos",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of SIKLOS have been established in pediatric patients aged 2-18 years with sickle cell anemia with recurrent moderate to severe painful crises.",
      "refs": [
        {
          "source": "fda-siklos",
          "section": "8.4"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Females Advise females of reproductive potential to use effective contraception during and after treatment with SIKLOS for at least 6 months after therapy.",
      "refs": [
