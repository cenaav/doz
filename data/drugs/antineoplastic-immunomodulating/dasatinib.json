  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary Based on limited human data, SPRYCEL can cause fetal harm when administered to a pregnant woman.",
      "refs": [
        {
          "source": "fda-sprycel",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in nursing children from SPRYCEL, breastfeeding is not recommended during treatment with SPRYCEL and for 2 weeks after the last dose.",
      "refs": [
        {
          "source": "fda-sprycel",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Ph+ CML in Chronic Phase The safety and effectiveness of SPRYCEL monotherapy have been demonstrated in pediatric patients with newly diagnosed chronic phase CML [see Clinical Studies (14.3) ] .",
      "refs": [
        {
          "source": "fda-sprycel",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "… ness, pericardial effusion, congestive heart failure, hypertension, pulmonary edema, and weight decrease, and should be monitored closely.",
      "refs": [
        {
          "source": "fda-sprycel",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Advise females of reproductive potential and males with female partners of reproductive potential to use effective contraception during treatment with SPRYCEL and for 30 days after the last dose.",
      "refs": [
        {
          "source": "fda-sprycel",
          "section": "8.3"
