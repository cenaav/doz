  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data from the published literature and the pharmacovigilance database with TALTZ use in pregnant women are insufficient to evaluate for a drug-associated risk of major birth defects, miscarriage or other adverse maternal or fetal outcomes.",
      "refs": [
        {
          "source": "fda-taltz",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no available data on the presence of ixekizumab in human milk, the effects on the breastfed infant, or the effects on milk production.",
      "refs": [
        {
          "source": "fda-taltz",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of TALTZ have been established in pediatric subjects aged 6 years to less than 18 years with moderate-to-severe plaque psoriasis.",
      "refs": [
        {
          "source": "fda-taltz",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Of the 4204 adult psoriasis subjects exposed to TALTZ, a total of 301 were 65 years or older, and 36 subjects were 75 years or older.",
      "refs": [
        {
          "source": "fda-taltz",
          "section": "8.5"
        }
      ]
    }
