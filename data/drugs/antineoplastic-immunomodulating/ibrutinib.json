  "populations": {
    "pregnancy": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: می‌تواند به جنین آسیب بزند. در بارداری خطرناک است.",
        "en": "Label: can cause fetal harm. Dangerous in pregnancy."
      },
      "quote": "Risk Summary IMBRUVICA can cause fetal harm based on findings from animal studies.",
      "refs": [
        {
          "source": "fda-imbruvica",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions in the breastfed child, advise women not to breastfeed during treatment with IMBRUVICA and for 1 week after the last dose.",
      "refs": [
        {
          "source": "fda-imbruvica",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "Chronic GVHD The safety and effectiveness of IMBRUVICA have been established for treatment of cGVHD after failure of one or more lines of systemic therapy in pediatric patients 1 year of age and older.",
      "refs": [
        {
          "source": "fda-imbruvica",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "ok",
      "text": {
        "fa": "برچسب: در سالمندان تفاوت یا تنظیم دوز خاصی ذکر نشده.",
        "en": "Label: no specific difference or dose adjustment stated for older adults."
      },
      "quote": "No overall differences in effectiveness were observed between younger and older patients.",
      "refs": [
        {
          "source": "fda-imbruvica",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Females Advise females of reproductive potential to use effective contraception during treatment with IMBRUVICA and for 1 month after the last dose.",
      "refs": [
        {
          "source": "fda-imbruvica",
          "section": "8.3"
        }
      ]
    }
