  "regimens": [
    {
      "id": "cll",
      "disease": "chronic-lymphocytic-leukemia",
      "label": {
        "fa": "CLL/SLL و ماکروگلوبولینمی والدنشتروم — ۴۲۰ mg یک بار در روز",
        "en": "CLL/SLL and Waldenström macroglobulinaemia — 420 mg once daily"
      },
      "population": {
        "minAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "type": "fixed",
      "unit": "mg",
      "dose": {
        "perDose": 420,
        "dosesPerDay": 1
      },
      "refs": [
        {
          "source": "fda-imbruvica",
          "section": "2.1"
        }
      ],
      "notes": [
        {
          "text": {
            "fa": "فقط زیر نظر متخصص انکولوژی؛ ادامه تا پیشرفت بیماری یا سمیت غیرقابل‌قبول. تنظیم دوز برای عوارض و تداخل‌ها طبق برچسب.",
            "en": "Only under an oncologist; continue until progression or unacceptable toxicity. Dose adjustments for toxicity and interactions per label."
          },
          "refs": [
            {
              "source": "fda-imbruvica",
              "section": "2.1"
            }
          ]
        },
        {
          "text": {
            "fa": "GVHD مزمن: ۱۲ سال به بالا ۴۲۰ mg؛ ۱ تا <۱۲ سال ۲۴۰ mg/m² (حداکثر ۴۲۰). قرص یا کپسول کامل با آب بلعیده شود.",
            "en": "Chronic GVHD: ≥12 years 420 mg; 1–<12 years 240 mg/m² (max 420). Swallow tablets or capsules whole with water."
          },
          "refs": [
            {
              "source": "fda-imbruvica",
              "section": "2.1"
            }
          ]
        }
      ]
    }
  ],
  "contraindications": [],
  "warnings": [
    {
      "text": {
        "fa": "خونریزی؛ عفونت؛ آریتمی، نارسایی قلب و مرگ ناگهانی؛ فشار خون؛ سیتوپنی؛ بدخیمی دوم؛ سمیت کبدی؛ سمیت جنینی.",
        "en": "Haemorrhage; infections; arrhythmias, cardiac failure and sudden death; hypertension; cytopenias; second primary malignancies; hepatotoxicity; embryo-fetal toxicity."
      },
      "refs": [
