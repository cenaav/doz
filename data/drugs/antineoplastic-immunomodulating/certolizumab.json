  "contraindications": [
    {
      "id": "hyper",
      "severity": "block",
      "text": {
        "fa": "حساسیت جدی به سرتولیزوماب (آنژیوادم، آنافیلاکسی، بیماری سرم).",
        "en": "Serious hypersensitivity to certolizumab (angioedema, anaphylaxis, serum sickness)."
      },
      "refs": [
        {
          "source": "fda-cimzia",
          "section": "4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: عفونت‌های جدی (سل، قارچی تهاجمی، فرصت‌طلب) و بدخیمی (لنفوم، به‌ویژه در کودکان) — پیش از شروع تست سل نهفته و HBV.",
        "en": "Boxed warning: serious infections (TB, invasive fungal, opportunistic) and malignancy (lymphoma, especially in children) — test for latent TB and HBV first."
      },
      "refs": [
        {
          "source": "fda-cimzia",
          "section": "Boxed Warning"
        }
      ]
    },
    {
      "text": {
        "fa": "نارسایی قلب؛ فعال شدن HBV؛ بیماری دمیلینه‌کننده؛ سیتوپنی؛ سندرم شبه‌لوپوس؛ همراه داروهای بیولوژیک دیگر نه.",
        "en": "Heart failure; HBV reactivation; demyelinating disease; cytopenias; lupus-like syndrome; not with other biologics."
      },
      "refs": [
        {
          "source": "fda-cimzia",
          "section": "5"
        }
      ]
    }
  ],
