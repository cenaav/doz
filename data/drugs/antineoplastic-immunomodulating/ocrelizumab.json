  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary OCREVUS is a humanized monoclonal antibody of an immunoglobulin G1 subtype and immunoglobulins are known to cross the placental barrier.",
      "refs": [
        {
          "source": "fda-ocrevus",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of ocrelizumab in human milk, the effects on the breastfed infant, or the effects of the drug on milk production.",
      "refs": [
        {
          "source": "fda-ocrevus",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and effectiveness of OCREVUS for the treatment of relapsing-remitting MS have been established in pediatric patients 10 years of age and older who weigh 25 kg or more.",
      "refs": [
        {
          "source": "fda-ocrevus",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Clinical studies of OCREVUS did not include sufficient numbers of subjects aged 65 and over to determine whether they respond differently from younger subjects.",
      "refs": [
        {
          "source": "fda-ocrevus",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Females of reproductive potential should use effective contraception while receiving OCREVUS and for 6 months after the last infusion of OCREVUS [see Clinical Pharmacology (12.3) ] .",
      "refs": [
        {
          "source": "fda-ocrevus",
          "section": "8.3"
        }
      ]
    }
  }
