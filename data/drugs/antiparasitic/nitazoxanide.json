  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are no data with ALINIA in pregnant women to inform a drug-associated risk.",
      "refs": [
        {
          "source": "fda-alinia",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary No information regarding the presence of nitazoxanide in human milk, the effects on the breastfed infant, or the effects on milk production is available.",
      "refs": [
        {
          "source": "fda-alinia",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The safety and efficacy of ALINIA for Oral Suspension for the treatment of diarrhea caused by G. lamblia or C. parvum in pediatric patients 1 to 11 years of age has been established based on three (3) randomized, controlled studies with 104 pediatric subjects treated with ALINIA for Oral Suspension 100 mg/5 mL.",
      "refs": [
        {
          "source": "fda-alinia",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Clinical studies of ALINIA Tablets and ALINIA for Oral Suspension did not include sufficient numbers of subjects aged 65 and over to determine whether they respond differently from younger subjects.",
      "refs": [
        {
          "source": "fda-alinia",
          "section": "8.5"
        }
      ]
    }
  },
