  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary There are limited data on use of ALBENZA in pregnant women to inform a drug-associated risk of major birth defects and miscarriage.",
      "refs": [
        {
          "source": "fda-albenza",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of albendazole in human milk, the effects on the breast-fed infant or the effects on milk production.",
      "refs": [
        {
          "source": "fda-albenza",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "Hydatid disease is uncommon in infants and young children.",
      "refs": [
        {
          "source": "fda-albenza",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In patients aged 65 and older with either hydatid disease or neurocysticercosis, there was insufficient data to determine whether the safety and effectiveness of ALBENZA is different from that of younger patients.",
      "refs": [
        {
          "source": "fda-albenza",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Contraception Females Advise women of reproductive potential to use effective birth control for the duration of ALBENZA therapy and for one month after end of therapy.",
      "refs": [
        {
          "source": "fda-albenza",
          "section": "8.3"
        }
      ]
    }
  }
