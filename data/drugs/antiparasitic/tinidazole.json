  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available published data from a case-control study and case report with Tinidazole Tablets use in pregnant women are insufficient to identify a risk of major birth defects, miscarriage or adverse maternal or fetal outcomes.",
      "refs": [
        {
          "source": "fda-tinidazole",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "avoid",
      "text": {
        "fa": "برچسب: شیردهی توصیه نمی‌شود یا باید بین دارو و شیردهی یکی انتخاب شود.",
        "en": "Label: breastfeeding not recommended, or choose between the drug and breastfeeding."
      },
      "quote": "Because of the potential for serious adverse reactions, including tumorigenicity, advise patients that breastfeeding is not recommended during treatment with Tinidazole and for 72 hours (based on half-life) after administration of Tinidazole.",
      "refs": [
        {
          "source": "fda-tinidazole",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "not-established",
      "text": {
        "fa": "برچسب: ایمنی و اثربخشی در کودکان ثابت نشده است.",
        "en": "Label: safety and effectiveness in children have not been established."
      },
      "quote": "Other than for use in the treatment of giardiasis and amebiasis in pediatric patients older than three years of age, safety and effectiveness of tinidazole in pediatric patients have not been established.",
      "refs": [
        {
          "source": "fda-tinidazole",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In general, dose selection for an elderly patient should be cautious, reflecting the greater frequency of decreased hepatic, renal, or cardiac function, and of concomitant disease or other drug therapy.",
      "refs": [
        {
          "source": "fda-tinidazole",
          "section": "8.5"
        }
      ]
    },
    "reproductive": {
      "level": "caution",
      "text": {
        "fa": "برچسب نکته‌ای درباره بارداری، پیشگیری یا باروری زنان و مردان دارد.",
        "en": "Label has advice on pregnancy testing, contraception or fertility for females and males."
      },
      "quote": "Infertility Males Based on findings in rodents, Tinidazole may impair fertility in males of reproductive potential.",
      "refs": [
        {
          "source": "fda-tinidazole",
          "section": "8.3"
        }
      ]
    }
  },
