  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary Available data from published literature and postmarketing experience with use of MALARONE in pregnant women are insufficient to identify a drug-associated risk for major birth defects, miscarriage, or adverse maternal or fetal outcomes .",
      "refs": [
        {
          "source": "fda-malarone",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary There are no data on the presence of atovaquone in human milk; however, proguanil is present in human milk.",
      "refs": [
        {
          "source": "fda-malarone",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب برای کودکان شرط، محدودیت سنی یا نکته دارد؛ جمله برچسب در زیر آمده است.",
        "en": "The label has conditions, age limits or notes for children; the label sentence is quoted below."
      },
      "quote": "The efficacy and safety of MALARONE have been established for the prophylaxis of malaria in controlled trials involving pediatric patients weighing 11 kg or more [see Clinical Studies ( 14.1 )] .",
      "refs": [
        {
          "source": "fda-malarone",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "In general, dose selection for an elderly patient should be cautious, reflecting the greater frequency of decreased hepatic, renal, or cardiac function, the higher systemic exposure to cycloguanil, and the greater frequency of concomitant disease or other drug therapy.",
      "refs": [
        {
          "source": "fda-malarone",
