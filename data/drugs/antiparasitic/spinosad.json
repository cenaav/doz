  "populations": {
    "pregnancy": {
      "level": "ok",
      "text": {
        "fa": "برچسب: جذب سیستمیک ناچیز؛ مواجهه جنین انتظار نمی‌رود.",
        "en": "Label: minimal systemic absorption; fetal exposure not expected."
      },
      "quote": "Risk Summary Spinosad, the active ingredient in NATROBA, is not absorbed systemically following topical application, and maternal use is not expected to result in fetal exposure to the drug.",
      "refs": [
        {
          "source": "fda-natroba",
