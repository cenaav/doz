  "populations": {
    "pregnancy": {
      "level": "caution",
      "text": {
        "fa": "برچسب خطر مشخصی برای بارداری ذکر نکرده یا داده کافی ندارد؛ فقط در صورت لزوم و با نظر پزشک.",
        "en": "Label states no clear risk or has limited data; use only if needed, under medical advice."
      },
      "quote": "Risk Summary The available published literature on mebendazole use in pregnant women has not reported a clear association between mebendazole and a potential risk of major birth defects or miscarriages [see Data].",
      "refs": [
        {
          "source": "fda-emverm",
          "section": "8.1"
        }
      ]
    },
    "lactation": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در شیردهی با احتیاط؛ متن برچسب را ببینید.",
        "en": "Label: use with caution while breastfeeding; see the label text."
      },
      "quote": "Risk Summary Limited data from case reports demonstrate that a small amount of mebendazole is present in human milk following oral administration.",
      "refs": [
        {
          "source": "fda-emverm",
          "section": "8.2"
        }
      ]
    },
    "pediatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب ایمنی را فقط برای بعضی سنین کودکان تأیید کرده؛ سن را در متن برچسب ببینید.",
        "en": "Label supports use only in some paediatric ages; check the age in the label text."
      },
      "quote": "The safety and effectiveness of EMVERM ® 100 mg chewable tablets has not been established in pediatric patients less than two years of age.",
      "refs": [
        {
          "source": "fda-emverm",
          "section": "8.4"
        }
      ]
    },
    "geriatric": {
      "level": "caution",
      "text": {
        "fa": "برچسب: در سالمندان با احتیاط و معمولاً از دوز پایین شروع شود.",
        "en": "Label: use with caution in older adults, usually starting at the low end of the dose range."
      },
      "quote": "Clinical studies of mebendazole did not include sufficient numbers of subjects aged 65 and older to determine whether they respond differently from younger subjects.",
      "refs": [
        {
          "source": "fda-emverm",
          "section": "8.5"
        }
      ]
    }
  }
