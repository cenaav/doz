  "contraindications": [
    {
      "id": "maoi",
      "severity": "block",
      "text": {
        "fa": "مصرف MAOI (شامل لینزولید یا متیلن بلو وریدی) یا تا ۱۴ روز پس از قطع آن.",
        "en": "Taking an MAOI (incl. linezolid or IV methylene blue) or within 14 days of stopping."
      },
      "refs": [
        {
          "source": "fda-sertraline",
          "section": "4"
        }
      ]
    },
    {
      "id": "pimozide",
      "severity": "block",
      "text": {
        "fa": "مصرف همزمان پیموزاید؛ حساسیت به سرترالین.",
        "en": "Concomitant pimozide; hypersensitivity to sertraline."
      },
      "refs": [
        {
          "source": "fda-sertraline",
          "section": "4"
        }
      ]
    },
    {
      "id": "peds-other",
      "severity": "warn",
      "rule": {
        "maxAge": {
          "value": 18,
          "unit": "year"
        }
      },
      "text": {
        "fa": "در کودکان فقط برای وسواس (۶ تا ۱۷ سال) تأیید شده است.",
        "en": "In children only OCD (6–17 years) is established."
      },
      "refs": [
        {
          "source": "fda-sertraline",
          "section": "8.4"
        }
      ]
    }
  ],
  "warnings": [
    {
      "text": {
        "fa": "هشدار جعبه‌ای: افزایش خطر افکار و رفتار خودکشی در کودکان و جوانان؛ پایش دقیق.",
        "en": "Boxed warning: increased risk of suicidal thoughts and behaviors in pediatric and young adult patients; monitor closely."
      },
      "refs": [
        {
          "source": "fda-sertraline",
          "section": "WARNING: SUICIDAL THOUGHTS AND BEHAVIORS"
        }
